# All LM-G820N SSC sensors are hosted by the SLPI QRTR service on Node 9.
SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp*", ENV{IIO_SENSOR_PROXY_TYPE}=""
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{IIO_SENSOR_PROXY_TYPE}="ssc-accel ssc-proximity ssc-light ssc-compass"
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="hexagonrpcd.service"

# Align the factory SSC axes with the panel's portrait reference.
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{ACCEL_MOUNT_MATRIX}="-1,0,0;0,-1,0;0,0,1"
