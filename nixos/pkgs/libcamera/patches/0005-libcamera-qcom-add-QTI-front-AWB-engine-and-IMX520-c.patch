+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "awb_calibration.h"
+#include "awb_eeprom.h"
+
+namespace libcamera::qcom {
+
+inline std::optional<std::vector<QtiAwbIlluminantCalibration>>
+imx520AwbCalibration(const std::array<uint8_t, 16> &block)
+{
+	std::array<std::array<float, 3>, 2> ratios;
+	for (unsigned int i = 0; i < ratios.size(); i++) {
+		std::array<uint8_t, 8> data;
+		std::copy_n(block.begin() + i * 8, data.size(), data.begin());
+		auto decoded = awbEepromRatios(data);
+		if (!decoded)
+			return std::nullopt;
+		ratios[i] = *decoded;
+	}
+	constexpr std::array<unsigned int, 5> ccts{ 6500, 3800, 2850, 5000, 2300 };
+	constexpr std::array<unsigned int, 5> groups{ 0, 0, 1, 0, 1 };
+	std::vector<QtiAwbIlluminantCalibration> result;
+	for (unsigned int i = 0; i < ccts.size(); i++) {
+		const auto &measured = ratios[groups[i]];
+		result.push_back({ 1, ccts[i], { measured[0], measured[1] } });
+	}
+	return result;
+}
+
+} /* namespace libcamera::qcom */
