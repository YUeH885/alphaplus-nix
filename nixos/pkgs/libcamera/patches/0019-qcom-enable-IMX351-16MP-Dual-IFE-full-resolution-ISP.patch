From b939fbef1364e438388747b41852414f0505432b Mon Sep 17 00:00:00 2001
From: yuzu <yuzu23234@gmail.com>
Date: Sun, 22 Nov 2026 12:36:12 +0800
Subject: [PATCH] qcom: enable IMX351 16MP Dual-IFE full-resolution ISP output

---
 src/libcamera/pipeline/qcom/qcom.cpp | 30 +++++++++++++++++++++++++---
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/libcamera/pipeline/qcom/qcom.cpp b/src/libcamera/pipeline/qcom/qcom.cpp
index 2f3363f..6709c2d 100644
--- a/src/libcamera/pipeline/qcom/qcom.cpp
+++ b/src/libcamera/pipeline/qcom/qcom.cpp
@@ -376,6 +376,7 @@ constexpr Size kImx520OutputSizes[] = {
 	{ 640, 360 },
 };
 constexpr Size kImx351OutputSizes[] = {
+	{ 4656, 3492 }, { 4032, 3024 },
 	{ 2320, 1312 }, { 2016, 1136 }, { 1920, 1080 },
 	{ 1440, 1080 }, { 1280, 960 }, { 1280, 720 },
 	{ 1008, 568 }, { 640, 480 }, { 640, 360 },
@@ -560,7 +561,7 @@ constexpr SensorProfile kImx351Profile = {
 	.mediaBusCode = MEDIA_BUS_FMT_SBGGR10_1X10,
 	.fullInputSize = { 4656, 3492 },
 	.nativeInputSize = { 2328, 1312 },
-	.fullResolutionOutput = false,
+	.fullResolutionOutput = true,
 	.outputSizes = kImx351OutputSizes,
 	.outputSizeCount = std::size(kImx351OutputSizes),
 	.defaultOutputSize = kNativeSize,
@@ -4741,6 +4742,15 @@ int QcomPipelineHandler::allocateSlot(Camera *camera) const
 	if (hasCsiphyConflict(camera))
 		return -EBUSY;
 
+	for (const VfeSlot &slot : vfeSlots_) {
+		if (!slot.activeCamera || slot.activeCamera == camera)
+			continue;
+		const QcomCameraData *other =
+			static_cast<const QcomCameraData *>(slot.activeCamera->_d());
+		if (other->pixConfigured_ && other->configuredSensorSize_.width > 4096)
+			return -EBUSY;
+	}
+
 	const QcomCameraData *data = static_cast<const QcomCameraData *>(camera->_d());
 	for (std::size_t i = 0; i < vfeSlots_.size(); ++i) {
 		if (vfeSlots_[i].activeCamera == camera)
@@ -4794,6 +4804,14 @@ bool QcomPipelineHandler::anyActiveFc4Camera() const
 
 int QcomPipelineHandler::configure(Camera *camera, CameraConfiguration *config)
 {
+	QcomCameraConfiguration *qcomConfig = static_cast<QcomCameraConfiguration *>(config);
+	if (qcomConfig->pixIndex_.has_value() && qcomConfig->sensorSize_.width > 4096) {
+		for (const VfeSlot &entry : vfeSlots_) {
+			if (entry.activeCamera && entry.activeCamera != camera)
+				return -EBUSY;
+		}
+	}
+
 	int slot = allocateSlot(camera);
 	if (slot < 0)
 		return slot;
@@ -4803,7 +4821,6 @@ int QcomPipelineHandler::configure(Camera *camera, CameraConfiguration *config)
 		return ret;
 
 	QcomCameraData *data = cameraData(camera);
-	QcomCameraConfiguration *qcomConfig = static_cast<QcomCameraConfiguration *>(config);
 	ret = data->openCaptureDevices();
 	if (ret < 0)
 		return ret;
@@ -4887,6 +4904,14 @@ int QcomPipelineHandler::exportFrameBuffers(Camera *camera, Stream *stream,
 
 int QcomPipelineHandler::start(Camera *camera, const ControlList *controls)
 {
+	QcomCameraData *data = cameraData(camera);
+	if (data->pixConfigured_ && data->configuredSensorSize_.width > 4096) {
+		for (const VfeSlot &entry : vfeSlots_) {
+			if (entry.activeCamera && entry.activeCamera != camera)
+				return -EBUSY;
+		}
+	}
+
 	int slot = allocateSlot(camera);
 	if (slot < 0)
 		return slot;
@@ -4895,7 +4920,6 @@ int QcomPipelineHandler::start(Camera *camera, const ControlList *controls)
 	if (ret < 0)
 		return ret;
 
-	QcomCameraData *data = cameraData(camera);
 	ret = data->openCaptureDevices();
 	if (ret < 0)
 		return ret;
-- 
2.55.0

