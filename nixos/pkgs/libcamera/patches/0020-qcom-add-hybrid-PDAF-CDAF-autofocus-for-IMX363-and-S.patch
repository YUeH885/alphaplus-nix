+void QcomCameraData::syncPdaf()
+{
+	pdafActive_ = false;
+	if (!hasPdaf_ || !pix_ || !pix_->isOpen())
+		return;
+
+	const PdafModeSpec *mode = activePdafMode();
+	qcom_camss_pdaf_cfg cfg = {};
+	if (mode) {
+		cfg.enable = 1;
+		cfg.vc = mode->vc;
+		cfg.dt = mode->dt;
+		cfg.width = mode->width;
+		cfg.height = mode->height;
+		cfg.stride = mode->stride;
+	}
+
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+	control.id = V4L2_CID_QCOM_CAMSS_PDAF;
+	control.size = sizeof(cfg);
+	control.ptr = &cfg;
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.controls = &control;
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret) {
+		LOG(QcomPipeline, Warning) << "Failed to configure sideband PDAF: " << ret;
+		return;
+	}
+
+	pdafActive_ = (mode != nullptr);
+	if (pdafActive_) {
+		LOG(QcomPipeline, Info)
+			<< "Enabled sideband VC=" << static_cast<unsigned int>(mode->vc)
+			<< " DT=" << utils::hex(mode->dt) << " PDAF ("
+			<< mode->width << "x" << mode->height
+			<< ", stride " << mode->stride << ") for " << sensorModel_;
+	}
+}
+
+PdafResult QcomCameraData::measurePdaf()
+{
+	PdafResult result;
+	const PdafModeSpec *mode = activePdafMode();
+	if (!pdafActive_ || !mode || !pdafCalibration_ || !video_ || !video_->isOpen())
+		return result;
+
+	/* Map active AF window (or default center window) to normalized image ROI. */
+	double normX = 0.25, normY = 0.35, normW = 0.50, normH = 0.30;
+	if (afMetering_ == controls::AfMeteringWindows && !afWindows_.empty() &&
+	    statsInputSize_.width > 0 && statsInputSize_.height > 0) {
+		Rectangle win = afWindows_.front().boundedTo(analogCrop_);
+		if (win.width && win.height) {
+			win = win.transformedBetween(analogCrop_, Rectangle(statsInputSize_));
+			if (!!(transform_ & Transform::HFlip))
+				win.x = statsInputSize_.width - (win.x + win.width);
+			if (!!(transform_ & Transform::VFlip))
+				win.y = statsInputSize_.height - (win.y + win.height);
+			normX = static_cast<double>(win.x) / statsInputSize_.width;
+			normY = static_cast<double>(win.y) / statsInputSize_.height;
+			normW = static_cast<double>(win.width) / statsInputSize_.width;
+			normH = static_cast<double>(win.height) / statsInputSize_.height;
+		}
+	}
+
+	PdafRoiSlice slice = PdafEngine::planSlice(*mode, normX, normY, normW, normH);
+	if (!slice.copyLines)
+		return result;
+
+	pdafBuf_.resize(static_cast<std::size_t>(slice.copyLines) * mode->stride);
+	qcom_camss_pdaf_buf req = {};
+	req.version = QCOM_CAMSS_PDAF_VERSION;
+	req.offset_y = slice.offsetY;
+	req.copy_lines = slice.copyLines;
+	req.data = reinterpret_cast<uint64_t>(pdafBuf_.data());
+
+	int ret = video_->ioctl(VIDIOC_QCOM_CAMSS_GET_PDAF, &req);
+	if (ret)
+		return result;
+	if (req.width != mode->width || req.height != mode->height ||
+	    req.stride != mode->stride || req.copy_lines < slice.copyLines)
+		return result;
+
+	result = PdafEngine::compute(*pdafCalibration_, *mode, pdafBuf_.data(),
+				     slice, transform_);
+	result.sequence = req.sequence;
+	return result;
+}
