+std::optional<int32_t> awbModePresetCct(int32_t mode)
+{
+	switch (mode) {
+	case controls::AwbIncandescent:
+		return 2850;
+	case controls::AwbTungsten:
+		return 3200;
+	case controls::AwbFluorescent:
+		return 4000;
+	case controls::AwbIndoor:
+		return 3500;
+	case controls::AwbDaylight:
+		return 5500;
+	case controls::AwbCloudy:
+		return 7000;
+	default:
+		return std::nullopt;
+	}
+}
+
+bool isSupportedAwbMode(int32_t mode)
+{
+	return mode == controls::AwbAuto || awbModePresetCct(mode).has_value();
