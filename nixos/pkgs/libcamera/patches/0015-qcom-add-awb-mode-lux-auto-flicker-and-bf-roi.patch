+++ b/src/libcamera/pipeline/qcom/flicker_detector.h
@@ -0,0 +1,452 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Spatio-temporal 50 Hz / 60 Hz rolling-shutter flicker detector driven by
+ * CAMSS 64x48 AWB Bayer Grid statistics.
+ */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+namespace libcamera::qcom {
+
+class FlickerDetector
+{
+public:
+	static constexpr unsigned int kCols = 64;
+	static constexpr unsigned int kRows = 48;
+	static constexpr unsigned int kRegionWords = 12;
+	static constexpr std::size_t kWindowFrames = 16;
+	static constexpr int32_t kPeriod50HzUs = 10000;
+	static constexpr int32_t kPeriod60HzUs = 8333;
+
+	void reset()
+	{
+		frames_.clear();
+		hasPrevAsym_ = false;
+		prevAsym_.fill(0.0);
+		detectedPeriod_ = 0;
+		candidatePeriod_ = 0;
+		candidateStreak_ = 0;
+		missStreak_ = 0;
+		framesSinceEval_ = 0;
+	}
+
+	int32_t detectedPeriod() const { return detectedPeriod_; }
+
+	/*
+	 * Feed one 64x48 AWB BG frame and update detectedPeriod().
+	 * rowDurationNs is the rolling-shutter readout time covered by one BG row.
+	 */
+	int32_t update(const uint32_t *awbBg, uint64_t timestampNs,
+		       double rowDurationNs, double exposureNs)
+	{
+		if (!awbBg || rowDurationNs <= 0.0 || exposureNs <= 0.0)
+			return detectedPeriod_;
+
+		FrameSample sample{};
+		if (!extractSample(awbBg, timestampNs, exposureNs, sample))
+			return detectedPeriod_;
+
+		if (!frames_.empty()) {
+			const uint64_t prevTs = frames_.back().timestampNs;
+			if (timestampNs <= prevTs || timestampNs - prevTs > 250000000ULL) {
+				frames_.clear();
+				hasPrevAsym_ = false;
+			}
+		}
+
+		/*
+		 * Left/right row asymmetry cancels horizontally uniform AC flicker
+		 * while detecting scene motion or panning.
+		 */
+		std::array<double, kRows> asym{};
+		for (unsigned int r = 0; r < kRows; ++r) {
+			const double denom = sample.left[r] + sample.right[r];
+			asym[r] = denom > 1e-6 ? (sample.left[r] - sample.right[r]) / denom : 0.0;
+		}
+		if (hasPrevAsym_) {
+			double mad = 0.0;
+			for (unsigned int r = 0; r < kRows; ++r)
+				mad += std::abs(asym[r] - prevAsym_[r]);
+			mad /= kRows;
+			if (mad > 0.08) {
+				frames_.clear();
+				framesSinceEval_ = 0;
+			}
+		}
+		prevAsym_ = asym;
+		hasPrevAsym_ = true;
+
+		frames_.push_back(sample);
+		if (frames_.size() > kWindowFrames)
+			frames_.pop_front();
+
+		if (frames_.size() < kWindowFrames)
+			return detectedPeriod_;
+
+		if (++framesSinceEval_ < 4 && frames_.size() == kWindowFrames && detectedPeriod_ != 0)
+			return detectedPeriod_;
+		framesSinceEval_ = 0;
+
+		evaluate(rowDurationNs);
+		return detectedPeriod_;
+	}
+
+private:
+	struct FrameSample {
+		uint64_t timestampNs = 0;
+		double exposureNs = 0.0;
+		std::array<double, kRows> mean{};
+		std::array<double, kRows> left{};
+		std::array<double, kRows> right{};
+	};
+
+	struct SpectrumMetrics {
+		double power = 0.0;
+		double amplitude = 0.0;
+		double coherence = 0.0;
+	};
+
+	static bool extractSample(const uint32_t *awbBg, uint64_t timestampNs,
+				  double exposureNs, FrameSample &out)
+	{
+		uint64_t totalCount = 0;
+		uint64_t satCount = 0;
+		double frameSum = 0.0;
+		double leftMean = 0.0;
+		double rightMean = 0.0;
+
+		for (unsigned int r = 0; r < kRows; ++r) {
+			uint64_t lSum = 0, lCnt = 0;
+			uint64_t rSum = 0, rCnt = 0;
+			for (unsigned int c = 0; c < kCols; ++c) {
+				const uint32_t *reg = awbBg + (r * kCols + c) * kRegionWords;
+				const uint64_t grSum = reg[2] & 0x3fffffffU;
+				const uint64_t gbSum = reg[3] & 0x3fffffffU;
+				const uint64_t grCnt = reg[5] & 0xffffU;
+				const uint64_t gbCnt = (reg[5] >> 16) & 0xffffU;
+				const uint64_t sGrCnt = reg[11] & 0xffffU;
+				const uint64_t sGbCnt = (reg[11] >> 16) & 0xffffU;
+				const uint64_t gCnt = grCnt + gbCnt;
+				const uint64_t gSum = grSum + gbSum;
+
+				totalCount += gCnt + sGrCnt + sGbCnt;
+				satCount += sGrCnt + sGbCnt;
+				if (c < kCols / 2) {
+					lSum += gSum;
+					lCnt += gCnt;
+				} else {
+					rSum += gSum;
+					rCnt += gCnt;
+				}
+			}
+			if (!lCnt || !rCnt)
+				return false;
+			out.left[r] = static_cast<double>(lSum) / lCnt;
+			out.right[r] = static_cast<double>(rSum) / rCnt;
+			out.mean[r] = static_cast<double>(lSum + rSum) / (lCnt + rCnt);
+			frameSum += out.mean[r];
+			leftMean += out.left[r];
+			rightMean += out.right[r];
+		}
+
+		if (!totalCount || satCount * 4 > totalCount)
+			return false;
+
+		frameSum /= kRows;
+		leftMean /= kRows;
+		rightMean /= kRows;
+		if (frameSum < 16.0 || leftMean < 8.0 || rightMean < 8.0)
+			return false;
+
+		for (unsigned int r = 0; r < kRows; ++r) {
+			out.mean[r] /= frameSum;
+			out.left[r] /= leftMean;
+			out.right[r] /= rightMean;
+		}
+		out.timestampNs = timestampNs;
+		out.exposureNs = exposureNs;
+		return true;
+	}
+
+	static double exposureSensitivity(double freqHz, double exposureSec)
+	{
+		const double x = M_PI * freqHz * exposureSec;
+		if (x < 1e-6)
+			return 1.0;
+		return std::abs(std::sin(x) / x);
+	}
+
+	static double hann(std::size_t i, std::size_t n)
+	{
+		if (n <= 1)
+			return 1.0;
+		return 0.5 * (1.0 - std::cos(2.0 * M_PI * static_cast<double>(i) / (n - 1)));
+	}
+
+	static void detrendQuadratic(std::array<double, kRows> &v)
+	{
+		/* Orthogonal least-squares fit on centered x in [-1, 1]. */
+		double s0 = 0.0, s2 = 0.0, s4 = 0.0;
+		double y0 = 0.0, y1 = 0.0, y2 = 0.0;
+		for (unsigned int r = 0; r < kRows; ++r) {
+			const double x = 2.0 * static_cast<double>(r) / (kRows - 1) - 1.0;
+			const double x2 = x * x;
+			s0 += 1.0;
+			s2 += x2;
+			s4 += x2 * x2;
+			y0 += v[r];
+			y1 += x * v[r];
+			y2 += x2 * v[r];
+		}
+		const double det = s0 * s4 - s2 * s2;
+		const double c0 = (s4 * y0 - s2 * y2) / det;
+		const double c1 = y1 / s2;
+		const double c2 = (s0 * y2 - s2 * y0) / det;
+		for (unsigned int r = 0; r < kRows; ++r) {
+			const double x = 2.0 * static_cast<double>(r) / (kRows - 1) - 1.0;
+			v[r] -= c0 + c1 * x + c2 * x * x;
+		}
+	}
+
+	double temporalPhaseLockMetric(double freqHz) const
+	{
+		const uint64_t t0 = frames_.front().timestampNs;
+		double re = 0.0, im = 0.0;
+		for (const auto &f : frames_) {
+			const double t = static_cast<double>(f.timestampNs - t0) * 1e-9;
+			const double angle = 2.0 * M_PI * freqHz * t;
+			re += std::cos(angle);
+			im += std::sin(angle);
+		}
+		return std::hypot(re, im) / static_cast<double>(frames_.size());
+	}
+
+	SpectrumMetrics temporalSpectrum(double freqHz, double rowDurationSec,
+					 const std::array<double, kRows> &meanBar,
+					 const std::array<double, kRows> &leftBar,
+					 const std::array<double, kRows> &rightBar) const
+	{
+		const uint64_t t0 = frames_.front().timestampNs;
+		const std::size_t w = frames_.size();
+		double reM = 0.0, imM = 0.0;
+		double reL = 0.0, imL = 0.0;
+		double reR = 0.0, imR = 0.0;
+		double weightSum = 0.0;
+
+		for (std::size_t k = 0; k < w; ++k) {
+			const double wk = hann(k, w);
+			const double tk = static_cast<double>(frames_[k].timestampNs - t0) * 1e-9;
+			for (unsigned int r = 0; r < kRows; ++r) {
+				const double wr = wk * hann(r, kRows);
+				const double phase = 2.0 * M_PI * freqHz * (tk + r * rowDurationSec);
+				const double c = std::cos(phase);
+				const double s = -std::sin(phase);
+
+				const double dm = (frames_[k].mean[r] - meanBar[r]) / std::max(meanBar[r], 0.1);
+				const double dl = (frames_[k].left[r] - leftBar[r]) / std::max(leftBar[r], 0.1);
+				const double dr = (frames_[k].right[r] - rightBar[r]) / std::max(rightBar[r], 0.1);
+
+				reM += wr * dm * c;
+				imM += wr * dm * s;
+				reL += wr * dl * c;
+				imL += wr * dl * s;
+				reR += wr * dr * c;
+				imR += wr * dr * s;
+				weightSum += wr;
+			}
+		}
+
+		if (weightSum <= 0.0)
+			return {};
+
+		reM /= weightSum;
+		imM /= weightSum;
+		reL /= weightSum;
+		imL /= weightSum;
+		reR /= weightSum;
+		imR /= weightSum;
+
+		const double ampM = std::hypot(reM, imM);
+		const double ampL = std::hypot(reL, imL);
+		const double ampR = std::hypot(reR, imR);
+		const double coherence = (reL * reR + imL * imR) / (ampL * ampR + 1e-12);
+		return { ampM * ampM, ampM, coherence };
+	}
+
+	static SpectrumMetrics spatialSpectrum(double freqHz, double rowDurationSec,
+					       const std::array<double, kRows> &detrendM,
+					       const std::array<double, kRows> &detrendL,
+					       const std::array<double, kRows> &detrendR)
+	{
+		double reM = 0.0, imM = 0.0;
+		double reL = 0.0, imL = 0.0;
+		double reR = 0.0, imR = 0.0;
+		double weightSum = 0.0;
+
+		for (unsigned int r = 0; r < kRows; ++r) {
+			const double wr = hann(r, kRows);
+			const double phase = 2.0 * M_PI * freqHz * (r * rowDurationSec);
+			const double c = std::cos(phase);
+			const double s = -std::sin(phase);
+			reM += wr * detrendM[r] * c;
+			imM += wr * detrendM[r] * s;
+			reL += wr * detrendL[r] * c;
+			imL += wr * detrendL[r] * s;
+			reR += wr * detrendR[r] * c;
+			imR += wr * detrendR[r] * s;
+			weightSum += wr;
+		}
+
+		if (weightSum <= 0.0)
+			return {};
+
+		reM /= weightSum;
+		imM /= weightSum;
+		reL /= weightSum;
+		imL /= weightSum;
+		reR /= weightSum;
+		imR /= weightSum;
+
+		const double ampM = std::hypot(reM, imM);
+		const double ampL = std::hypot(reL, imL);
+		const double ampR = std::hypot(reR, imR);
+		const double coherence = (reL * reR + imL * imR) / (ampL * ampR + 1e-12);
+		return { ampM * ampM, ampM, coherence };
+	}
+
+	void evaluate(double rowDurationNs)
+	{
+		const double rowDurationSec = rowDurationNs * 1e-9;
+		const std::size_t w = frames_.size();
+
+		double avgExpSec = 0.0;
+		std::array<double, kRows> meanBar{};
+		std::array<double, kRows> leftBar{};
+		std::array<double, kRows> rightBar{};
+		for (const auto &f : frames_) {
+			avgExpSec += f.exposureNs * 1e-9;
+			for (unsigned int r = 0; r < kRows; ++r) {
+				meanBar[r] += f.mean[r];
+				leftBar[r] += f.left[r];
+				rightBar[r] += f.right[r];
+			}
+		}
+		avgExpSec /= w;
+		for (unsigned int r = 0; r < kRows; ++r) {
+			meanBar[r] /= w;
+			leftBar[r] /= w;
+			rightBar[r] /= w;
+		}
+
+		std::array<double, kRows> detrendM = meanBar;
+		std::array<double, kRows> detrendL = leftBar;
+		std::array<double, kRows> detrendR = rightBar;
+		detrendQuadratic(detrendM);
+		detrendQuadratic(detrendL);
+		detrendQuadratic(detrendR);
+
+		static constexpr double kNoiseFreqs[] = { 75.0, 85.0, 110.0, 135.0, 150.0 };
+		double temporalNoise = 0.0;
+		for (double nf : kNoiseFreqs)
+			temporalNoise += temporalSpectrum(nf, rowDurationSec, meanBar, leftBar, rightBar).power;
+		temporalNoise /= std::size(kNoiseFreqs);
+
+		/*
+		 * For 1D spatial analysis, place noise probes well outside the Hann
+		 * main lobe (width ~2 / T_readout) so 100/120 Hz energy does not leak
+		 * into the background estimate.
+		 */
+		const double frameReadoutSec = rowDurationSec * kRows;
+		const double spatialBaseHz = frameReadoutSec > 0.0 ? 1.0 / frameReadoutSec : 100.0;
+		double spatialNoise = 0.0;
+		for (unsigned int k = 0; k < 4; ++k) {
+			const double nf = 120.0 + (3.0 + k) * spatialBaseHz;
+			spatialNoise += spatialSpectrum(nf, rowDurationSec, detrendM, detrendL, detrendR).power;
+		}
+		spatialNoise /= 4.0;
+
+		struct Candidate {
+			double freqHz;
+			int32_t periodUs;
+			double score;
+			bool sensitive;
+		};
+		std::array<Candidate, 2> candidates = { {
+			{ 100.0, kPeriod50HzUs, 0.0, true },
+			{ 120.0, kPeriod60HzUs, 0.0, true },
+		} };
+
+		for (auto &cand : candidates) {
+			const double sens = exposureSensitivity(cand.freqHz, avgExpSec);
+			cand.sensitive = sens >= 0.18;
+			if (!cand.sensitive)
+				continue;
+
+			const double phaseLock = temporalPhaseLockMetric(cand.freqHz);
+			if (phaseLock < 0.70) {
+				const auto spec = temporalSpectrum(cand.freqHz, rowDurationSec,
+								   meanBar, leftBar, rightBar);
+				const double snr = spec.power / (temporalNoise + 1e-10);
+				if (snr >= 8.0 && spec.coherence >= 0.50 && spec.amplitude >= 0.004)
+					cand.score = snr * spec.coherence;
+			} else if (rowDurationSec * kRows * cand.freqHz >= 0.85) {
+				/*
+				 * When flicker is phase-locked to frame rate (e.g. 120 Hz at
+				 * 60 fps), require strong horizontal left/right coherence across
+				 * the averaged frame to reject static scene structure.
+				 */
+				const auto spec = spatialSpectrum(cand.freqHz, rowDurationSec,
+								  detrendM, detrendL, detrendR);
+				const double snr = spec.power / (spatialNoise + 1e-10);
+				if (snr >= 12.0 && spec.coherence >= 0.85 && spec.amplitude >= 0.012)
+					cand.score = snr * spec.coherence;
+			}
+		}
+
+		int32_t winner = 0;
+		if (candidates[0].score > 0.0 && candidates[0].score > 1.5 * candidates[1].score)
+			winner = candidates[0].periodUs;
+		else if (candidates[1].score > 0.0 && candidates[1].score > 1.5 * candidates[0].score)
+			winner = candidates[1].periodUs;
+
+		if (winner != 0) {
+			missStreak_ = 0;
+			if (winner == candidatePeriod_) {
+				candidateStreak_++;
+			} else {
+				candidatePeriod_ = winner;
+				candidateStreak_ = 1;
+			}
+			if (candidateStreak_ >= 3)
+				detectedPeriod_ = winner;
+		} else {
+			/* Hold an existing lock while quantized exposure suppresses its ripple. */
+			const bool lockedSuppressed =
+				(detectedPeriod_ == kPeriod50HzUs && !candidates[0].sensitive) ||
+				(detectedPeriod_ == kPeriod60HzUs && !candidates[1].sensitive);
+			if (!lockedSuppressed) {
+				candidatePeriod_ = 0;
+				candidateStreak_ = 0;
+				if (++missStreak_ >= 4)
+					detectedPeriod_ = 0;
+			}
+		}
+	}
+
+	std::deque<FrameSample> frames_;
+	bool hasPrevAsym_ = false;
+	std::array<double, kRows> prevAsym_{};
+	int32_t detectedPeriod_ = 0;
+	int32_t candidatePeriod_ = 0;
+	unsigned int candidateStreak_ = 0;
+	unsigned int missStreak_ = 0;
+	unsigned int framesSinceEval_ = 0;
+};
+
+} /* namespace libcamera::qcom */
