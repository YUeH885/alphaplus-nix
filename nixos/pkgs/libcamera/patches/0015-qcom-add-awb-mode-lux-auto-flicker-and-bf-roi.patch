+void QcomCameraData::syncBfRoi()
+{
+	if (statsInputSize_.width < 208 || statsInputSize_.height < 104) {
+		activeBfRoi_ = {};
+		updateAfWeights();
+		return;
+	}
+
+	const uint16_t fullLeft = 64;
+	const uint16_t fullTop = 32;
+	const uint16_t fullWidth = static_cast<uint16_t>((statsInputSize_.width - 128) & ~1U);
+	const uint16_t fullHeight = static_cast<uint16_t>((statsInputSize_.height - 64) & ~1U);
+
+	auto mapAnalogRect = [this](Rectangle r) -> std::optional<Rectangle> {
+		r = r.boundedTo(analogCrop_);
+		if (!r.width || !r.height)
+			return std::nullopt;
+		r = r.transformedBetween(analogCrop_, Rectangle(statsInputSize_));
+		if (!!(transform_ & Transform::HFlip))
+			r.x = statsInputSize_.width - (r.x + r.width);
+		if (!!(transform_ & Transform::VFlip))
+			r.y = statsInputSize_.height - (r.y + r.height);
+		return r;
+	};
+
+	std::optional<Rectangle> target;
+	if (afMetering_ == controls::AfMeteringWindows && !afWindows_.empty()) {
+		int minX = statsInputSize_.width, minY = statsInputSize_.height;
+		int maxX = 0, maxY = 0;
+		for (const Rectangle &window : afWindows_) {
+			if (auto mapped = mapAnalogRect(window)) {
+				minX = std::min(minX, mapped->x);
+				minY = std::min(minY, mapped->y);
+				maxX = std::max(maxX, mapped->x + static_cast<int>(mapped->width));
+				maxY = std::max(maxY, mapped->y + static_cast<int>(mapped->height));
+			}
+		}
+		if (maxX > minX && maxY > minY)
+			target = Rectangle(minX, minY, maxX - minX, maxY - minY);
+	} else if (hasScalerCrop_ &&
+		   (activeScaler_.compose_width != defaultScaler_.compose_width ||
+		    activeScaler_.compose_height != defaultScaler_.compose_height ||
+		    activeScaler_.left != defaultScaler_.left ||
+		    activeScaler_.top != defaultScaler_.top)) {
+		target = mapAnalogRect(scalerCropRectangle());
+	}
+
+	qcom_camss_bf_roi hwRoi = {};
+	qcom_camss_bf_roi effective = { fullLeft, fullTop, fullWidth, fullHeight };
+	if (hasBfRoi_ && target) {
+		const int validLeft = fullLeft;
+		const int validTop = fullTop;
+		const int validRight = fullLeft + fullWidth;
+		const int validBottom = fullTop + fullHeight;
+		int w = std::clamp<int>(target->width, 80, fullWidth) & ~1;
+		int h = std::clamp<int>(target->height, 40, fullHeight) & ~1;
+		int x = std::clamp<int>(target->x + static_cast<int>(target->width) / 2 - w / 2,
+					validLeft, validRight - w) & ~1;
+		int y = std::clamp<int>(target->y + static_cast<int>(target->height) / 2 - h / 2,
+					validTop, validBottom - h) & ~1;
+		if (x < validLeft)
+			x = validLeft;
+		if (y < validTop)
+			y = validTop;
+		if (x + w > validRight)
+			w = (validRight - x) & ~1;
+		if (y + h > validBottom)
+			h = (validBottom - y) & ~1;
+		if (w >= 80 && h >= 40) {
+			effective = { static_cast<uint16_t>(x), static_cast<uint16_t>(y),
+				      static_cast<uint16_t>(w), static_cast<uint16_t>(h) };
+			if (effective.left != fullLeft || effective.top != fullTop ||
+			    effective.width != fullWidth || effective.height != fullHeight)
+				hwRoi = effective;
+		}
+	}
+
+	activeBfRoi_ = effective;
+	if (hasBfRoi_ && pix_ && pix_->isOpen() &&
+	    (!bfRoiProgrammed_ ||
+	     std::memcmp(&hwRoi, &programmedBfRoi_, sizeof(hwRoi)) != 0)) {
+		struct v4l2_ext_control control = {};
+		struct v4l2_ext_controls controls = {};
+		control.id = V4L2_CID_QCOM_CAMSS_BF_ROI;
+		control.size = sizeof(hwRoi);
+		control.ptr = &hwRoi;
+		controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+		controls.count = 1;
+		controls.controls = &control;
+		int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+		if (ret) {
+			LOG(QcomPipeline, Warning) << "Failed to program BF ROI: " << ret;
+			activeBfRoi_ = { fullLeft, fullTop, fullWidth, fullHeight };
+		} else {
+			programmedBfRoi_ = hwRoi;
+			bfRoiProgrammed_ = true;
+		}
+	}
+	updateAfWeights();
+}
