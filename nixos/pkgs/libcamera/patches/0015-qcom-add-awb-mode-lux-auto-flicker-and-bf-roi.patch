+void QcomCameraData::applyAwbTemperature(int32_t cct)
+{
+	cct = std::clamp(cct, 1500, 12000);
+	if (qtiAwb_) {
+		auto manualGains = qtiAwb_->manualGains(cct);
+		setManualAwb(manualGains[0], manualGains[1], cct);
+	} else if (lgAwb_) {
+		const auto &colour = lgAwb_->grayCore().colour();
+		auto ratios = lgAwbRatiosForTemperature(colour, cct);
+		if (ratios.red > 0.0f && ratios.blue > 0.0f)
+			setManualAwb(1.0 / ratios.red, 1.0 / ratios.blue, cct);
+	}
+}
+
+float QcomCameraData::estimateLux() const
+{
+	if (!luxIndex_)
+		return 0.0f;
+
+	/* Convert QTI inverse log lux index using each lens f-number at ISO 50 base. */
+	constexpr double kCalibrationConstant = 250.0;
+	constexpr double kBaseIso = 50.0;
+	const double minTotalSec = profileTotalExposure(profile_.aeExposureKnees[0]) * 1e-9;
+	if (minTotalSec <= 0.0)
+		return 0.0f;
+	const double luxAtZero = kCalibrationConstant * profile_.fNumber * profile_.fNumber /
+				 (kBaseIso * minTotalSec);
+	const double lux = luxAtZero * std::pow(10.0, -(*luxIndex_) / profile_.aeLuxLogScale);
+	return static_cast<float>(std::clamp(lux, 0.0, 1e6));
+}
