+Rectangle QcomCameraData::scalerCropRectangle() const
+{
+	const double scaleX = static_cast<double>(analogCrop_.width) / activeScaler_.compose_width;
+	const double scaleY = static_cast<double>(analogCrop_.height) / activeScaler_.compose_height;
+	const unsigned int width = static_cast<unsigned int>(std::lround(scalerOutput_.width * scaleX));
+	const unsigned int height = static_cast<unsigned int>(std::lround(scalerOutput_.height * scaleY));
+	int offsetX = static_cast<int>(std::lround(activeScaler_.left * scaleX));
+	int offsetY = static_cast<int>(std::lround(activeScaler_.top * scaleY));
+	if (!!(transform_ & Transform::HFlip))
+		offsetX = std::max(0, static_cast<int>(analogCrop_.width) - offsetX - static_cast<int>(width));
+	if (!!(transform_ & Transform::VFlip))
+		offsetY = std::max(0, static_cast<int>(analogCrop_.height) - offsetY - static_cast<int>(height));
+
+	return { analogCrop_.x + offsetX, analogCrop_.y + offsetY, width, height };
+}
+
+Rectangle QcomCameraData::minScalerCropRectangle() const
+{
+	const unsigned int maxComposeW = std::max<unsigned int>(defaultScaler_.compose_width,
+								statsInputSize_.width & ~1U);
+	const unsigned int maxComposeH = std::max<unsigned int>(defaultScaler_.compose_height,
+								statsInputSize_.height & ~1U);
+	if (!maxComposeW || !maxComposeH || !scalerOutput_.width || !scalerOutput_.height)
+		return analogCrop_;
+
+	const unsigned int minW = std::max<unsigned int>(
+		1U, static_cast<unsigned int>(std::lround(static_cast<double>(analogCrop_.width) *
+							  scalerOutput_.width / maxComposeW)));
+	const unsigned int minH = std::max<unsigned int>(
+		1U, static_cast<unsigned int>(std::lround(static_cast<double>(analogCrop_.height) *
+							  scalerOutput_.height / maxComposeH)));
+	return { analogCrop_.x, analogCrop_.y,
+		 std::min(minW, analogCrop_.width),
+		 std::min(minH, analogCrop_.height) };
+}
+
+void QcomCameraData::setScalerCrop(const Rectangle &request)
+{
+	const Rectangle crop = request.boundedTo(analogCrop_);
+	if (!crop.width || !crop.height) {
+		activeScaler_ = defaultScaler_;
+		return;
+	}
+
+	const double fullWidth = static_cast<double>(analogCrop_.width) * scalerOutput_.width /
+				 defaultScaler_.compose_width;
+	const double fullHeight = static_cast<double>(analogCrop_.height) * scalerOutput_.height /
+				  defaultScaler_.compose_height;
+	const double maxZoom = std::min(static_cast<double>(statsInputSize_.width) /
+						defaultScaler_.compose_width,
+					static_cast<double>(statsInputSize_.height) /
+						defaultScaler_.compose_height);
+	const double zoom = std::clamp(std::min(fullWidth / crop.width, fullHeight / crop.height),
+				       1.0, maxZoom);
+	const auto roundEven = [](double value) { return std::lround(value / 2) * 2; };
+	const long width = std::min<long>(roundEven(defaultScaler_.compose_width * zoom),
+					  statsInputSize_.width & ~1U);
+	const long height = std::min<long>(roundEven(defaultScaler_.compose_height * zoom),
+					   statsInputSize_.height & ~1U);
+	double centreX = crop.x - analogCrop_.x + crop.width / 2.0;
+	double centreY = crop.y - analogCrop_.y + crop.height / 2.0;
+	if (!!(transform_ & Transform::HFlip))
+		centreX = analogCrop_.width - centreX;
+	if (!!(transform_ & Transform::VFlip))
+		centreY = analogCrop_.height - centreY;
+	const long left = std::clamp(roundEven(centreX * width / analogCrop_.width -
+					       scalerOutput_.width / 2.0),
+				     0L, width - scalerOutput_.width);
+	const long top = std::clamp(roundEven(centreY * height / analogCrop_.height -
+					      scalerOutput_.height / 2.0),
+				    0L, height - scalerOutput_.height);
+	activeScaler_ = { static_cast<uint16_t>(width), static_cast<uint16_t>(height),
+			  static_cast<uint16_t>(left), static_cast<uint16_t>(top) };
+}
