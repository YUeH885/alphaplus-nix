+QcomCameraData::AeLimits QcomCameraData::aeLimits() const
+{
+	const double exposure = std::clamp(aeExposure_, static_cast<double>(exposureMin_),
+					   static_cast<double>(exposureMax_)) * lineDurationNs_;
+	return {
+		autoExposure_ ? exposureMin_ * lineDurationNs_ : exposure,
+		autoExposure_ ? exposureMax_ * lineDurationNs_ : exposure,
+		autoGain_ ? gainMin_ : aeGain_,
+		autoGain_ ? gainMax_ : aeGain_,
+	};
+}
+
+std::pair<double, double> QcomCameraData::allocateExposure(double energy, const AeLimits &limits) const
+{
+	double gain, exposure;
+	aeAllocateExposure(profile_, energy, gain, exposure);
+	gain = std::clamp(gain, limits.minGain, limits.maxGain);
+	exposure = std::clamp(energy / gain, limits.minExposure, limits.maxExposure);
+	gain = std::clamp(energy / exposure, limits.minGain, limits.maxGain);
+	return { exposure, gain };
+}
