diff --git a/src/libcamera/camera_lens.cpp b/src/libcamera/camera_lens.cpp
index ccc2a6a..7c1d273 100644
--- a/src/libcamera/camera_lens.cpp
+++ b/src/libcamera/camera_lens.cpp
@@ -76,6 +76,25 @@ int CameraLens::init()
 	return 0;
 }
 
+/**
+ * \brief Open an initialized lens for focus control
+ * \return 0 on success or a negative error code otherwise
+ */
+int CameraLens::open()
+{
+	return subdev_->open();
+}
+
+/**
+ * \brief Close the lens device to release its runtime power reference
+ *
+ * Call open() before accessing focus controls again.
+ */
+void CameraLens::close()
+{
+	subdev_->close();
+}
+
 /**
  * \brief This function sets the focal point of the lens to a specific position.
  * \param[in] position The focal point of the lens
@@ -95,6 +114,21 @@ int CameraLens::setFocusPosition(int32_t position)
 	return 0;
 }
 
+/**
+ * \brief Read the lens position from the driver
+ * \param[out] position The current lens position
+ * \return 0 on success or a negative error code otherwise
+ */
+int CameraLens::getFocusPosition(int32_t *position)
+{
+	const uint32_t id = V4L2_CID_FOCUS_ABSOLUTE;
+	ControlList controls = subdev_->getControls({ &id, 1 });
+	if (controls.empty())
+		return -EIO;
+	*position = controls.get(id).get<int32_t>();
+	return 0;
+}
+
 int CameraLens::validateLensDriver()
 {
 	int ret = 0;
diff --git a/src/libcamera/sensor/camera_sensor_legacy.cpp b/src/libcamera/sensor/camera_sensor_legacy.cpp
index 6a68382..1fe3a55 100644
--- a/src/libcamera/sensor/camera_sensor_legacy.cpp
+++ b/src/libcamera/sensor/camera_sensor_legacy.cpp
@@ -68,6 +68,7 @@ public:
 	V4L2Subdevice *device() override { return subdev_.get(); }
 
 	CameraLens *focusLens() override { return focusLens_.get(); }
+	V4L2Subdevice *ois() override { return ois_.get(); }
 
 	const std::vector<unsigned int> &mbusCodes() const override { return mbusCodes_; }
 	std::vector<Size> sizes(unsigned int mbusCode) const override;
@@ -140,6 +141,7 @@ private:
 	ControlList properties_;
 
 	std::unique_ptr<CameraLens> focusLens_;
+	std::unique_ptr<V4L2Subdevice> ois_;
 };
 
 /**
@@ -656,15 +658,36 @@ int CameraSensorLegacy::discoverAncillaryDevices()
 
 	for (MediaEntity *ancillary : entity_->ancillaryEntities()) {
 		switch (ancillary->function()) {
-		case MEDIA_ENT_F_LENS:
-			focusLens_ = std::make_unique<CameraLens>(ancillary);
-			ret = focusLens_->init();
-			if (ret) {
-				LOG(CameraSensor, Error)
-					<< "Lens initialisation failed, lens disabled";
-				focusLens_.reset();
+		case MEDIA_ENT_F_LENS: {
+			V4L2Subdevice subdev(ancillary);
+			if (subdev.open() == 0) {
+				const auto &controls = subdev.controls();
+				if (controls.count(V4L2_CID_FOCUS_ABSOLUTE) && !focusLens_) {
+					focusLens_ = std::make_unique<CameraLens>(ancillary);
+					ret = focusLens_->init();
+					if (ret) {
+						LOG(CameraSensor, Error)
+							<< "Lens initialisation failed, lens disabled";
+						focusLens_.reset();
+					}
+					break;
+				}
+				if (controls.count(V4L2_CID_IMAGE_STABILIZATION) && !ois_) {
+					ois_ = std::make_unique<V4L2Subdevice>(ancillary);
+					if (ois_->open() == 0) {
+						LOG(CameraSensor, Info)
+							<< "Discovered OIS lens " << ancillary->name();
+					} else {
+						ois_.reset();
+					}
+					break;
+				}
 			}
+			LOG(CameraSensor, Info)
+				<< "Ignoring unsupported lens ancillary entity "
+				<< ancillary->name();
 			break;
+		}
 
 		default:
 			LOG(CameraSensor, Warning)
