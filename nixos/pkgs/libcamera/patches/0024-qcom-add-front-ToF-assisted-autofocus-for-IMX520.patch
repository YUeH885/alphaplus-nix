+
+		const int cx0 = std::clamp(x0, 0, static_cast<int>(kWidth));
+		const int cy0 = std::clamp(y0, 0, static_cast<int>(kHeight));
+		const int cx1 = std::clamp(x1, cx0, static_cast<int>(kWidth));
