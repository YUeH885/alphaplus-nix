+TofDepthRoiSample QcomCameraData::measureTofDepth(uint64_t minTimestampNs) const
+{
+	if (!tofAssist_)
+		return {};
+
+	const Size arraySize = analogCrop_.width && analogCrop_.height
+				       ? analogCrop_.size()
+				       : Size{ 3280, 2460 };
+	const Rectangle arrayBounds(analogCrop_.width && analogCrop_.height
+					      ? analogCrop_
+					      : Rectangle(arraySize));
+	Rectangle roi;
+	bool haveRoi = false;
+
+	if (afMetering_ == controls::AfMeteringWindows && !afWindows_.empty()) {
+		int minX = arrayBounds.x + static_cast<int>(arrayBounds.width);
+		int minY = arrayBounds.y + static_cast<int>(arrayBounds.height);
+		int maxX = arrayBounds.x;
+		int maxY = arrayBounds.y;
+		for (const Rectangle &w : afWindows_) {
+			Rectangle bounded = w.boundedTo(arrayBounds);
+			if (!bounded.width || !bounded.height)
+				continue;
+			minX = std::min(minX, bounded.x);
+			minY = std::min(minY, bounded.y);
+			maxX = std::max(maxX, bounded.x + static_cast<int>(bounded.width));
+			maxY = std::max(maxY, bounded.y + static_cast<int>(bounded.height));
+		}
+		if (maxX > minX && maxY > minY) {
+			roi = Rectangle(minX, minY, static_cast<unsigned int>(maxX - minX),
+					static_cast<unsigned int>(maxY - minY));
+			haveRoi = true;
+		}
+	} else if (afMetering_ == controls::AfMeteringAuto &&
+		   faceDetectMode_ != controls::draft::FaceDetectModeOff &&
+		   !hwFaces_.empty() &&
+		   statsInputSize_.width > 0 && statsInputSize_.height > 0) {
+		Rectangle face = hwFaces_.front().rect.boundedTo(Rectangle(statsInputSize_));
+		if (face.width && face.height) {
+			if (!!(transform_ & Transform::HFlip))
+				face.x = statsInputSize_.width - (face.x + static_cast<int>(face.width));
+			if (!!(transform_ & Transform::VFlip))
+				face.y = statsInputSize_.height - (face.y + static_cast<int>(face.height));
+			roi = face.transformedBetween(Rectangle(statsInputSize_), arrayBounds);
+			haveRoi = roi.width > 0 && roi.height > 0;
+		}
+	} else if (hasScalerCrop_) {
+		Rectangle crop = scalerCropRectangle().boundedTo(arrayBounds);
+		if (crop.width && crop.height) {
+			unsigned int rw = std::max(1U, crop.width * 2 / 5);
+			unsigned int rh = std::max(1U, crop.height * 2 / 5);
+			roi = Rectangle(crop.x + static_cast<int>((crop.width - rw) / 2),
+					crop.y + static_cast<int>((crop.height - rh) / 2),
+					rw, rh);
+			haveRoi = true;
+		}
+	}
+
+	if (!haveRoi) {
+		unsigned int rw = std::max(1U, arrayBounds.width * 3 / 10);
+		unsigned int rh = std::max(1U, arrayBounds.height * 3 / 10);
+		roi = Rectangle(arrayBounds.x + static_cast<int>((arrayBounds.width - rw) / 2),
+				arrayBounds.y + static_cast<int>((arrayBounds.height - rh) / 2),
+				rw, rh);
+	}
+
+	/* Project IMX520 (0x0101=0x02, Y-inverted vs IRS2381C) onto ToF intrinsics. */
+	static constexpr double kImx520FocalPx = 2.92 / 0.00112;
+	static constexpr double kImx520Cx = 1640.0;
+	static constexpr double kImx520Cy = 1232.0;
+	const TofIntrinsics lens = tofAssist_->intrinsics();
+
+	auto projectX = [&](double ax) -> double {
+		return lens.cx + ((ax - kImx520Cx) / kImx520FocalPx) * lens.fx;
+	};
+	auto projectY = [&](double ay) -> double {
+		return lens.cy - ((ay - kImx520Cy) / kImx520FocalPx) * lens.fy;
+	};
+
+	const double fx0 = projectX(roi.x);
+	const double fy0 = projectY(roi.y);
+	const double fx1 = projectX(roi.x + roi.width);
+	const double fy1 = projectY(roi.y + roi.height);
+
+	int tx0 = static_cast<int>(std::floor(std::min(fx0, fx1)));
+	int ty0 = static_cast<int>(std::floor(std::min(fy0, fy1)));
+	int tx1 = static_cast<int>(std::ceil(std::max(fx0, fx1)));
+	int ty1 = static_cast<int>(std::ceil(std::max(fy0, fy1)));
+
+	if (tx1 - tx0 < 16) {
+		int cx = (tx0 + tx1) / 2;
+		tx0 = cx - 8;
+		tx1 = cx + 8;
+	}
+	if (ty1 - ty0 < 16) {
+		int cy = (ty0 + ty1) / 2;
+		ty0 = cy - 8;
+		ty1 = cy + 8;
+	}
+
+	tx0 = std::clamp(tx0, 0, static_cast<int>(TofDemodulator::kWidth));
+	ty0 = std::clamp(ty0, 0, static_cast<int>(TofDemodulator::kHeight));
+	tx1 = std::clamp(tx1, tx0, static_cast<int>(TofDemodulator::kWidth));
+	ty1 = std::clamp(ty1, ty0, static_cast<int>(TofDemodulator::kHeight));
+
+	return tofAssist_->sampleDepth(tx0, ty0, tx1, ty1, minTimestampNs);
+}
