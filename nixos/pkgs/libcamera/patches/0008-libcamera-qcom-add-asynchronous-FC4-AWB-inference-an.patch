+		float hist0 = historySlots[0];
+		float hist1 = historySlots[1];
+		float hist2 = historySlots[2];
+
+		if (std::abs(hist1) <= 1e-6f)
+			return meta;
+
+		meta[0] = historySlots[3];
+		meta[1] = historySlots[4];
+		meta[4] = historySlots[5];
+		meta[5] = historySlots[6];
+
+		float ratio_r = hist0 / hist1;
+		float ratio_b = hist2 / hist1;
+		if (ratio_r > 0.0f && ratio_b > 0.0f) {
+			float inv_r = 1.0f / ratio_r;
+			float inv_b = 1.0f / ratio_b;
+			float scale_r = 1.0f, scale_b = 1.0f;
+			goldenToCalRbRatio(inv_r, inv_b, golden, calib, scale_r, scale_b);
+			meta[2] = ratio_r / scale_r;
+			meta[3] = ratio_b / scale_b;
+		}
+		return meta;
+	}
