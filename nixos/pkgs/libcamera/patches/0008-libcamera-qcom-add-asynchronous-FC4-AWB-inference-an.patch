+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_colour.h"
+
+namespace libcamera::qcom {
+
+struct RgbRatio { float r, b; };
+
+static constexpr std::array<RgbRatio, 2> goldenImx363 = {{
+	{ 0.49671701f, 0.57841599f },
+	{ 0.77151698f, 0.35769400f }
+}};
+
+static constexpr std::array<RgbRatio, 2> goldenImx351 = {{
+	{ 0.60429603f, 0.55656499f },
+	{ 0.92985100f, 0.35342500f }
+}};
+
+static constexpr std::array<RgbRatio, 2> goldenS5k3m5 = {{
+	{ 0.52828097f, 0.54978502f },
+	{ 0.85263002f, 0.34289101f }
+}};
+
+inline std::array<RgbRatio, 2> getGoldenRefs(int sensorType)
+{
+	if (sensorType == 16)
+		return goldenImx351;
+	if (sensorType == 17)
+		return goldenImx363;
+	return goldenS5k3m5;
+}
+
+inline std::array<RgbRatio, 2> resolveCalibRefs(const LgAwbWhiteBalanceCalibration &calib, int sensorType)
+{
+	auto golden = getGoldenRefs(sensorType);
+	std::array<RgbRatio, 2> refs = golden;
+	if (calib.valid[0] && calib.measured[0].red > 1e-6f && calib.measured[0].blue > 1e-6f) {
+		refs[0] = { calib.measured[0].red, calib.measured[0].blue };
+	}
