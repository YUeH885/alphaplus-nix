+};
+
+class LgAeMotion {
+public:
+	LgAeMotion() = default;
+
+	void reset()
+	{
+		info_ = LgMotionInfo{};
+	}
+
+	uint8_t motionFlagForExposure() const
+	{
+		return info_.motionFlagForExposure;
+	}
+
+	const LgMotionInfo &info() const
+	{
+		return info_;
+	}
+
+	LgMotionInfo &info()
+	{
+		return info_;
+	}
+
+	void analyzeScene(const uint32_t *histogram, size_t numBins)
+	{
+		if (!histogram || numBins == 0) {
+			info_.histSceneFlag = 0;
+			return;
+		}
+
+		uint32_t idx8 = static_cast<uint32_t>(static_cast<float>(numBins) * 0.08f);
+		uint32_t idx90 = static_cast<uint32_t>(static_cast<float>(numBins) * 0.90f);
+		uint32_t idx98 = static_cast<uint32_t>(static_cast<float>(numBins) * 0.98f);
+
+		float sumLow = 0.0f;
+		for (uint32_t i = 0; i < idx8 && i < numBins; ++i)
+			sumLow += static_cast<float>(histogram[i]);
+
+		float sumTop2 = 0.0f;
+		for (uint32_t i = idx98; i < numBins; ++i)
+			sumTop2 += static_cast<float>(histogram[i]);
+
+		float sum90To98 = 0.0f;
+		for (uint32_t i = idx90; i < idx98 && i < numBins; ++i)
+			sum90To98 += static_cast<float>(histogram[i]);
+
+		float sumMid = 0.0f;
+		for (uint32_t i = idx8; i < idx90 && i < numBins; ++i)
+			sumMid += static_cast<float>(histogram[i]);
+
+		float sumHigh = sumTop2 + sum90To98;
+		float total = sumLow + sumHigh + sumMid;
+
+		if (total > 0.0f) {
+			float ratioExtremes = (sumHigh + sumLow) * 100.0f / total;
+			float ratioTop2 = sumTop2 * 100.0f / total;
+			info_.histSceneFlag = (ratioExtremes > 60.0f || ratioTop2 > 5.0f) ? 1 : 0;
+		} else {
+			info_.histSceneFlag = 0;
+		}
+	}
+
+	int detectMotion(const float *currBgGr, int width, int height,
+			 float curGain, float slRatio, float iqmSceneProb)
+	{
+		if (!currBgGr || width <= 0 || height <= 0)
+			return 0;
+
+		if (!info_.isInitialized) {
+			size_t total = static_cast<size_t>(width * height);
+			std::copy_n(currBgGr, std::min(total, info_.prevBgGr.size()), info_.prevBgGr.begin());
+			info_.isInitialized = 1;
+			info_.motionFlag = 0;
+			return 0;
+		}
+
+		info_.motionFlag = 0;
+
+		int currBlockTh = 10;
+		int prevBlockTh = 10;
+		float madTh = 9.0f;
+
+		if (curGain >= 20.0f) {
+			currBlockTh = 10;
+			prevBlockTh = 10;
+			madTh = info_.textureThreshold * 3.0f;
+		} else {
+			if (slRatio > 1.0f || info_.histSceneFlag == 1) {
+				currBlockTh = static_cast<int>(static_cast<float>(info_.blockThreshold) * 1.5f);
+				prevBlockTh = static_cast<int>(static_cast<float>(info_.blockThreshold) * 1.5f);
+			} else {
+				currBlockTh = info_.blockThreshold;
+				prevBlockTh = info_.blockThreshold;
+			}
+			madTh = info_.textureThreshold;
+		}
+
+		int halfBlock = info_.blockSize / 2;
+		int margin = halfBlock + info_.searchRadius;
+		int motionBlocks = 0;
+
+		if (info_.blockSize == 3 && info_.searchRadius == 3) {
+			const float *prevBgGr = info_.prevBgGr.data();
+
+			for (int y = margin; y < height - margin; y += 3) {
+				const float *currRow0 = &currBgGr[(y - 1) * width];
+				const float *currRow1 = &currBgGr[y * width];
+				const float *currRow2 = &currBgGr[(y + 1) * width];
+
+				for (int x = margin; x < width - margin; x += 3) {
+					float c00 = currRow0[x - 1], c01 = currRow0[x], c02 = currRow0[x + 1];
+					float c10 = currRow1[x - 1], c11 = currRow1[x], c12 = currRow1[x + 1];
+					float c20 = currRow2[x - 1], c21 = currRow2[x], c22 = currRow2[x + 1];
+
+					float sum = c00 + c01 + c02 + c10 + c11 + c12 + c20 + c21 + c22;
+					float mean = sum / 9.0f;
+
+					float madSum = std::abs(c00 - mean) + std::abs(c01 - mean) + std::abs(c02 - mean) +
+					               std::abs(c10 - mean) + std::abs(c11 - mean) + std::abs(c12 - mean) +
+					               std::abs(c20 - mean) + std::abs(c21 - mean) + std::abs(c22 - mean);
+					float mad = madSum / 9.0f;
+
+					if (mad <= madTh)
+						continue;
+
+					float minSad = 1e9f;
+					int bestDx = 0;
+					int bestDy = 0;
+
+					for (int sdy = -3; sdy <= 3; ++sdy) {
+						const float *pRow0 = &prevBgGr[(y + sdy - 1) * width];
+						const float *pRow1 = &prevBgGr[(y + sdy) * width];
+						const float *pRow2 = &prevBgGr[(y + sdy + 1) * width];
+
+						for (int sdx = -3; sdx <= 3; ++sdx) {
+							int px = x + sdx;
+							float sad = std::abs(c00 - pRow0[px - 1]) + std::abs(c01 - pRow0[px]) + std::abs(c02 - pRow0[px + 1]) +
+							            std::abs(c10 - pRow1[px - 1]) + std::abs(c11 - pRow1[px]) + std::abs(c12 - pRow1[px + 1]) +
+							            std::abs(c20 - pRow2[px - 1]) + std::abs(c21 - pRow2[px]) + std::abs(c22 - pRow2[px + 1]);
+
+							if (sad < minSad) {
+								minSad = sad;
+								bestDx = sdx;
+								bestDy = sdy;
+							}
+						}
+					}
+
+					if (std::abs(bestDx) >= info_.motionThreshold || std::abs(bestDy) >= info_.motionThreshold)
+						motionBlocks++;
+				}
+			}
+		} else {
+			for (int y = margin; y < height - margin; y += info_.blockSize) {
+				for (int x = margin; x < width - margin; x += info_.blockSize) {
+					float sum = 0.0f;
+					for (int dy = -1; dy <= 1; ++dy) {
+						for (int dx = -1; dx <= 1; ++dx) {
+							sum += currBgGr[(y + dy) * width + (x + dx)];
+						}
+					}
+					float mean = sum / 9.0f;
+
+					float madSum = 0.0f;
+					for (int dy = -1; dy <= 1; ++dy) {
+						for (int dx = -1; dx <= 1; ++dx) {
+							madSum += std::abs(currBgGr[(y + dy) * width + (x + dx)] - mean);
+						}
+					}
+					float mad = madSum / 9.0f;
+
+					if (mad <= madTh)
+						continue;
+
+					float minSad = 1e9f;
+					int bestDx = 0;
+					int bestDy = 0;
+
+					for (int sdy = -info_.searchRadius; sdy <= info_.searchRadius; ++sdy) {
+						for (int sdx = -info_.searchRadius; sdx <= info_.searchRadius; ++sdx) {
+							float sad = 0.0f;
+							for (int by = -1; by <= 1; ++by) {
+								for (int bx = -1; bx <= 1; ++bx) {
+									float currP = currBgGr[(y + by) * width + (x + bx)];
+									float prevP = info_.prevBgGr[(y + sdy + by) * width + (x + sdx + bx)];
+									sad += std::abs(currP - prevP);
+								}
+							}
+							if (sad < minSad) {
+								minSad = sad;
+								bestDx = sdx;
+								bestDy = sdy;
+							}
+						}
+					}
+
+					if (std::abs(bestDx) >= info_.motionThreshold || std::abs(bestDy) >= info_.motionThreshold)
+						motionBlocks++;
+				}
+			}
+		}
+
+		info_.prevMotionBlocks = info_.currMotionBlocks;
+		info_.currMotionBlocks = motionBlocks;
+
+		if (info_.currMotionBlocks >= currBlockTh && info_.prevMotionBlocks >= prevBlockTh) {
+			if (iqmSceneProb < 0.699999988079071f)
+				info_.motionFlag = 1;
+			else
+				info_.motionFlag = 0;
+		} else {
+			info_.motionFlag = 0;
+		}
+
+		return info_.motionFlag;
+	}
+
+	int updateMotionInfo(const float *currBgGr, int width, int height, int motionDetected)
+	{
+		if (motionDetected != 0) {
+			info_.holdCount = 3;
+			info_.lastMotionFlag = motionDetected;
+			info_.motionFlag = motionDetected;
+		} else {
+			if (info_.holdCount > 0) {
+				info_.motionFlag = info_.lastMotionFlag;
+				info_.holdCount--;
+			} else {
+				info_.motionFlag = 0;
+				info_.lastMotionFlag = 0;
+			}
+		}
+
+		if (currBgGr && width > 0 && height > 0) {
+			size_t total = static_cast<size_t>(width * height);
+			std::copy_n(currBgGr, std::min(total, info_.prevBgGr.size()), info_.prevBgGr.begin());
+		}
+
+		return info_.motionFlag;
+	}
+
+	int processMotionDetection(uint64_t frameSeq, uint32_t validStats, uint32_t totalStats,
+				   float curGain, float slRatio, float iqmSceneProb,
+				   const float *currBgGr, int width, int height,
+				   const uint32_t *histogram, size_t numBins)
+	{
+		if (frameSeq < static_cast<uint64_t>(info_.startFrame))
+			return 0;
+
+		analyzeScene(histogram, numBins);
+
+		if (totalStats == 0) {
+			info_.motionFlag = 0;
+			info_.holdCount = 0;
+			info_.isInitialized = 0;
+			info_.motionFlagForExposure = 0;
+			return 0;
+		}
+
+		float statRatio = static_cast<float>(validStats) / static_cast<float>(totalStats);
+		if (statRatio <= 0.9399999976158142f || curGain >= 24.0f) {
+			info_.motionFlag = 0;
+			info_.holdCount = 0;
+			info_.isInitialized = 0;
+			info_.motionFlagForExposure = 0;
+			return 0;
+		}
+
+		int detected = detectMotion(currBgGr, width, height, curGain, slRatio, iqmSceneProb);
+		int flag = updateMotionInfo(currBgGr, width, height, detected);
+		info_.motionFlagForExposure = (flag != 0) ? 1 : 0;
+		return flag;
+	}
+
+	static bool adjustExposureMotion(uint64_t &expTimeNs, float &gain, int frequency = 2)
+	{
+		uint64_t q = expTimeNs / 10ULL;
+		float factor = 1.0f;
+		bool adjust = false;
+
+		if (frequency == 2) {
+			if (q > 10000000ULL || gain > 24.0f)
+				return false;
+
+			switch (q) {
+			case 10000000ULL: factor = 2.0f; adjust = true; break;
+			case 9166667ULL:  factor = 1.8200000524520874f; adjust = true; break;
+			case 8333333ULL:  factor = 2.0f; adjust = true; break;
+			case 7500000ULL:  factor = 1.7999999523162842f; adjust = true; break;
+			case 6666667ULL:  factor = 2.0f; adjust = true; break;
+			case 5833333ULL:  factor = 1.75f; adjust = true; break;
+			case 5000000ULL:  factor = 2.0f; adjust = true; break;
+			case 4166666ULL:  factor = 2.5f; adjust = true; break;
+			case 3333333ULL:  factor = 2.0f; adjust = true; break;
+			case 2500000ULL:  factor = 1.5f; adjust = true; break;
+			case 1666666ULL:  factor = 2.0f; adjust = true; break;
+			default: break;
+			}
+		}
+
+		if (!adjust) {
+			if (q >= 100000ULL && q <= 416666ULL) {
+				factor = 2.0f;
+				adjust = true;
+			}
+		}
+
+		if (adjust) {
+			float adjustedTime = static_cast<float>(expTimeNs) / factor;
+			expTimeNs = static_cast<uint64_t>(adjustedTime);
+			gain = gain * factor;
+			return true;
+		}
+
+		return false;
+	}
+
+private:
+	LgMotionInfo info_;
+};
+
+inline bool isMotionApplicable(int sensorType, int mode)
+{
+	return sensorType == 17 && (mode == 2 || mode == 12);
+}
+
+template <typename SizeType>
+inline bool isMotionApplicable(const std::string &sensorModel, const SizeType &inputSize, const SizeType &nativeInputSize)
+{
+	return sensorModel == "imx363" && inputSize == nativeInputSize;
+}
+
+enum class MotionGainModel {
+	Linear32,
+	SonyInverse512,
+	SonyInverse1024
+};
+
+inline double quantizeGain(MotionGainModel model, double gain)
+{
+	if (gain <= 1.0)
+		return 1.0;
+
+	if (model == MotionGainModel::Linear32) {
+		int32_t code = std::max(0, static_cast<int32_t>(std::lround(gain * 32.0)));
+		return code / 32.0;
+	}
+	if (model == MotionGainModel::SonyInverse512) {
+		int32_t code = std::clamp(static_cast<int32_t>(std::lround(512.0 - 512.0 / gain)), 0, 511);
+		if (code >= 511)
+			return 512.0;
+		return 512.0 / (512.0 - code);
+	}
+	int32_t code = std::clamp(static_cast<int32_t>(std::lround(1024.0 - 1024.0 / gain)), 0, 1023);
+	if (code >= 1023)
+		return 1024.0;
+	return 1024.0 / (1024.0 - code);
+}
+
+struct MotionExposureAdjustment {
+	bool adjusted = false;
+	uint64_t allocatedExposureNs = 0;
+	double allocatedGain = 1.0;
+	int32_t expLines = 0;
+	double targetEnergy = 0.0;
+	double actualEnergy = 0.0;
+	double energyRatio = 1.0;
+};
+
+inline MotionExposureAdjustment computeMotionExposureAllocation(
+	uint64_t initialExposureNs, double initialGain,
+	double gainMin, double gainMax,
+	int32_t exposureMinLines, int32_t exposureMaxLines,
+	double lineDurationNs, int frequency, MotionGainModel gainModel)
+{
+	MotionExposureAdjustment out;
+	out.allocatedExposureNs = initialExposureNs;
+	out.allocatedGain = initialGain;
+	out.targetEnergy = static_cast<double>(initialExposureNs) * initialGain;
+	out.actualEnergy = out.targetEnergy;
+	out.expLines = static_cast<int32_t>(std::lround(static_cast<double>(initialExposureNs) / lineDurationNs));
+
+	uint64_t adjExp = initialExposureNs;
+	float adjGain = static_cast<float>(initialGain);
+	if (!LgAeMotion::adjustExposureMotion(adjExp, adjGain, frequency))
+		return out;
+
+	if (initialGain >= gainMax)
+		return out;
+
+	double energy = static_cast<double>(initialExposureNs) * initialGain;
+	double targetExp = static_cast<double>(adjExp);
+	double minExpForGainMax = energy / gainMax;
+	if (targetExp < minExpForGainMax)
+		targetExp = minExpForGainMax;
+
+	double exposureMinNs = static_cast<double>(exposureMinLines) * lineDurationNs;
+	double exposureMaxNs = static_cast<double>(exposureMaxLines) * lineDurationNs;
+	targetExp = std::clamp(targetExp, exposureMinNs, exposureMaxNs);
+
+	int32_t expLines = std::clamp(
+		static_cast<int32_t>(std::lround(targetExp / lineDurationNs)),
+		exposureMinLines, exposureMaxLines);
+	double finalExpNs = static_cast<double>(expLines) * lineDurationNs;
+
+	double reqGain = std::clamp(energy / finalExpNs, gainMin, gainMax);
+	double finalGain = quantizeGain(gainModel, reqGain);
+
+	out.adjusted = true;
+	out.allocatedExposureNs = static_cast<uint64_t>(finalExpNs);
+	out.allocatedGain = finalGain;
+	out.expLines = expLines;
+	out.actualEnergy = finalExpNs * finalGain;
+	out.energyRatio = (out.targetEnergy > 0.0) ? (out.actualEnergy / out.targetEnergy) : 1.0;
+	return out;
+}
+
+} /* namespace libcamera::qcom */
