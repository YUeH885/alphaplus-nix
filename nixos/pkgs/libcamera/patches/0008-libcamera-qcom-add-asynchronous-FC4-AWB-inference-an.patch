diff --git a/src/libcamera/pipeline/qcom/fc4_engine.cpp b/src/libcamera/pipeline/qcom/fc4_engine.cpp
new file mode 100644
index 0000000..929ec8b
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/fc4_engine.cpp
@@ -0,0 +1,446 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "fc4_engine.h"
+#include "fc4_postprocess.h"
+#include "fc4_state.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wshadow"
+#include <onnxruntime_cxx_api.h>
+#pragma GCC diagnostic pop
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+LOG_DECLARE_CATEGORY(QcomPipeline)
+}
+
+namespace libcamera::qcom {
+
+struct FC4Engine::Impl {
+	bool available_ = false;
+	bool running_{ false };
+	uint64_t activeGeneration_{ 1 };
+
+	std::unique_ptr<Ort::Env> env_;
+	std::unique_ptr<Ort::Session> fc4Session_;
+	std::array<std::unique_ptr<Ort::Session>, 3> classifierSessions_;
+	Ort::MemoryInfo memoryInfo_{ nullptr };
+
+	struct PendingResult {
+		uint64_t generation = 0;
+		std::string sensorName;
+		uint32_t statsSequence = 0;
+		uint64_t timestampNs = 0;
+		int finalClass = 0;
+		float finalWeight = 0.0f;
+		int sensorType = 17;
+		float estR = 0.0f;
+		float estB = 0.0f;
+		int topClass1 = 0;
+		float topConf1 = 0.0f;
+		float durationMs = 0.0f;
+		std::array<float, 4> classProbabilities{};
+		LgAwbWhiteBalanceCalibration calibration{};
+	};
+
+	std::thread workerThread_;
+	mutable std::mutex mutex_;
+	std::condition_variable cv_;
+	std::optional<FC4Snapshot> pendingSnapshot_;
+	std::optional<PendingResult> pendingResult_;
+	std::array<FC4IqmState, 3> sensorStates_{};
+	std::array<std::optional<FC4PostprocessOutput>, 3> lastPostOut_{};
+
+	explicit Impl(const std::string &modelDir)
+	{
+		for (auto &s : sensorStates_) {
+			s.reset();
+			s.state = FC4IqmState::State::Ready;
+		}
+		try {
+			env_ = std::make_unique<Ort::Env>(ORT_LOGGING_LEVEL_WARNING, "lg_awb_dnn");
+			Ort::SessionOptions opts;
+			opts.SetIntraOpNumThreads(4);
+
+			std::string fc4Path = modelDir + "/fc4_awb.onnx";
+			fc4Session_ = std::make_unique<Ort::Session>(*env_, fc4Path.c_str(), opts);
+
+			std::string clsPaths[3] = {
+				modelDir + "/wb_graph_imx351w.onnx",
+				modelDir + "/wb_graph_imx363.onnx",
+				modelDir + "/wb_graph_s5k3m5t.onnx"
+			};
+			for (size_t i = 0; i < 3; ++i) {
+				classifierSessions_[i] = std::make_unique<Ort::Session>(*env_, clsPaths[i].c_str(), opts);
+			}
+
+			memoryInfo_ = Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);
+			available_ = true;
+			running_ = true;
+			workerThread_ = std::thread(&Impl::workerLoop, this);
+			LOG(QcomPipeline, Info) << "FC4Engine initialized with models in " << modelDir;
+		} catch (const std::exception &e) {
+			LOG(QcomPipeline, Error) << "FC4Engine initialization failed: " << e.what();
+			available_ = false;
+		}
+	}
+
+	~Impl()
+	{
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			running_ = false;
+		}
+		cv_.notify_all();
+		if (workerThread_.joinable())
+			workerThread_.join();
+	}
+
+	void reset(uint64_t generation)
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		activeGeneration_ = generation;
+		pendingSnapshot_.reset();
+		pendingResult_.reset();
+		for (auto &s : sensorStates_) {
+			s.reset();
+			s.state = FC4IqmState::State::Ready;
+		}
+		for (auto &c : lastPostOut_)
+			c.reset();
+	}
+
+	bool submitSnapshot(const FC4Snapshot &snapshot)
+	{
+		if (!available_)
+			return false;
+
+		size_t stateIdx = 1;
+		if (snapshot.sensorName == "imx351")
+			stateIdx = 0;
+		else if (snapshot.sensorName == "s5k3m5")
+			stateIdx = 2;
+
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (!running_ || snapshot.generation != activeGeneration_)
+				return false;
+
+			if (pendingSnapshot_.has_value())
+				return false;
+
+			auto &sState = sensorStates_[stateIdx];
+			if (!sState.initialized) {
+				sState.reset();
+				sState.state = FC4IqmState::State::Ready;
+			}
+
+			if (!sState.canProcessInput(snapshot.timestampNs, snapshot.stableCount,
+						    snapshot.currentLuma, snapshot.targetLuma))
+				return false;
+
+			sState.submitInput(snapshot.timestampNs, snapshot.stableCount);
+			pendingSnapshot_ = snapshot;
+		}
+		cv_.notify_one();
+		return true;
+	}
+
+	bool hasResult(const std::string &sensorName, uint64_t currentGeneration) const
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		return pendingResult_.has_value() &&
+		       pendingResult_->generation == currentGeneration &&
+		       pendingResult_->sensorName == sensorName;
+	}
+
+	std::optional<FC4Result> popResult(const std::string &sensorName, uint64_t currentGeneration)
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (!pendingResult_)
+			return std::nullopt;
+		if (pendingResult_->generation != currentGeneration || pendingResult_->sensorName != sensorName)
+			return std::nullopt;
+
+		size_t stateIdx = 1;
+		if (sensorName == "imx351")
+			stateIdx = 0;
+		else if (sensorName == "s5k3m5")
+			stateIdx = 2;
+
+		auto &sState = sensorStates_[stateIdx];
+		if (!sState.getOutput(pendingResult_->finalClass, pendingResult_->finalWeight, pendingResult_->sensorType))
+			return std::nullopt;
+
+		auto calibRefs = resolveCalibRefs(pendingResult_->calibration, pendingResult_->sensorType);
+
+		FC4Result result;
+		result.generation = pendingResult_->generation;
+		result.sensorName = pendingResult_->sensorName;
+		result.statsSequence = pendingResult_->statsSequence;
+		result.timestampNs = pendingResult_->timestampNs;
+		result.iqmTuple = sState.getIqmTuple(goldenImx363, calibRefs);
+		result.classProbabilities = pendingResult_->classProbabilities;
+		result.metadata = sState.extractMetadata(goldenImx363, calibRefs);
+		result.filteredOutdoorProb = sState.historySlots[4];
+		result.estR = pendingResult_->estR;
+		result.estB = pendingResult_->estB;
+		result.topClass1 = pendingResult_->topClass1;
+		result.topConf1 = pendingResult_->topConf1;
+		result.finalClass = pendingResult_->finalClass;
+		result.durationMs = pendingResult_->durationMs;
+
+		pendingResult_.reset();
+		return result;
+	}
+
+	void workerLoop()
+	{
+		while (true) {
+			FC4Snapshot snapshot;
+			bool skipFc4 = false;
+			std::optional<FC4PostprocessOutput> cachedPost;
+			size_t stateIdx = 1;
+			{
+				std::unique_lock<std::mutex> lock(mutex_);
+				cv_.wait(lock, [this]() { return !running_ || pendingSnapshot_.has_value(); });
+				if (!running_)
+					break;
+				snapshot = *pendingSnapshot_;
+				pendingSnapshot_.reset();
+				if (snapshot.generation != activeGeneration_)
+					continue;
+
+				if (snapshot.sensorName == "imx351")
+					stateIdx = 0;
+				else if (snapshot.sensorName == "s5k3m5")
+					stateIdx = 2;
+
+				auto &sState = sensorStates_[stateIdx];
+				sState.state = FC4IqmState::State::Processing;
+
+				if (snapshot.stableCount > 30 && lastPostOut_[stateIdx].has_value()) {
+					skipFc4 = true;
+					cachedPost = lastPostOut_[stateIdx];
+				}
+			}
+			runInferenceAndCorrection(snapshot, skipFc4, cachedPost, stateIdx);
+		}
+	}
+
+	void runInferenceAndCorrection(const FC4Snapshot &snapshot, bool skipFc4,
+				       const std::optional<FC4PostprocessOutput> &cachedPost, size_t stateIdx)
+	{
+		auto t0 = std::chrono::high_resolution_clock::now();
+		int sensorType = 17;
+		if (snapshot.sensorName == "imx351")
+			sensorType = 16;
+		else if (snapshot.sensorName == "s5k3m5")
+			sensorType = 18;
+
+		auto goldenRefs = getGoldenRefs(sensorType);
+		auto calibRefs = resolveCalibRefs(snapshot.calibration, sensorType);
+		constexpr float HIGH_LUMA = 0.8834999799728394f;
+
+		// 1. Preprocess and run classifier model (sensor golden domain)
+		std::vector<float> cls_data(3072 * 3, 0.0f);
+		for (size_t i = 0; i < 3072; ++i) {
+			float r_norm = snapshot.bgRgb[i][0] / 255.0f;
+			float g_norm = snapshot.bgRgb[i][1] / 255.0f;
+			float b_norm = snapshot.bgRgb[i][2] / 255.0f;
+			if (g_norm > 0.0f) {
+				float r_ratio = r_norm / g_norm;
+				float b_ratio = b_norm / g_norm;
+				float scale_r = 1.0f, scale_b = 1.0f;
+				calRbRatio(r_ratio, b_ratio, goldenRefs, calibRefs, scale_r, scale_b);
+				float r_scaled = r_norm * scale_r;
+				float b_scaled = b_norm * scale_b;
+				if (r_scaled > HIGH_LUMA || g_norm > HIGH_LUMA || b_scaled > HIGH_LUMA) {
+					cls_data[i * 3 + 0] = 0.0f;
+					cls_data[i * 3 + 1] = 0.0f;
+					cls_data[i * 3 + 2] = 0.0f;
+				} else {
+					cls_data[i * 3 + 0] = std::clamp(r_scaled, 0.0f, 1.0f);
+					cls_data[i * 3 + 1] = std::clamp(g_norm, 0.0f, 1.0f);
+					cls_data[i * 3 + 2] = std::clamp(b_scaled, 0.0f, 1.0f);
+				}
+			}
+		}
+
+		std::vector<int64_t> cls_shape = { 1, 3072, 3 };
+		Ort::Value cls_tensor = Ort::Value::CreateTensor<float>(
+			memoryInfo_, cls_data.data(), cls_data.size(), cls_shape.data(), cls_shape.size());
+		const char *cls_in_names[] = { "input/rgb_stat:0" };
+		const char *cls_out_names[] = { "probabilities" };
+		auto cls_out = classifierSessions_[stateIdx]->Run(
+			Ort::RunOptions{ nullptr }, cls_in_names, &cls_tensor, 1, cls_out_names, 1);
+		float *probs = cls_out[0].GetTensorMutableData<float>();
+
+		for (int i = 0; i < 4; ++i) {
+			if (!std::isfinite(probs[i])) {
+				std::lock_guard<std::mutex> lock(mutex_);
+				if (running_ && snapshot.generation == activeGeneration_)
+					sensorStates_[stateIdx].state = FC4IqmState::State::Ready;
+				return;
+			}
+		}
+
+		FC4PostprocessOutput postOut;
+		if (skipFc4 && cachedPost.has_value()) {
+			postOut = *cachedPost;
+		} else {
+			// 2. Preprocess and run FC4 model (IMX363 golden domain)
+			std::vector<float> fc4_data(1 * 48 * 64 * 3, 0.0f);
+			for (size_t i = 0; i < 3072; ++i) {
+				float r_norm = snapshot.bgRgb[i][0] / 255.0f;
+				float g_norm = snapshot.bgRgb[i][1] / 255.0f;
+				float b_norm = snapshot.bgRgb[i][2] / 255.0f;
+				if (g_norm > 0.0f) {
+					float r_ratio = r_norm / g_norm;
+					float b_ratio = b_norm / g_norm;
+					float scale_r = 1.0f, scale_b = 1.0f;
+					calRbRatio(r_ratio, b_ratio, goldenImx363, calibRefs, scale_r, scale_b);
+					float r_scaled = r_norm * scale_r;
+					float b_scaled = b_norm * scale_b;
+					if (r_scaled > HIGH_LUMA || g_norm > HIGH_LUMA || b_scaled > HIGH_LUMA) {
+						fc4_data[i * 3 + 0] = 0.0f;
+						fc4_data[i * 3 + 1] = 0.0f;
+						fc4_data[i * 3 + 2] = 0.0f;
+					} else {
+						fc4_data[i * 3 + 0] = std::clamp(r_scaled, 0.0f, 1.0f);
+						fc4_data[i * 3 + 1] = std::clamp(g_norm, 0.0f, 1.0f);
+						fc4_data[i * 3 + 2] = std::clamp(b_scaled, 0.0f, 1.0f);
+					}
+				}
+			}
+
+			std::vector<int64_t> fc4_shape = { 1, 48, 64, 3 };
+			Ort::Value fc4_tensor = Ort::Value::CreateTensor<float>(
+				memoryInfo_, fc4_data.data(), fc4_data.size(), fc4_shape.data(), fc4_shape.size());
+			const char *fc4_in_names[] = { "X:0" };
+			const char *fc4_out_names[] = { "to1dim/concat_rgb_classes:0" };
+			auto fc4_out = fc4Session_->Run(
+				Ort::RunOptions{ nullptr }, fc4_in_names, &fc4_tensor, 1, fc4_out_names, 1);
+			float *raw_7 = fc4_out[0].GetTensorMutableData<float>();
+
+			for (int i = 0; i < 7; ++i) {
+				if (!std::isfinite(raw_7[i])) {
+					std::lock_guard<std::mutex> lock(mutex_);
+					if (running_ && snapshot.generation == activeGeneration_)
+						sensorStates_[stateIdx].state = FC4IqmState::State::Ready;
+					return;
+				}
+			}
+			if (raw_7[1] <= 1e-6f || raw_7[0] <= 0.0f || raw_7[2] <= 0.0f) {
+				std::lock_guard<std::mutex> lock(mutex_);
+				if (running_ && snapshot.generation == activeGeneration_)
+					sensorStates_[stateIdx].state = FC4IqmState::State::Ready;
+				return;
+			}
+
+			postOut = fc4Postprocess(
+				fc4_data.data(), raw_7, sensorType, snapshot.luxIndex);
+		}
+
+		// 3. Assemble 7 slots in golden domain for AEC history state transition:
+		float golden_gain_r = postOut.corrR > 1e-6f ? 1.0f / postOut.corrR : 1.0f;
+		float golden_gain_b = postOut.corrB > 1e-6f ? 1.0f / postOut.corrB : 1.0f;
+		std::array<float, 7> new_slots = {
+			golden_gain_r,
+			1.0f,
+			golden_gain_b,
+			0.0f,
+			probs[1],
+			probs[2],
+			probs[3]
+		};
+
+		auto t1 = std::chrono::high_resolution_clock::now();
+		double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();
+
+		// Short critical section: verify generation and update history atomically
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (!running_ || snapshot.generation != activeGeneration_)
+				return;
+
+			auto &sState = sensorStates_[stateIdx];
+			if (!sState.initialized)
+				sState.reset();
+
+			if (!skipFc4)
+				lastPostOut_[stateIdx] = postOut;
+
+			sState.submitInference(new_slots);
+
+			PendingResult pending;
+			pending.generation = snapshot.generation;
+			pending.sensorName = snapshot.sensorName;
+			pending.statsSequence = snapshot.statsSequence;
+			pending.timestampNs = snapshot.timestampNs;
+			pending.finalClass = postOut.finalClass;
+			pending.finalWeight = postOut.finalWeight;
+			pending.sensorType = sensorType;
+			pending.estR = postOut.fc4EstR;
+			pending.estB = postOut.fc4EstB;
+			pending.topClass1 = postOut.topClass1;
+			pending.topConf1 = postOut.topConf1;
+			pending.durationMs = static_cast<float>(ms);
+			pending.classProbabilities = { probs[0], probs[1], probs[2], probs[3] };
+			pending.calibration = snapshot.calibration;
+
+			pendingResult_ = pending;
+		}
+	}
+};
+
+FC4Engine::FC4Engine(const std::string &modelDir)
+	: impl_(std::make_unique<Impl>(modelDir))
+{
+}
+
+FC4Engine::~FC4Engine() = default;
+
+bool FC4Engine::isAvailable() const
+{
+	return impl_ && impl_->available_;
+}
+
+void FC4Engine::reset(uint64_t generation)
+{
+	if (impl_)
+		impl_->reset(generation);
+}
+
+bool FC4Engine::submitSnapshot(const FC4Snapshot &snapshot)
+{
+	if (impl_)
+		return impl_->submitSnapshot(snapshot);
+	return false;
+}
+
+bool FC4Engine::hasResult(const std::string &sensorName, uint64_t currentGeneration) const
+{
+	if (!impl_)
+		return false;
+	return impl_->hasResult(sensorName, currentGeneration);
+}
+
+std::optional<FC4Result> FC4Engine::popResult(const std::string &sensorName, uint64_t currentGeneration)
+{
+	if (!impl_)
+		return std::nullopt;
+	return impl_->popResult(sensorName, currentGeneration);
+}
+
+} /* namespace libcamera::qcom */
