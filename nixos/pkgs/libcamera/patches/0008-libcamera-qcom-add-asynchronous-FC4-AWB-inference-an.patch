+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "lg_awb_colour.h"
+
+namespace libcamera::qcom {
+
+struct FC4Snapshot {
+	uint64_t generation = 0;
+	std::string sensorName;
+	uint32_t statsSequence = 0;
+	uint64_t timestampNs = 0;
+	float luxIndex = 0.0f;
+	uint32_t stableCount = 0;
+	float currentLuma = 0.0f;
+	float targetLuma = 0.0f;
+	std::array<std::array<float, 3>, 3072> bgRgb{};
+	LgAwbWhiteBalanceCalibration calibration{};
+};
+
+struct FC4Result {
+	uint64_t generation = 0;
+	std::string sensorName;
+	uint32_t statsSequence = 0;
+	uint64_t timestampNs = 0;
+	std::array<float, 4> iqmTuple{};
+	std::array<float, 4> classProbabilities{};
+	std::array<float, 6> metadata{};
+	float filteredOutdoorProb = 0.0f;
+	float estR = 0.0f;
+	float estB = 0.0f;
+	int topClass1 = 0;
+	float topConf1 = 0.0f;
+	int finalClass = 0;
+	float durationMs = 0.0f;
+};
+
+class FC4Engine
+{
+public:
+	explicit FC4Engine(const std::string &modelDir = "/etc/camera/iqm");
+	~FC4Engine();
+
+	bool isAvailable() const;
+	void reset(uint64_t generation);
+	bool submitSnapshot(const FC4Snapshot &snapshot);
+	bool hasResult(const std::string &sensorName, uint64_t currentGeneration) const;
+	std::optional<FC4Result> popResult(const std::string &sensorName, uint64_t currentGeneration);
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> impl_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/fc4_postprocess.h b/src/libcamera/pipeline/qcom/fc4_postprocess.h
new file mode 100644
index 0000000..7104a77
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/fc4_postprocess.h
@@ -0,0 +1,446 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "fc4_state.h"
+#include "fc4_tuning_tables.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace libcamera::qcom {
+
+inline void findNearestPLocusPt(float r, float b, float &best_r, float &best_b, float &min_dist)
+{
+	float min_sparse_dist = 1e9f;
+	size_t best_sparse_idx = 0;
+	for (size_t i = 0; i < fc4SparseLocus.size(); ++i) {
+		float dr = r - fc4SparseLocus[i][0];
+		float db = b - fc4SparseLocus[i][1];
+		float d = std::sqrt(dr * dr + db * db);
+		if (d < min_sparse_dist) {
+			min_sparse_dist = d;
+			best_sparse_idx = i;
+		}
+	}
+
+	size_t start_fine = (best_sparse_idx == 0) ? fc4SparseIndices[0] : fc4SparseIndices[best_sparse_idx - 1];
+	size_t end_fine = (best_sparse_idx + 1 < fc4SparseIndices.size()) ?
+			  fc4SparseIndices[best_sparse_idx + 1] : fc4FineLocus.size();
+	if (start_fine > end_fine)
+		std::swap(start_fine, end_fine);
+
+	best_r = fc4FineLocus[start_fine][0];
+	best_b = fc4FineLocus[start_fine][1];
+	min_dist = 1e9f;
+	for (size_t i = start_fine; i < end_fine; ++i) {
+		float dr = r - fc4FineLocus[i][0];
+		float db = b - fc4FineLocus[i][1];
+		float d = std::sqrt(dr * dr + db * db);
+		if (d < min_dist) {
+			min_dist = d;
+			best_r = fc4FineLocus[i][0];
+			best_b = fc4FineLocus[i][1];
+		}
+	}
+}
+
+struct CellLookup {
+	uint8_t planckian[75 * 75]{};
+	uint8_t grass[75 * 75]{};
+	CellLookup()
+	{
+		for (const auto &c : fc4PlanckianCells) {
+			if (c[0] >= 0 && c[0] < 75 && c[1] >= 0 && c[1] < 75)
+				planckian[c[1] * 75 + c[0]] = 1;
+		}
+		for (const auto &c : fc4GrassCells) {
+			if (c[0] >= 0 && c[0] < 75 && c[1] >= 0 && c[1] < 75)
+				grass[c[1] * 75 + c[0]] = 1;
+		}
+	}
+};
+
+inline const CellLookup &getCellLookup()
+{
+	static CellLookup lookup;
+	return lookup;
+}
+
+struct FC4PostprocessOutput {
+	float fc4EstR = 0.0f;
+	float fc4EstB = 0.0f;
+	int topClass1 = 0;
+	float topConf1 = 0.0f;
+	int topClass2 = 0;
+	float topConf2 = 0.0f;
+	float baseR = 0.0f;
+	float baseB = 0.0f;
+	int sceneClass = 0;
+	bool isGrass = false;
+	float grassWeight = 0.0f;
+	float redRatio = 0.0f;
+	float yellowAccept = 0.0f;
+	int finalClass = 0;
+	float finalWeight = 0.0f;
+	float corrR = 0.0f;
+	float corrB = 0.0f;
+};
+
+inline FC4PostprocessOutput fc4Postprocess(
+	const float *inData,
+	const float *raw7,
+	int sensorType,
+	float luxIndex
+) {
+	(void)luxIndex;
+	FC4PostprocessOutput out;
+
+	if (raw7[1] > 1e-6f) {
+		out.fc4EstR = raw7[0] / raw7[1];
+		out.fc4EstB = raw7[2] / raw7[1];
+	} else {
+		out.fc4EstR = 1.0f;
+		out.fc4EstB = 1.0f;
+	}
+
+	// Softmax for class probabilities
+	float max_c = raw7[3];
+	for (int i = 4; i < 7; ++i)
+		max_c = std::max(max_c, raw7[i]);
+	float sum_exp = 0.0f;
+	float probs[4];
+	for (int i = 0; i < 4; ++i) {
+		probs[i] = std::exp(raw7[i + 3] - max_c);
+		sum_exp += probs[i];
+	}
+	for (int i = 0; i < 4; ++i)
+		probs[i] /= sum_exp;
+
+	// Top 2 classes
+	out.topClass1 = 0;
+	out.topConf1 = probs[0];
+	for (int i = 1; i < 4; ++i) {
+		if (probs[i] > out.topConf1) {
+			out.topConf1 = probs[i];
+			out.topClass1 = i;
+		}
+	}
+	out.topClass2 = -1;
+	out.topConf2 = -1.0f;
+	for (int i = 0; i < 4; ++i) {
+		if (i != out.topClass1 && probs[i] > out.topConf2) {
+			out.topConf2 = probs[i];
+			out.topClass2 = i;
+		}
+	}
+
+	// Simple Gray World base ratio
+	float sum_r = 0.0f, sum_g = 0.0f, sum_b = 0.0f;
+	uint32_t count_gw = 0;
+	for (size_t i = 0; i < 3072; ++i) {
+		float r = inData[i * 3], g = inData[i * 3 + 1], b = inData[i * 3 + 2];
+		if (g > 1e-6f) {
+			sum_r += r; sum_g += g; sum_b += b;
+			count_gw++;
+		}
+	}
+	if (count_gw > 0 && sum_g > 1e-6f) {
+		out.baseR = sum_r / sum_g;
+		out.baseB = sum_b / sum_g;
+	} else {
+		out.baseR = 0.6f;
+		out.baseB = 0.5f;
+	}
+
+	// 2D 75x75 Histogram
+	const auto &lookup = getCellLookup();
+	uint16_t hist[75][75]{};
+	uint8_t occupied[75][75]{};
+	uint32_t total_samples = 0, total_occupied_cells = 0;
+	uint32_t non_locus_occupied = 0, non_locus_samples = 0;
+	uint32_t locus_occupied_count = 0;
+
+	uint16_t max_hist_num = 0;
+	int max_pos_x = 0, max_pos_y = 0;
+
+	for (size_t i = 0; i < 3072; ++i) {
+		float r = inData[i * 3], g = inData[i * 3 + 1], b = inData[i * 3 + 2];
+		if (r < 0.949999988079071f && g < 0.949999988079071f && b < 0.949999988079071f && g > 1e-6f) {
+			float r_ratio = r / g, b_ratio = b / g;
+			int x = static_cast<int>(std::floor(100.0f * r_ratio / 2.0f + 0.5f)) - 1;
+			int y = static_cast<int>(std::floor(100.0f * b_ratio / 2.0f + 0.5f)) - 1;
+			if (x >= 0 && x < 75 && y >= 0 && y < 75) {
+				if (hist[y][x] == 0) {
+					occupied[y][x] = 1;
+					total_occupied_cells++;
+					if (lookup.planckian[y * 75 + x])
+						locus_occupied_count++;
+					else
+						non_locus_occupied++;
+				}
+				hist[y][x]++;
+				if (hist[y][x] > max_hist_num) {
+					max_hist_num = hist[y][x];
+					max_pos_x = x;
+					max_pos_y = y;
+				}
+				total_samples++;
+				if (!lookup.planckian[y * 75 + x])
+					non_locus_samples++;
+			}
+		}
+	}
+
+	float locus_coverage = total_occupied_cells > 0 ?
+		static_cast<float>(locus_occupied_count) / 476.0f : 0.0f;
+	float non_locus_occ_ratio = total_occupied_cells > 0 ?
+		static_cast<float>(non_locus_occupied) / static_cast<float>(total_occupied_cells) : 0.0f;
+	float non_locus_samp_ratio = total_samples > 0 ?
+		static_cast<float>(non_locus_samples) / static_cast<float>(total_samples) : 0.0f;
+
+	float single_color_score = 0.0f;
+	if (total_occupied_cells > 0) {
+		std::array<uint32_t, 75> bins_x{}, bins_y{};
+		for (size_t idx = 0; idx < 5625; ++idx) {
+			size_t y = idx / 75, x = idx % 75;
+			if (occupied[y][x]) {
+				uint16_t bx = fc4SlotsX[idx], by = fc4SlotsY[idx];
+				if (bx < 75) bins_x[bx]++;
+				if (by < 75) bins_y[by]++;
+			}
+		}
+		uint32_t max_3_x = 0, max_3_y = 0;
+		for (size_t i = 0; i <= 72; ++i) {
+			max_3_x = std::max(max_3_x, bins_x[i] + bins_x[i+1] + bins_x[i+2]);
+			max_3_y = std::max(max_3_y, bins_y[i] + bins_y[i+1] + bins_y[i+2]);
+		}
+		single_color_score = std::max(static_cast<float>(max_3_x) / static_cast<float>(total_occupied_cells),
+					      static_cast<float>(max_3_y) / static_cast<float>(total_occupied_cells));
+	}
+
+	// Scene classification decision
+	if (total_occupied_cells <= 25) {
+		out.sceneClass = 1;
+	} else if (total_occupied_cells <= 29) {
+		out.sceneClass = 4;
+	} else {
+		if (single_color_score <= 0.85f) {
+			out.sceneClass = (non_locus_samp_ratio >= 0.7f) ? 5 : 6;
+		} else {
+			if (locus_coverage > 0.2f)
+				out.sceneClass = 4;
+			else
+				out.sceneClass = (non_locus_occ_ratio < 0.001f) ? 1 : 3;
+		}
+	}
+
+	// Grass detection
+	float sum_weight = 0.0f, weighted_x = -1.0f, weighted_y = -1.0f;
+	uint32_t total_grass_samples = 0;
+	for (size_t y = 0; y < 75; ++y) {
+		for (size_t x = 0; x < 75; ++x) {
+			size_t idx = y * 75 + x;
+			uint16_t c = hist[y][x];
+			if (!lookup.planckian[idx] && fc4UpperLocusRegion[idx] != 0 && c > 0) {
+				sum_weight += c;
+				weighted_x += x * c;
+				weighted_y += y * c;
+			}
+			if (lookup.grass[idx])
+				total_grass_samples += c;
+		}
+	}
+	float sample_fraction = total_samples > 0 ?
+		static_cast<float>(total_grass_samples) / static_cast<float>(total_samples) : 0.0f;
+	if (sample_fraction <= 0.1f)
+		out.grassWeight = 0.0f;
+	else if (sample_fraction >= 0.2f)
+		out.grassWeight = 1.0f;
+	else
+		out.grassWeight = (sample_fraction - 0.1f) / 0.1f;
+
+	out.isGrass = false;
+	if (sum_weight > 0.0f) {
+		int cx = static_cast<int>(std::round(weighted_x / sum_weight));
+		int cy = static_cast<int>(std::round(weighted_y / sum_weight));
+		if (cx >= 0 && cx < 75 && cy >= 0 && cy < 75 && lookup.grass[cy * 75 + cx] && out.grassWeight > 0.1f)
+			out.isGrass = true;
+	}
+
+	// Locus projections
+	float base_lr, base_lb, base_dist;
+	findNearestPLocusPt(out.baseR, out.baseB, base_lr, base_lb, base_dist);
+
+	float est_lr, est_lb, est_dist;
+	findNearestPLocusPt(out.fc4EstR, out.fc4EstB, est_lr, est_lb, est_dist);
+
+	// Red / yellow stats
+	uint32_t red_num = 0, red_den = 0, yel_num = 0, yel_den = 0;
+	for (size_t i = 0; i < 3072; ++i) {
+		float r = inData[i * 3], g = inData[i * 3 + 1], b = inData[i * 3 + 2];
+		if (g > 1e-6f) {
+			float pr_r, pr_b, dist;
+			findNearestPLocusPt(r / g, b / g, pr_r, pr_b, dist);
+			if (pr_r > 0.0f) {
+				if (dist < 0.5f) {
+					red_den++;
+					if (pr_r > 0.7715169787406921f) red_num++;
+				}
+				if (dist < 0.1f) {
+					yel_den++;
+					if (pr_r < out.fc4EstR) yel_num++;
+				}
+			}
+		}
+	}
+	// Direct IEEE-754 division without clamp (preserving exact stock behavior)
+	out.redRatio = static_cast<float>(red_num) / static_cast<float>(red_den);
+	out.yellowAccept = static_cast<float>(yel_num) / static_cast<float>(yel_den);
+
+	out.corrR = out.fc4EstR;
+	out.corrB = out.fc4EstB;
+	out.finalClass = out.sceneClass;
+	out.finalWeight = 0.0f;
+	bool is_sensor_17 = (sensorType == 17);
+
+	// Exact stock comp_multiple_res branching
+	if ((out.sceneClass == 5 || out.sceneClass == 6) && out.isGrass && (est_lr < base_lr)) {
+		float scale = is_sensor_17 ? 0.4f : 0.25f;
+		float w = out.grassWeight * scale;
+		if (out.topClass1 == 0) {
+			w *= 0.4000000059604645f;
+			if (out.topClass2 == -1) w *= 0.4000000059604645f;
+		}
+		float min_w = is_sensor_17 ? 0.009999999776482582f : 0.07999999821186066f;
+		if (w >= min_w) {
+			out.finalClass = 7;
+			out.finalWeight = w;
+			out.corrR = out.baseR + (out.fc4EstR - out.baseR) * w + (is_sensor_17 ? 0.014999999664723873f : 0.019999999552965164f);
+			out.corrB = out.baseB + (out.fc4EstB - out.baseB) * w + (is_sensor_17 ? 0.014000000432133675f : 0.019999999552965164f);
+		} else {
+			out.finalClass = 8;
+			out.finalWeight = 0.0f;
+		}
+	} else if ((out.sceneClass == 5 || out.sceneClass == 6) &&
+		   (out.baseR > 0.49000000953674316f) &&
+		   (out.topClass1 == 2) &&
+		   (est_lr < base_lr)) {
+		float yel_thresh = is_sensor_17 ? 200.0f : 230.0f;
+		if (static_cast<float>(yel_den) > yel_thresh) {
+			uint32_t hist_sum_count = 0;
+			float hist_sum_x = 0.0f, hist_sum_y = 0.0f;
+			for (int dy = -1; dy <= 1; ++dy) {
+				for (int dx = -1; dx <= 1; ++dx) {
+					int px = max_pos_x + dx;
+					int py = max_pos_y + dy;
+					if (px >= 0 && px < 75 && py >= 0 && py < 75) {
+						uint16_t c = hist[py][px];
+						hist_sum_count += c;
+						hist_sum_x += static_cast<float>(c * px);
+						hist_sum_y += static_cast<float>(c * py);
+					}
+				}
+			}
+			float ave_x = hist_sum_count > 0 ? (hist_sum_x / static_cast<float>(hist_sum_count)) : static_cast<float>(max_pos_x);
+			float ave_y = hist_sum_count > 0 ? (hist_sum_y / static_cast<float>(hist_sum_count)) : static_cast<float>(max_pos_y);
+			float hist_center_r = ((ave_x + 1.0f) * 2.0f) / 100.0f;
+			float hist_center_b = ((ave_y + 1.0f) * 2.0f) / 100.0f;
+
+			uint32_t den = 0;
+			float sum_disp_r = 0.0f, sum_disp_g = 0.0f, sum_disp_b = 0.0f;
+			for (size_t i = 0; i < 3072; ++i) {
+				float r = inData[i * 3], g = inData[i * 3 + 1], b = inData[i * 3 + 2];
+				if (r > 0.001f && g > 0.001f && b > 0.001f) {
+					sum_disp_r += r; sum_disp_g += g; sum_disp_b += b;
+					den++;
+				}
+			}
+			float rgb_center_r = (den > 0 && sum_disp_g > 1e-6f) ? (sum_disp_r / sum_disp_g) : out.baseR;
+			float rgb_center_b = (den > 0 && sum_disp_g > 1e-6f) ? (sum_disp_b / sum_disp_g) : out.baseB;
+
+			uint32_t cnt_540 = 0, cnt_544 = 0, cnt_548 = 0;
+			for (size_t i = 0; i < 3072; ++i) {
+				float r = inData[i * 3], g = inData[i * 3 + 1], b = inData[i * 3 + 2];
+				if (r > 0.001f && g > 0.001f && b > 0.001f) {
+					float r_ratio = r / g, b_ratio = b / g;
+					float dr_mean = r_ratio - rgb_center_r;
+					float db_mean = b_ratio - rgb_center_b;
+					if (dr_mean * dr_mean + db_mean * db_mean < 0.02f * 0.02f) cnt_540++;
+
+					float dr_hist = r_ratio - hist_center_r;
+					float db_hist = b_ratio - hist_center_b;
+					float d_hist_sq = dr_hist * dr_hist + db_hist * db_hist;
+					if (d_hist_sq < 0.02f * 0.02f) cnt_544++;
+					if (d_hist_sq < 0.05f * 0.05f) cnt_548++;
+				}
+			}
+			float fden = den > 1 ? static_cast<float>(den) : 1.0f;
+			float std_val_540 = static_cast<float>(cnt_540) / fden;
+			float std_val_544 = static_cast<float>(cnt_544) / fden;
+			float std_val_548 = static_cast<float>(cnt_548) / fden;
+
+			float yel_ratio = out.yellowAccept;
+			float s9 = (yel_ratio <= 0.03f) ? std::max(0.0f, 1.0f - 33.333336f * yel_ratio) : 0.0f;
+			float dist_fc4 = std::sqrt((out.baseR - out.fc4EstR) * (out.baseR - out.fc4EstR) + (out.baseB - out.fc4EstB) * (out.baseB - out.fc4EstB));
+			float s11 = dist_fc4 >= 0.01f ? 1.0f : (dist_fc4 < 0.0f ? 0.0f : dist_fc4 * 100.0f);
+			float s12 = (std_val_544 <= 0.60f) ? std::max(0.0f, (0.60f - std_val_544) / 0.60f) : 0.0f;
+			float s13 = std::min(1.0f, std::max(0.0f, (std_val_548 - 0.30f) * 5.0f));
+			float ratio_std = std_val_544 > 1e-6f ? (std_val_540 / std_val_544) : 0.0f;
+			float s14 = std::min(1.0f, std::max(0.0f, (ratio_std - 0.30f) * 5.0f));
+			float s15 = (ratio_std <= 1.50f) ? 1.0f : ((ratio_std <= 2.20f) ? std::max(0.0f, (2.20f - ratio_std) / 0.70f) : 0.0f);
+			float accept_prob = s9 * s11 * s12 * s13 * s14 * s15;
+			if (accept_prob > 9.999999747378752e-05f) {
+				out.finalClass = 2;
+				float w = accept_prob * 0.4f * (is_sensor_17 ? 1.25f : 1.0499999523162842f);
+				out.finalWeight = w;
+				out.corrR = out.baseR + (out.fc4EstR - out.baseR) * w + (is_sensor_17 ? 0.004999999888241291f : 0.0099999776482582f);
+				out.corrB = out.baseB + (out.fc4EstB - out.baseB) * w + (is_sensor_17 ? 0.004999999888241291f : 0.006000000052154064f);
+			}
+		}
+	} else if (out.sceneClass == 5) {
+		if (est_lb < base_lb && base_lb > 0.6399999856948853f) {
+			out.finalClass = 6;
+			out.finalWeight = 0.0f;
+		} else {
+			float w_red = (out.redRatio <= 0.029999999329447746f) ?
+				1.0f + out.redRatio * (-33.333335876464844f) : 0.0f;
+			if (w_red > 0.10000000149011612f) {
+				out.finalWeight = w_red * 0.4f;
+				out.corrR = out.baseR + (out.fc4EstR - out.baseR) * out.finalWeight;
+				out.corrB = out.baseB + (out.fc4EstB - out.baseB) * out.finalWeight;
+				out.finalClass = 5;
+			} else {
+				out.corrR = out.baseR;
+				out.corrB = out.baseB;
+				out.finalClass = 6;
+				out.finalWeight = 0.0f;
+			}
+		}
+	}
+	// Note: In stock code, scene_cls == 3 and scene_cls == 4 do not blend in comp_multiple_res!
+	// final_cls remains scene_cls, final_w remains 0.0f, corr remains fc4_est.
+
+	// Low-CCT Clipping
+	if ((out.finalClass == 3 || out.finalClass == 4 || out.finalClass == 5) &&
+	    (est_lb < 0.42391061782836914f)) {
+		constexpr float low_b = 0.35769400000572205f;
+		constexpr float high_b = 0.42391061782836914f;
+		float w = (est_lb - low_b) / (high_b - low_b);
+		if (w < 0.01f) {
+			out.finalClass = 6;
+			out.finalWeight = 0.0f;
+		} else {
+			float new_conf = 0.4f * w;
+			out.corrR = out.baseR + new_conf * (out.corrR - out.baseR);
+			out.corrB = out.baseB + new_conf * (out.corrB - out.baseB);
+			out.finalClass = 5;
+			out.finalWeight = new_conf;
+		}
+	}
+
+	return out;
+}
+
+} /* namespace libcamera::qcom */
