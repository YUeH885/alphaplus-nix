+struct LgMotionInfo {
+	int32_t motionFlag = 0;            /* +64 */
+	int32_t lastMotionFlag = 0;        /* +68 */
+	int32_t holdCount = 0;             /* +72 */
+	int32_t histSceneFlag = 0;         /* +76 */
+	int32_t blockSize = 3;             /* +80 */
