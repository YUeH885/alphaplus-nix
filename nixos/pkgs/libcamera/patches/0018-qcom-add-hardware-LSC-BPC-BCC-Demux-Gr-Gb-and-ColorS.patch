+ColorSpace normalizePixColorSpace(const std::optional<ColorSpace> &requested)
+{
+	if (!requested)
+		return ColorSpace::Sycc;
+
+	static const ColorSpace kRec709Full{
+		ColorSpace::Primaries::Rec709,
+		ColorSpace::TransferFunction::Rec709,
+		ColorSpace::YcbcrEncoding::Rec709,
+		ColorSpace::Range::Full,
+	};
+	if (*requested == ColorSpace::Sycc ||
+	    *requested == ColorSpace::Rec709 ||
+	    *requested == ColorSpace::Smpte170m ||
+	    *requested == kRec709Full)
+		return *requested;
+
+	return ColorSpace::Sycc;
+}
