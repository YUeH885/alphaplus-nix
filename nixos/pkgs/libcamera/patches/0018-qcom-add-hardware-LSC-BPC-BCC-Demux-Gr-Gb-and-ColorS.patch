+void QcomCameraData::syncDemux()
+{
+	if (!hasDemux_ || !pix_ || !pix_->isOpen())
+		return;
+
+	const double sqrtRatio = std::sqrt(std::clamp(grGbRatio_, 0.85, 1.15));
+	qcom_camss_demux demux = {};
+	demux.gain_q10[0] = 1024;
+	demux.gain_q10[1] = static_cast<uint16_t>(std::clamp<long>(std::lround(1024.0 / sqrtRatio), 512, 2048));
+	demux.gain_q10[2] = static_cast<uint16_t>(std::clamp<long>(std::lround(1024.0 * sqrtRatio), 512, 2048));
+	demux.gain_q10[3] = 1024;
+
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+	control.id = V4L2_CID_QCOM_CAMSS_DEMUX;
+	control.size = sizeof(demux);
+	control.ptr = &demux;
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.controls = &control;
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret)
+		LOG(QcomPipeline, Warning) << "Failed to program Demux gains: " << ret;
+}
+
+void QcomCameraData::syncBpc()
+{
+	if (!hasBpc_ || !pix_ || !pix_->isOpen())
+		return;
+
+	qcom_camss_bpc bpc = {};
+	bpc.enable = QCOM_CAMSS_BPC_ENABLE_BPC | QCOM_CAMSS_BPC_ENABLE_BCC;
+	bpc.sat_value = 4095;
+	bpc.fmax = 80;
+	bpc.fmin = 48;
+	bpc.bcc_offset = 256;
+	bpc.offset_hot = 256;
+	bpc.offset_cold = 256;
+
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+	control.id = V4L2_CID_QCOM_CAMSS_BPC;
+	control.size = sizeof(bpc);
+	control.ptr = &bpc;
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.controls = &control;
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret)
