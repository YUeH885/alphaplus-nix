index 0000000..8ee02d0
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lsc_calibration.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include <libcamera/geometry.h>
+#include <libcamera/transform.h>
+
+#include "qcom_camss.h"
+
+namespace libcamera::qcom {
+
+struct LscEepromSpec {
+	uint32_t offset;
+	double cct;
+};
+
+struct LscTable {
+	double cct = 0.0;
+	/* Normalized gains (>= 1.0) in R, Gr, Gb, B order on a 17x13 mesh. */
+	std::array<std::array<float, QCOM_CAMSS_LSC_POINTS>, 4> gains{};
+};
+
+struct LscCalibration {
+	std::vector<LscTable> tables;
+};
+
+constexpr std::size_t kLscEepromPayloadBytes = 4 * QCOM_CAMSS_LSC_POINTS;
+constexpr std::size_t kLscEepromBlockBytes = kLscEepromPayloadBytes + 2;
+
+inline std::optional<LscTable>
+parseEepromLscBlock(const std::array<uint8_t, kLscEepromBlockBytes> &block,
+		    double cct)
+{
+	uint32_t sum = 0;
+	for (std::size_t i = 0; i < kLscEepromPayloadBytes; ++i)
+		sum += block[i];
+	uint16_t checksum = static_cast<uint16_t>(block[kLscEepromPayloadBytes]) |
+			    (static_cast<uint16_t>(block[kLscEepromPayloadBytes + 1]) << 8);
+	if (!sum || (sum & 0xffffU) != checksum)
+		return std::nullopt;
+
+	LscTable table;
+	table.cct = cct;
+	for (unsigned int ch = 0; ch < 4; ++ch) {
+		for (unsigned int i = 0; i < QCOM_CAMSS_LSC_POINTS; ++i) {
+			uint8_t val = block[ch * QCOM_CAMSS_LSC_POINTS + i];
+			if (!val)
+				return std::nullopt;
+			table.gains[ch][i] = 255.0f / static_cast<float>(val);
+		}
+	}
+	return table;
+}
+
+inline qcom_camss_lsc
+buildHardwareLsc(const LscCalibration &calibration, double cct,
+		 const Size &activeAreaSize, const Rectangle &analogCrop,
+		 Transform transform)
+{
+	qcom_camss_lsc out = {};
+	if (calibration.tables.empty())
+		return out;
+
+	/* Interpolate across sorted illuminant tables by active CCT. */
+	const LscTable *lo = &calibration.tables.front();
+	const LscTable *hi = &calibration.tables.back();
+	double alpha = 0.0;
+	if (calibration.tables.size() == 1 || cct <= lo->cct) {
+		hi = lo;
+	} else if (cct >= hi->cct) {
+		lo = hi;
+	} else {
+		for (std::size_t i = 0; i + 1 < calibration.tables.size(); ++i) {
+			if (cct <= calibration.tables[i + 1].cct) {
+				lo = &calibration.tables[i];
+				hi = &calibration.tables[i + 1];
+				double span = hi->cct - lo->cct;
+				alpha = span > 0.0 ? (cct - lo->cct) / span : 0.0;
+				break;
+			}
+		}
+	}
+
+	std::array<std::array<float, QCOM_CAMSS_LSC_POINTS>, 4> interp{};
+	for (unsigned int ch = 0; ch < 4; ++ch) {
+		for (unsigned int i = 0; i < QCOM_CAMSS_LSC_POINTS; ++i) {
+			interp[ch][i] = static_cast<float>(
+				lo->gains[ch][i] * (1.0 - alpha) +
+				hi->gains[ch][i] * alpha);
+		}
+	}
+
+	const double fullW = activeAreaSize.width ? static_cast<double>(activeAreaSize.width) : 1.0;
+	const double fullH = activeAreaSize.height ? static_cast<double>(activeAreaSize.height) : 1.0;
+	const bool validCrop = activeAreaSize.width > 0 && activeAreaSize.height > 0 &&
+			       analogCrop.width > 0 && analogCrop.height > 0;
+	const double cropX = validCrop ? static_cast<double>(analogCrop.x) : 0.0;
+	const double cropY = validCrop ? static_cast<double>(analogCrop.y) : 0.0;
+	const double cropW = validCrop ? static_cast<double>(analogCrop.width) : fullW;
+	const double cropH = validCrop ? static_cast<double>(analogCrop.height) : fullH;
+	const bool hflip = !!(transform & Transform::HFlip);
+	const bool vflip = !!(transform & Transform::VFlip);
+
+	auto sample = [&](unsigned int ch, double gx, double gy) -> uint16_t {
+		gx = std::clamp(gx, 0.0, static_cast<double>(QCOM_CAMSS_LSC_H_NUM - 1));
+		gy = std::clamp(gy, 0.0, static_cast<double>(QCOM_CAMSS_LSC_V_NUM - 1));
+		unsigned int x0 = static_cast<unsigned int>(std::floor(gx));
+		unsigned int y0 = static_cast<unsigned int>(std::floor(gy));
+		unsigned int x1 = std::min<unsigned int>(x0 + 1, QCOM_CAMSS_LSC_H_NUM - 1);
+		unsigned int y1 = std::min<unsigned int>(y0 + 1, QCOM_CAMSS_LSC_V_NUM - 1);
+		double fx = gx - x0;
+		double fy = gy - y0;
+		const auto &g = interp[ch];
+		double v00 = g[y0 * QCOM_CAMSS_LSC_H_NUM + x0];
+		double v10 = g[y0 * QCOM_CAMSS_LSC_H_NUM + x1];
+		double v01 = g[y1 * QCOM_CAMSS_LSC_H_NUM + x0];
+		double v11 = g[y1 * QCOM_CAMSS_LSC_H_NUM + x1];
+		double top = v00 * (1.0 - fx) + v10 * fx;
+		double bot = v01 * (1.0 - fx) + v11 * fx;
+		double gain = top * (1.0 - fy) + bot * fy;
+		return static_cast<uint16_t>(std::clamp<long>(std::lround(gain * 1024.0), 1024, 8191));
+	};
+
+	out.enable = 1;
+	for (unsigned int y = 0; y < QCOM_CAMSS_LSC_V_NUM; ++y) {
+		double ny = static_cast<double>(y) / (QCOM_CAMSS_LSC_V_NUM - 1);
+		if (vflip)
+			ny = 1.0 - ny;
+		double gy = ((cropY + ny * cropH) / fullH) * (QCOM_CAMSS_LSC_V_NUM - 1);
+
+		for (unsigned int x = 0; x < QCOM_CAMSS_LSC_H_NUM; ++x) {
+			double nx = static_cast<double>(x) / (QCOM_CAMSS_LSC_H_NUM - 1);
+			if (hflip)
+				nx = 1.0 - nx;
+			double gx = ((cropX + nx * cropW) / fullW) * (QCOM_CAMSS_LSC_H_NUM - 1);
+			unsigned int idx = y * QCOM_CAMSS_LSC_H_NUM + x;
+
+			out.r_q10[idx] = sample(0, gx, gy);
+			out.gr_q10[idx] = sample(1, gx, gy);
+			out.gb_q10[idx] = sample(2, gx, gy);
+			out.b_q10[idx] = sample(3, gx, gy);
+		}
+	}
+
+	return out;
+}
+
+} /* namespace libcamera::qcom */
