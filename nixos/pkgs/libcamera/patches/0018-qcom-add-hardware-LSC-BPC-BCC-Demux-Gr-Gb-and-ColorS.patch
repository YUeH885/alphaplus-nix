+void QcomCameraData::syncAbf(bool force)
+{
+	if (!hasAbf_ || !pix_ || !pix_->isOpen())
+		return;
+
+	const bool wantEnable = testPatternMode_ == controls::draft::TestPatternModeOff;
+	const double gain = std::clamp(aeGain_, 1.0, 16.0);
+	if (!force && abfProgrammed_) {
+		if (!wantEnable && !abfProgrammedEnabled_)
+			return;
+		if (wantEnable && abfProgrammedEnabled_ &&
+		    std::abs(gain - abfProgrammedGain_) < 0.35)
+			return;
+	}
+
+	qcom_camss_abf abf = {};
+	if (wantEnable) {
+		const double gainScale = std::sqrt(gain);
+		abf.enable = QCOM_CAMSS_ABF_ENABLE_FILTER |
+			     QCOM_CAMSS_ABF_ENABLE_CROSS_PLANE;
+		abf.act_th_r = 2;
+		abf.act_th_g = 1;
+		abf.act_th_b = 1;
+		abf.blk_pix_r = 2;
+		abf.blk_pix_g = 1;
+		abf.blk_pix_b = 1;
+		abf.bpc_max_shft = 2;
+		abf.bpc_min_shft = 2;
+		abf.bpc_offset = 64;
+		abf.spatial_wt[0] = 64;
+		abf.spatial_wt[1] = 48;
+		abf.spatial_wt[2] = 32;
+		abf.spatial_wt[3] = 16;
+		for (unsigned int i = 0; i < 8; ++i)
+			abf.curve_offset[i] = static_cast<uint8_t>(std::clamp<long>(
+				std::lround((4.0 + i * 1.5) * gainScale), 0, 255));
+		abf.edge_softness[0] = 32;
+		abf.edge_softness[1] = 32;
+		abf.edge_softness[2] = 8;
+		abf.edge_softness[3] = 8;
+		abf.noise_preserve_lo = 64;
+		abf.noise_preserve_span = 512;
+		abf.noise_preserve_base[0] = 192;
+		abf.noise_preserve_base[1] = 160;
+		for (unsigned int i = 0; i < QCOM_CAMSS_ABF_LUT_ENTRIES; ++i) {
+			const double norm = static_cast<double>(i) /
+					    (QCOM_CAMSS_ABF_LUT_ENTRIES - 1);
+			const double baseStd = 6.0 + 34.0 * std::sqrt(norm);
+			abf.noise_std_lut[i] = static_cast<uint16_t>(
+				std::clamp<long>(std::lround(baseStd * gainScale), 1, 511));
+		}
+	}
+
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+	control.id = V4L2_CID_QCOM_CAMSS_ABF;
+	control.size = sizeof(abf);
+	control.ptr = &abf;
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.controls = &control;
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret) {
+		LOG(QcomPipeline, Warning) << "Failed to program ABF 3.4: " << ret;
+		return;
+	}
+
+	abfProgrammed_ = true;
+	abfProgrammedEnabled_ = wantEnable;
+	abfProgrammedGain_ = gain;
+}
+
+void QcomCameraData::syncGtm(bool force)
+{
+	if (!hasGtm_ || !pix_ || !pix_->isOpen())
+		return;
+
+	const bool wantEnable = testPatternMode_ == controls::draft::TestPatternModeOff;
+	if (!force && gtmProgrammed_ && gtmProgrammedEnabled_ == wantEnable)
+		return;
+
+	static constexpr uint16_t kGtmXKnots[QCOM_CAMSS_GTM_ENTRIES] = {
+		0, 2, 4, 7, 13, 21, 31, 45, 62, 83,
+		107, 137, 169, 201, 233, 265, 297, 329, 361, 428,
+		463, 499, 538, 578, 621, 665, 712, 760, 811, 863,
+		919, 976, 1037, 1098, 1164, 1230, 1300, 1371, 1447, 1524,
+		1605, 1687, 1774, 1861, 1954, 2047, 2146, 2245, 2456, 2679,
+		2915, 3429, 3999, 4630, 5323, 6083, 6911, 7812, 8787, 9840,
+		10975, 12193, 13499, 14894, 16383,
+	};
+
+	qcom_camss_gtm gtm = {};
+	if (wantEnable) {
+		gtm.enable = 1;
+		for (unsigned int i = 0; i < QCOM_CAMSS_GTM_ENTRIES; ++i) {
+			const double t = static_cast<double>(kGtmXKnots[i]) / 16383.0;
+			const double lift = 1.0 + 0.06 * (1.0 - t) * (1.0 - t);
+			gtm.y_ratio_q12[i] = static_cast<uint32_t>(
+				std::clamp<long>(std::lround(4096.0 * lift), 0, 262143));
+		}
+	}
+
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+	control.id = V4L2_CID_QCOM_CAMSS_GTM;
+	control.size = sizeof(gtm);
+	control.ptr = &gtm;
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.controls = &control;
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret) {
+		LOG(QcomPipeline, Warning) << "Failed to program GTM 1.0: " << ret;
+		return;
+	}
+
+	gtmProgrammed_ = true;
+	gtmProgrammedEnabled_ = wantEnable;
+}
+
+void QcomCameraData::syncLsc(bool force)
+{
+	if (!hasLsc_ || !pix_ || !pix_->isOpen())
+		return;
+
+	const bool wantEnable = !lscCalibration_.tables.empty() &&
+				testPatternMode_ == controls::draft::TestPatternModeOff;
+	if (!force && lscProgrammed_) {
+		if (!wantEnable && !lscProgrammedEnabled_)
+			return;
+		if (wantEnable && lscProgrammedEnabled_ &&
+		    lscProgrammedCrop_ == analogCrop_ &&
+		    lscProgrammedTransform_ == transform_ &&
+		    (lscCalibration_.tables.size() <= 1 ||
+		     std::abs(colourTemperature_ - lscProgrammedCct_) < 150.0))
+			return;
+	}
+
+	qcom_camss_lsc lsc = {};
+	if (wantEnable) {
+		const Size fullSize = activeAreaSize_.isNull()
+			? profile_.fullInputSize
+			: activeAreaSize_;
+		lsc = buildHardwareLsc(lscCalibration_, colourTemperature_,
+				       fullSize, analogCrop_, transform_);
+	}
+
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+	control.id = V4L2_CID_QCOM_CAMSS_LSC;
+	control.size = sizeof(lsc);
+	control.ptr = &lsc;
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.controls = &control;
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret) {
+		LOG(QcomPipeline, Warning) << "Failed to program LSC mesh: " << ret;
+		return;
+	}
+
+	lscProgrammed_ = true;
+	lscProgrammedEnabled_ = wantEnable;
+	lscProgrammedCct_ = colourTemperature_;
+	lscProgrammedCrop_ = analogCrop_;
+	lscProgrammedTransform_ = transform_;
+}
