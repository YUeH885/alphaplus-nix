+double gainFromCode(const SensorProfile &profile, int32_t code)
+{
+	if (profile.gainModel == GainModel::Linear32)
+		return code / 32.0;
+	if (profile.gainModel == GainModel::SonyInverse512)
+		return 512.0 / (512.0 - code);
+
+	return 1024.0 / (1024.0 - code);
+}
+
+int32_t gainToCode(const SensorProfile &profile, double gain)
+{
+	if (profile.gainModel == GainModel::Linear32)
+		return static_cast<int32_t>(gain * 32.0);
+	if (profile.gainModel == GainModel::SonyInverse512)
+		return static_cast<int32_t>(512.0 - 512.0 / gain);
+
+	return std::lround(1024.0 - 1024.0 / gain);
+}
+
+std::optional<double> aeRegionLuma(const SensorProfile &profile,
+				   const uint64_t sums[4],
+				   const uint64_t counts[4])
+{
+	double values[4];
+	for (unsigned int c = 0; c < 4; c++) {
+		if (!counts[c])
+			return std::nullopt;
+		/* BG statistics already include hardware black-level correction. */
+		values[c] = static_cast<double>(sums[c]) / counts[c];
+	}
+
+	return profile.aeRgbWeights[0] * values[0] +
+	       profile.aeRgbWeights[1] * (values[2] + values[3]) * 0.5 +
+	       profile.aeRgbWeights[2] * values[1];
+}
+
+double profileTotalExposure(const AeExposureKnee &knee)
+{
+	return knee.gain * knee.exposureNs;
+}
+
+double aeExposureIndex(const SensorProfile &profile, double total)
+{
+	const AeExposureKnee *knees = profile.aeExposureKnees;
+	if (total <= profileTotalExposure(knees[0]))
+		return knees[0].index;
+
+	for (std::size_t i = 0; i + 1 < profile.aeExposureKneeCount; i++) {
+		double lower = profileTotalExposure(knees[i]);
+		double upper = profileTotalExposure(knees[i + 1]);
+		if (total <= upper) {
+			double t = (std::log2(total) - std::log2(lower)) /
+				   (std::log2(upper) - std::log2(lower));
+			return knees[i].index + t *
+			       (knees[i + 1].index - knees[i].index);
+		}
+	}
+
+	return knees[profile.aeExposureKneeCount - 1].index;
+}
+
+double aeExposureForIndex(const SensorProfile &profile, double index)
+{
+	const AeExposureKnee *knees = profile.aeExposureKnees;
+	if (index <= knees[0].index)
+		return profileTotalExposure(knees[0]);
+	for (std::size_t i = 0; i + 1 < profile.aeExposureKneeCount; i++) {
+		if (index <= knees[i + 1].index) {
+			double t = (index - knees[i].index) /
+				   (knees[i + 1].index - knees[i].index);
+			return profileTotalExposure(knees[i]) *
+			       std::pow(profileTotalExposure(knees[i + 1]) /
+					profileTotalExposure(knees[i]), t);
+		}
+	}
+	return profileTotalExposure(knees[profile.aeExposureKneeCount - 1]);
+}
+
+double aeLuxIndex(const SensorProfile &profile, double exposureIndex,
+		  double luma10)
+{
+	double luma8 = std::max(luma10 / kAeTargetScale,
+				profile.aeLuxLumaMinimum8);
+	return std::max(0.0, exposureIndex + profile.aeLuxLogScale *
+				     std::log10(profile.aeLuxReferenceLuma8 / luma8));
+}
+
+double aeTargetForLux(const SensorProfile &profile, double lux)
+{
+	const AeLuxZone *zones = profile.aeLuxZones;
+	if (lux <= zones[0].start)
+		return zones[0].target8;
+
+	for (std::size_t i = 0; i + 1 < profile.aeLuxZoneCount; i++) {
+		const AeLuxZone &zone = zones[i];
+		const AeLuxZone &next = zones[i + 1];
+		if (lux <= zone.end)
+			return zone.target8;
+		if (lux < next.start) {
+			double t = (lux - zone.end) / (next.start - zone.end);
+			return zone.target8 + t * (next.target8 - zone.target8);
+		}
+	}
+
+	return zones[profile.aeLuxZoneCount - 1].target8;
+}
+
+void aeAllocateExposure(const SensorProfile &profile, double total,
+			double &gain, double &exposureNs)
+{
+	const AeExposureKnee *knees = profile.aeExposureKnees;
+	if (total <= profileTotalExposure(knees[0])) {
+		gain = knees[0].gain;
+		exposureNs = knees[0].exposureNs;
+		return;
+	}
+
+	for (std::size_t i = 0; i + 1 < profile.aeExposureKneeCount; i++) {
+		double lower = profileTotalExposure(knees[i]);
+		double upper = profileTotalExposure(knees[i + 1]);
+		if (total <= upper) {
+			double t = (std::log2(total) - std::log2(lower)) /
+				   (std::log2(upper) - std::log2(lower));
+			gain = knees[i].gain *
+			       std::pow(knees[i + 1].gain / knees[i].gain, t);
+			exposureNs = total / gain;
+			return;
+		}
+	}
+
+	const AeExposureKnee &last = knees[profile.aeExposureKneeCount - 1];
+	gain = last.gain;
+	exposureNs = last.exposureNs;
+}
+
+void interpolateCcm(const SensorProfile &profile, double cct,
+		    int16_t (&coefficients)[9])
+{
+	const CcmEntry *entries = profile.ccmEntries;
+	cct = std::clamp(cct, static_cast<double>(entries[0].cct),
+			 static_cast<double>(entries[profile.ccmEntryCount - 1].cct));
+	std::size_t i = 0;
+	while (i + 2 < profile.ccmEntryCount && cct > entries[i + 1].cct)
+		i++;
+	const CcmEntry &lower = entries[i];
+	const CcmEntry &upper = entries[i + 1];
+	double t = (cct - lower.cct) / (upper.cct - lower.cct);
+	for (unsigned int j = 0; j < 9; j++)
+		coefficients[j] = std::lround(lower.q7[j] +
+					       t * (upper.q7[j] - lower.q7[j]));
+}
+
+uint64_t monotonicNs()
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(
+		utils::clock::now().time_since_epoch()).count();
+}
+
+template<std::size_t Size>
+int readFile(const std::filesystem::path &path, off_t offset,
+	     std::array<uint8_t, Size> *data)
+{
+	File file(path.string());
+	if (!file.open(File::OpenModeFlag::ReadOnly))
+		return file.error();
+	if (file.seek(offset) != offset)
+		return -EIO;
+
+	ssize_t bytes = file.read(*data);
+	if (bytes < 0)
+		return bytes;
+	return bytes == static_cast<ssize_t>(data->size()) ? 0 : -EIO;
+}
+
+uint32_t readBe32(const std::array<uint8_t, 4> &data)
+{
+	return static_cast<uint32_t>(data[0]) << 24 |
+	       static_cast<uint32_t>(data[1]) << 16 |
+	       static_cast<uint32_t>(data[2]) << 8 |
+	       data[3];
+}
+
+int calibrationSource(const std::string &sensorId, unsigned int *cameraId,
+		      std::filesystem::path *nvmem)
+{
+	const std::filesystem::path sensorNode =
+		std::filesystem::path("/sys/firmware/devicetree") /
+		sensorId.substr(sensorId.starts_with('/') ? 1 : 0);
+	std::array<uint8_t, 4> property;
+
+	int ret = readFile(sensorNode / "lg,camera-id", 0, &property);
+	if (ret) {
+		LOG(QcomPipeline, Error)
+			<< "Failed to read LG camera ID from " << sensorNode;
+		return ret;
+	}
+	*cameraId = readBe32(property);
+
+	ret = readFile(sensorNode / "nvmem", 0, &property);
+	if (ret) {
+		LOG(QcomPipeline, Error)
+			<< "Failed to read NVMEM provider from " << sensorNode;
+		return ret;
+	}
+	uint32_t providerPhandle = readBe32(property);
+
+	std::error_code errorCode;
+	std::filesystem::path provider;
+	for (const auto &entry : std::filesystem::directory_iterator(
+		     "/sys/bus/nvmem/devices", errorCode)) {
+		std::array<uint8_t, 4> phandle;
+		if (!readFile(entry.path() / "of_node/phandle", 0, &phandle) &&
+		    readBe32(phandle) == providerPhandle) {
+			provider = entry.path();
+			break;
+		}
+	}
+	if (errorCode) {
+		LOG(QcomPipeline, Error)
+			<< "Failed to enumerate NVMEM devices: " << errorCode.message();
+		return -errorCode.value();
+	}
+	if (provider.empty()) {
+		LOG(QcomPipeline, Error)
+			<< "NVMEM provider " << providerPhandle << " not found";
+		return -ENODEV;
+	}
+
+	*nvmem = provider / "nvmem";
+	return 0;
+}
+
+int loadAfModel(unsigned int cameraId, const std::filesystem::path &nvmem,
+		std::optional<LgAfModel> *model)
+{
+	std::array<uint8_t, LgAfModel::kEepromBlockSize> block;
+	int ret = readFile(nvmem, LgAfModel::eepromOffset(cameraId), &block);
+	if (ret) {
+		LOG(QcomPipeline, Error) << "Failed to read AF calibration from " << nvmem;
+		return ret;
+	}
+	std::string reason;
+	*model = LgAfModel::fromEeprom(cameraId, block, &reason);
+	if (!*model) {
+		LOG(QcomPipeline, Error) << "Invalid AF calibration: " << reason;
+		return -EINVAL;
+	}
+	return 0;
+}
