+struct SmartFlashTuning {
+	bool smartEnabled;
+	float strength;
+	float floorPercentage;
+	float saturationPreventionStrength;
+	uint32_t minimumOffStatistics;
+	uint32_t brightLevel;
+	uint32_t brightLevelDifference;
+	uint32_t minimumLuma;
+	float minimumLumaAdjustment;
+	float fluxRatio;
+	bool flashTargetEnabled;
+};
+
+struct FlashEstimationResult {
+	float lumaOff;
+	float lumaLow;
+	float lumaHigh;
+	float flashInfluence;
+	float lumaTarget;
+	float targetIndex;
+};
+
+static SmartFlashTuning smartFlashTuningForSensor(const std::string &model)
+{
+	if (model.find("imx363") != std::string::npos) {
+		return {
+			.smartEnabled = false,
+			.strength = 1.3f,
+			.floorPercentage = 0.9f,
+			.saturationPreventionStrength = 0.6f,
+			.minimumOffStatistics = 3,
+			.brightLevel = 200,
+			.brightLevelDifference = 30,
+			.minimumLuma = 15,
+			.minimumLumaAdjustment = 1.0f,
+			.fluxRatio = 9.0f,
+			.flashTargetEnabled = true,
+		};
+	}
+	if (model.find("imx351") != std::string::npos || model.find("s5k3m5") != std::string::npos) {
+		return {
+			.smartEnabled = true,
+			.strength = 1.5f,
+			.floorPercentage = 0.9f,
+			.saturationPreventionStrength = 0.7f,
+			.minimumOffStatistics = 3,
+			.brightLevel = 190,
+			.brightLevelDifference = 30,
+			.minimumLuma = 15,
+			.minimumLumaAdjustment = 0.55f,
+			.fluxRatio = 9.0f,
+			.flashTargetEnabled = false,
+		};
+	}
+	return {
+		.smartEnabled = false,
+		.strength = 1.0f,
+		.floorPercentage = 1.0f,
+		.saturationPreventionStrength = 0.0f,
+		.minimumOffStatistics = 0,
+		.brightLevel = 255,
+		.brightLevelDifference = 0,
+		.minimumLuma = 0,
+		.minimumLumaAdjustment = 0.0f,
+		.fluxRatio = 1.0f,
+		.flashTargetEnabled = false,
+	};
+}
+
+static FlashEstimationResult estimateSmartFlash(
+	const SmartFlashTuning &tuning,
+	float aeLuxLogScale,
+	float minimumIndex,
+	float maximumIndex,
+	float ambientIndex,
+	float preflashIndex,
+	const std::array<float, 256> &ambientZoneLuma,
+	const std::array<float, 256> &preflashZoneLuma,
+	const float (*meteringWeights)[16],
+	float defaultTarget)
+{
+	float deltaIndex = ambientIndex - preflashIndex;
+	float exposureRatio = std::pow(10.0f, deltaIndex / aeLuxLogScale);
+
+	double weightSum = 0.0;
+	double lumaOffSum = 0.0;
+	double lumaLowSum = 0.0;
+
+	for (std::size_t i = 0; i < 256; ++i) {
+		float lumaOff = ambientZoneLuma[i];
+		float lumaLowNorm = preflashZoneLuma[i] * exposureRatio;
+		float deltaLuma = lumaLowNorm - lumaOff;
+
+		float smartWeight = 1.0f;
+		if (tuning.smartEnabled) {
+			if (deltaLuma > 1.0f) {
+				smartWeight = tuning.strength;
+				if (lumaLowNorm > static_cast<float>(tuning.brightLevel))
+					smartWeight *= (1.0f - tuning.saturationPreventionStrength);
+			} else {
+				smartWeight = tuning.floorPercentage;
+			}
+		}
+
+		float baseWeight = meteringWeights ? meteringWeights[i / 16][i % 16] : 1.0f;
+		float w = baseWeight * smartWeight;
+		weightSum += w;
+		lumaOffSum += w * lumaOff;
+		lumaLowSum += w * lumaLowNorm;
+	}
+
+	float lumaOff = weightSum > 0.0 ? static_cast<float>(lumaOffSum / weightSum) : 0.0f;
+	float lumaLow = weightSum > 0.0 ? static_cast<float>(lumaLowSum / weightSum) : 0.0f;
+	float lumaBounce = std::max(0.0f, lumaLow - lumaOff);
+
+	float lumaHigh = lumaOff + tuning.fluxRatio * lumaBounce;
+	float flashInfluence = lumaHigh > 0.0f ? (tuning.fluxRatio * lumaBounce) / lumaHigh : 0.0f;
+
+	float lumaTarget = defaultTarget;
+	if (tuning.flashTargetEnabled) {
+		float flashTarget = 22.0f;
+		if (ambientIndex >= 450.0f)
+			flashTarget = 14.0f;
+		else if (ambientIndex >= 362.0f)
+			flashTarget = 14.0f;
+		else if (ambientIndex >= 290.0f)
+			flashTarget = 18.0f;
+		else if (ambientIndex >= 166.0f)
+			flashTarget = 20.0f;
+		lumaTarget = defaultTarget * (1.0f - flashInfluence) + flashTarget * flashInfluence;
+	}
+
+	float ratio = lumaHigh / std::max(1.0f, lumaTarget);
+	float deltaTargetIndex = aeLuxLogScale * std::log10(std::max(0.01f, ratio));
+	float targetIndex = std::clamp(ambientIndex - deltaTargetIndex, minimumIndex, maximumIndex);
+
+	return {
+		lumaOff,
+		lumaLow,
+		lumaHigh,
+		flashInfluence,
+		lumaTarget,
+		targetIndex
+	};
+}
