diff --git a/src/libcamera/pipeline/qcom/fd_engine.h b/src/libcamera/pipeline/qcom/fd_engine.h
new file mode 100644
index 0000000..1c23cfc
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/fd_engine.h
@@ -0,0 +1,278 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Asynchronous wrapper around the SM8150 Titan 175 hardware FD501 accelerator
+ * (/dev/qcom-fd) for real-time face detection on NV12 luma frames.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <condition_variable>
+#include <cstdint>
+#include <fcntl.h>
+#include <linux/ioctl.h>
+#include <linux/types.h>
+#include <mutex>
+#include <sys/ioctl.h>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+namespace libcamera::qcom {
+
+namespace fd_uapi {
+
+constexpr unsigned int kMaxFaces = 35;
+constexpr uint32_t kFlagAllAngles = 1U << 0;
+
+struct qcom_fd_face {
+	__u16 center_x;
+	__u16 center_y;
+	__u16 size;
+	__u16 confidence;
+	__u16 roll;
+	__s16 pose;
+};
+
+struct qcom_fd_detect {
+	__u64 image_ptr;
+	__u32 width;
+	__u32 height;
+	__u32 stride;
+	__u32 min_face_size;
+	__u32 threshold;
+	__u32 flags;
+	__u32 face_count;
+	__u32 reserved;
+	struct qcom_fd_face faces[kMaxFaces];
+};
+
+constexpr unsigned long kIocDetect = _IOWR('F', 0x01, struct qcom_fd_detect);
+
+} /* namespace fd_uapi */
+
+struct HardwareFace {
+	Rectangle rect;
+	uint8_t score = 0;
+	int16_t pose = 0;
+	uint16_t roll = 0;
+};
+
+class HardwareFdEngine
+{
+public:
+	~HardwareFdEngine()
+	{
+		stop();
+	}
+
+	bool start()
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (running_)
+			return fd_ >= 0;
+
+		fd_ = ::open("/dev/qcom-fd", O_RDWR | O_CLOEXEC);
+		if (fd_ < 0)
+			return false;
+
+		stopRequested_ = false;
+		hasPending_ = false;
+		running_ = true;
+		worker_ = std::thread(&HardwareFdEngine::workerLoop, this);
+		return true;
+	}
+
+	void stop()
+	{
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			if (!running_)
+				return;
+			stopRequested_ = true;
+			hasPending_ = false;
+		}
+		cv_.notify_one();
+
+		if (worker_.joinable())
+			worker_.join();
+
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (fd_ >= 0) {
+			::close(fd_);
+			fd_ = -1;
+		}
+		running_ = false;
+		results_.clear();
+		hasResults_ = false;
+	}
+
+	bool isRunning() const
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		return running_;
+	}
+
+	void submitNv12(const uint8_t *yData, uint32_t srcW, uint32_t srcH,
+			uint32_t srcStride, const Rectangle &statsCrop,
+			const Size &statsSize, bool allAngles)
+	{
+		if (!yData || !srcW || !srcH || srcStride < srcW ||
+		    !statsCrop.width || !statsCrop.height ||
+		    !statsSize.width || !statsSize.height)
+			return;
+
+		/* Pick FD501 native 4:3 (320x240) or 16:9 (427x240) input mode. */
+		const uint32_t dstW = (srcW * 3 > srcH * 4) ? 427 : 320;
+		const uint32_t dstH = 240;
+
+		std::unique_lock<std::mutex> lock(mutex_);
+		if (!running_ || busy_)
+			return;
+
+		pendingY_.resize(dstW * dstH);
+		for (uint32_t y = 0; y < dstH; ++y) {
+			uint32_t sy = (y * srcH) / dstH;
+			const uint8_t *srcRow = yData + sy * srcStride;
+			uint8_t *dstRow = pendingY_.data() + y * dstW;
+			for (uint32_t x = 0; x < dstW; ++x)
+				dstRow[x] = srcRow[(x * srcW) / dstW];
+		}
+
+		pendingW_ = dstW;
+		pendingH_ = dstH;
+		pendingCrop_ = statsCrop;
+		pendingStatsSize_ = statsSize;
+		pendingAllAngles_ = allAngles;
+		hasPending_ = true;
+		lock.unlock();
+		cv_.notify_one();
+	}
+
+	bool latestResults(std::vector<HardwareFace> &out) const
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (!hasResults_)
+			return false;
+		out = results_;
+		return true;
+	}
+
+private:
+	void workerLoop()
+	{
+		std::vector<uint8_t> workY;
+		while (true) {
+			uint32_t width = 0;
+			uint32_t height = 0;
+			Rectangle crop;
+			Size statsSize;
+			bool allAngles = false;
+			int devFd = -1;
+
+			{
+				std::unique_lock<std::mutex> lock(mutex_);
+				cv_.wait(lock, [this]() {
+					return stopRequested_ || hasPending_;
+				});
+				if (stopRequested_)
+					break;
+
+				workY.swap(pendingY_);
+				width = pendingW_;
+				height = pendingH_;
+				crop = pendingCrop_;
+				statsSize = pendingStatsSize_;
+				allAngles = pendingAllAngles_;
+				devFd = fd_;
+				hasPending_ = false;
+				busy_ = true;
+			}
+
+			fd_uapi::qcom_fd_detect req{};
+			req.image_ptr = reinterpret_cast<uintptr_t>(workY.data());
+			req.width = width;
+			req.height = height;
+			req.stride = width;
+			req.min_face_size = 20;
+			req.threshold = 5;
+			req.flags = allAngles ? fd_uapi::kFlagAllAngles : 0;
+
+			std::vector<HardwareFace> detected;
+			if (devFd >= 0 && ::ioctl(devFd, fd_uapi::kIocDetect, &req) == 0) {
+				const uint32_t count = std::min<uint32_t>(req.face_count, fd_uapi::kMaxFaces);
+				detected.reserve(count);
+				const double scaleX = static_cast<double>(crop.width) / width;
+				const double scaleY = static_cast<double>(crop.height) / height;
+
+				for (uint32_t i = 0; i < count; ++i) {
+					const auto &f = req.faces[i];
+					if (f.size == 0)
+						continue;
+
+					const double half = f.size * 0.5;
+					int32_t x0 = crop.x + static_cast<int32_t>(std::lround((f.center_x - half) * scaleX));
+					int32_t y0 = crop.y + static_cast<int32_t>(std::lround((f.center_y - half) * scaleY));
+					int32_t x1 = crop.x + static_cast<int32_t>(std::lround((f.center_x + half) * scaleX));
+					int32_t y1 = crop.y + static_cast<int32_t>(std::lround((f.center_y + half) * scaleY));
+
+					x0 = std::clamp<int32_t>(x0, 0, static_cast<int32_t>(statsSize.width));
+					y0 = std::clamp<int32_t>(y0, 0, static_cast<int32_t>(statsSize.height));
+					x1 = std::clamp<int32_t>(x1, x0, static_cast<int32_t>(statsSize.width));
+					y1 = std::clamp<int32_t>(y1, y0, static_cast<int32_t>(statsSize.height));
+					if (x1 <= x0 || y1 <= y0)
+						continue;
+
+					HardwareFace face;
+					face.rect = Rectangle(x0, y0, static_cast<unsigned int>(x1 - x0),
+							      static_cast<unsigned int>(y1 - y0));
+					face.score = static_cast<uint8_t>(std::clamp<int>((f.confidence * 100) / 1500, 1, 100));
+					face.pose = f.pose;
+					face.roll = f.roll;
+					detected.push_back(face);
+				}
+
+				/* Order largest face first so AWB/AF face-priority picks the primary subject. */
+				std::sort(detected.begin(), detected.end(),
+					  [](const HardwareFace &a, const HardwareFace &b) {
+						  uint64_t areaA = static_cast<uint64_t>(a.rect.width) * a.rect.height;
+						  uint64_t areaB = static_cast<uint64_t>(b.rect.width) * b.rect.height;
+						  if (areaA != areaB)
+							  return areaA > areaB;
+						  return a.score > b.score;
+					  });
+			}
+
+			{
+				std::lock_guard<std::mutex> lock(mutex_);
+				results_ = std::move(detected);
+				hasResults_ = true;
+				busy_ = false;
+			}
+		}
+	}
+
+	mutable std::mutex mutex_;
+	std::condition_variable cv_;
+	std::thread worker_;
+	int fd_ = -1;
+	bool running_ = false;
+	bool stopRequested_ = false;
+	bool hasPending_ = false;
+	bool busy_ = false;
+
+	std::vector<uint8_t> pendingY_;
+	uint32_t pendingW_ = 0;
+	uint32_t pendingH_ = 0;
+	Rectangle pendingCrop_;
+	Size pendingStatsSize_;
+	bool pendingAllAngles_ = false;
+
+	std::vector<HardwareFace> results_;
+	bool hasResults_ = false;
+};
+
+} /* namespace libcamera::qcom */
