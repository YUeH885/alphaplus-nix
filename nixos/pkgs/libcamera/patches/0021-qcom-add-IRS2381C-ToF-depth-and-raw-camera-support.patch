From 47466131417208740935fc3848447b78f8a2ad5a Mon Sep 17 00:00:00 2001
From: yuzu <yuzu23234@gmail.com>
Date: Sun, 22 Nov 2026 17:06:14 +0800
Subject: [PATCH] qcom: add IRS2381C ToF depth and raw camera support

---
 src/libcamera/pipeline/qcom/qcom.cpp          |  64 ++
 src/libcamera/pipeline/qcom/tof_camera.h      | 964 ++++++++++++++++++
 src/libcamera/pipeline/qcom/tof_demodulator.h | 730 +++++++++++++
 3 files changed, 1758 insertions(+)
 create mode 100644 src/libcamera/pipeline/qcom/tof_camera.h
 create mode 100644 src/libcamera/pipeline/qcom/tof_demodulator.h

diff --git a/src/libcamera/pipeline/qcom/qcom.cpp b/src/libcamera/pipeline/qcom/qcom.cpp
index 5089eb6..e44326c 100644
--- a/src/libcamera/pipeline/qcom/qcom.cpp
