+
 	bool hasCsiphyConflict(Camera *camera) const;
 	int allocateSlot(Camera *camera) const;
 	int bindCameraSlot(Camera *camera, int slotIndex);
@@ -1401,6 +1412,7 @@ private:
 
 	std::shared_ptr<MediaDevice> media_;
 	std::vector<VfeSlot> vfeSlots_;
+	std::set<const Camera *> tofCameras_;
 	Camera *flashOwner_ = nullptr;
 	std::unique_ptr<FC4Engine> fc4Engine_;
 };
@@ -4971,6 +4983,9 @@ std::unique_ptr<CameraConfiguration>
 QcomPipelineHandler::generateConfiguration(Camera *camera,
 					   Span<const StreamRole> roles)
 {
+	if (isTofCamera(camera))
+		return tofCameraData(camera)->generateConfiguration(roles);
+
 	QcomCameraData *data = cameraData(camera);
 	auto config = std::make_unique<QcomCameraConfiguration>(data);
 
@@ -5123,6 +5138,9 @@ bool QcomPipelineHandler::anyActiveFc4Camera() const
 
 int QcomPipelineHandler::configure(Camera *camera, CameraConfiguration *config)
 {
+	if (isTofCamera(camera))
+		return tofCameraData(camera)->configure(config);
+
 	QcomCameraConfiguration *qcomConfig = static_cast<QcomCameraConfiguration *>(config);
 	if (qcomConfig->pixIndex_.has_value() && qcomConfig->sensorSize_.width > 4096) {
 		for (const VfeSlot &entry : vfeSlots_) {
@@ -5194,6 +5212,9 @@ int QcomPipelineHandler::configure(Camera *camera, CameraConfiguration *config)
 int QcomPipelineHandler::exportFrameBuffers(Camera *camera, Stream *stream,
 					    std::vector<std::unique_ptr<FrameBuffer>> *buffers)
 {
+	if (isTofCamera(camera))
+		return tofCameraData(camera)->exportFrameBuffers(stream, buffers);
+
 	int slot = allocateSlot(camera);
 	if (slot < 0)
 		return slot;
@@ -5223,6 +5244,9 @@ int QcomPipelineHandler::exportFrameBuffers(Camera *camera, Stream *stream,
 
 int QcomPipelineHandler::start(Camera *camera, const ControlList *controls)
 {
+	if (isTofCamera(camera))
+		return tofCameraData(camera)->start(controls);
+
 	QcomCameraData *data = cameraData(camera);
 	if (data->pixConfigured_ && data->configuredSensorSize_.width > 4096) {
 		for (const VfeSlot &entry : vfeSlots_) {
@@ -5402,6 +5426,11 @@ int QcomPipelineHandler::start(Camera *camera, const ControlList *controls)
 
 void QcomPipelineHandler::stopDevice(Camera *camera)
 {
+	if (isTofCamera(camera)) {
+		tofCameraData(camera)->stopDevice();
+		return;
+	}
+
 	QcomCameraData *data = cameraData(camera);
 
 	if (data->flashActive()) {
@@ -5451,6 +5480,9 @@ void QcomPipelineHandler::stopDevice(Camera *camera)
 
 int QcomPipelineHandler::queueRequestDevice(Camera *camera, Request *request)
 {
+	if (isTofCamera(camera))
+		return tofCameraData(camera)->queueRequest(request);
+
 	QcomCameraData *data = cameraData(camera);
 	FrameBuffer *pixBuffer = request->findBuffer(&data->stream_);
 	FrameBuffer *rawBuffer = request->findBuffer(&data->rawStream_);
@@ -5516,11 +5548,21 @@ bool QcomPipelineHandler::match(DeviceEnumerator *enumerator)
 	if (vfeSlots_.empty())
 		return false;
 
+	MediaEntity *tofRdi = media_->getEntityByName("msm_vfe3_rdi0");
+	MediaEntity *tofVideo = findOutputVideo(tofRdi);
+	std::vector<MediaEntity *> tofSensors;
+
 	unsigned int registered = 0;
 	for (MediaEntity *entity : media_->entities()) {
 		if (entity->function() != MEDIA_ENT_F_CAM_SENSOR)
 			continue;
 
+		if (entity->name().find("irs2381c") != std::string::npos &&
+		    tofRdi && tofVideo) {
+			tofSensors.push_back(entity);
+			continue;
+		}
+
 		const SensorProfile *profile = nullptr;
 		for (const SensorProfile *candidate :
 		     { &kImx363Profile, &kImx351Profile, &kImx520Profile,
@@ -5552,6 +5594,28 @@ bool QcomPipelineHandler::match(DeviceEnumerator *enumerator)
 		registered++;
 	}
 
+	/* Register ToF depth cameras after RGB cameras to preserve default indices. */
+	for (MediaEntity *entity : tofSensors) {
+		auto tofData = std::make_unique<TofCameraData>(this, media_);
+		int ret = tofData->init(entity, tofRdi, tofVideo);
+		if (ret < 0) {
+			LOG(QcomPipeline, Error)
+				<< "Failed to initialize ToF sensor "
+				<< entity->name() << ": " << ret;
+			continue;
+		}
+
+		std::set<Stream *> streams{
+			&tofData->processedStream_,
+			&tofData->rawStream_,
+		};
+		std::shared_ptr<Camera> camera =
+			Camera::create(std::move(tofData), entity->name(), streams);
+		tofCameras_.insert(camera.get());
+		registerCamera(std::move(camera));
+		registered++;
+	}
+
 	if (!registered)
 		LOG(QcomPipeline, Debug) << "No supported sensor found";
 
diff --git a/src/libcamera/pipeline/qcom/tof_camera.h b/src/libcamera/pipeline/qcom/tof_camera.h
new file mode 100644
index 0000000..71135e0
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/tof_camera.h
@@ -0,0 +1,964 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026 The LM-G820N Linux contributors
+ *
+ * Infineon REAL3 IRS2381C ToF camera integration on dedicated VFE Lite RDI.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <ctime>
+#include <deque>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <linux/media-bus-format.h>
+#include <linux/v4l2-controls.h>
+#include <linux/v4l2-subdev.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/camera.h>
+#include <libcamera/color_space.h>
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+#include <libcamera/formats.h>
+#include <libcamera/framebuffer.h>
+#include <libcamera/geometry.h>
+#include <libcamera/pixel_format.h>
+#include <libcamera/property_ids.h>
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/camera.h"
+#include "libcamera/internal/dma_buf_allocator.h"
+#include "libcamera/internal/formats.h"
+#include "libcamera/internal/framebuffer.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/media_device.h"
+#include "libcamera/internal/pipeline_handler.h"
+#include "libcamera/internal/request.h"
+#include "libcamera/internal/v4l2_subdevice.h"
+#include "libcamera/internal/v4l2_videodevice.h"
+
+#include "tof_demodulator.h"
+
+namespace libcamera {
+
+LOG_DECLARE_CATEGORY(QcomPipeline)
+
+class TofCameraData;
+
+class TofCameraConfiguration : public CameraConfiguration
+{
+public:
+	explicit TofCameraConfiguration(TofCameraData *data)
+		: CameraConfiguration(), data_(data)
+	{
+	}
+
+	Status validate() override;
+
+	std::optional<unsigned int> processedIndex_;
+	std::optional<unsigned int> rawIndex_;
+	PixelFormat processedFormat_ = formats::NV12;
+	Size rawSize_{ 224, 1903 };
+
+private:
+	TofCameraData *data_;
+};
+
+class TofCameraData : public Camera::Private
+{
+public:
+	static constexpr unsigned int kBufferCount = 4;
+	static constexpr Size kDepthSize{ 224, 172 };
+	static constexpr Size kRaw9Size{ 224, 1903 };
+	static constexpr Size kRaw5Size{ 224, 1211 };
+
+	struct FormatGeometry {
+		unsigned int stride;
+		unsigned int frameSize;
+	};
+
+	TofCameraData(PipelineHandler *pipe, std::shared_ptr<MediaDevice> media)
+		: Camera::Private(pipe),
+		  media_(std::move(media)),
+		  dmaBufAllocator_(DmaBufAllocator::DmaBufAllocatorFlag::SystemHeap |
+				   DmaBufAllocator::DmaBufAllocatorFlag::CmaHeap |
+				   DmaBufAllocator::DmaBufAllocatorFlag::UDmaBuf)
+	{
+	}
+
+	int init(MediaEntity *sensorEntity, MediaEntity *rdiEntity,
+		 MediaEntity *videoEntity)
+	{
+		sensorEntity_ = sensorEntity;
+		rdiEntity_ = rdiEntity;
+
+		int ret = findPath(sensorEntity, rdiEntity);
+		if (ret < 0)
+			return ret;
+
+		for (MediaEntity *entity : path_) {
+			if (entity->name().starts_with("msm_csiphy")) {
+				csiphyEntity_ = entity;
+				break;
+			}
+		}
+
+		sensor_ = std::make_unique<V4L2Subdevice>(sensorEntity);
+		video_ = V4L2VideoDevice::fromEntityName(media_.get(), videoEntity->name());
+		if (!video_)
+			return -ENODEV;
+
+		video_->bufferReady.connect(this, &TofCameraData::rawBufferReady);
+
+		ret = sensor_->open();
+		if (ret < 0)
+			return ret;
+		ret = video_->open();
+		if (ret < 0) {
+			sensor_->close();
+			return ret;
+		}
+		auto closeDevices = utils::scope_exit{ [&]() {
+			video_->close();
+			sensor_->close();
+		} };
+
+		/* Populate static camera properties from sensor V4L2 controls. */
+		int32_t location = properties::CameraLocationFront;
+		int32_t rotation = 270;
+		const ControlInfoMap &sensorCtrls = sensor_->controls();
+		if (sensorCtrls.count(V4L2_CID_CAMERA_ORIENTATION)) {
+			const std::array<uint32_t, 1> ids{ V4L2_CID_CAMERA_ORIENTATION };
+			ControlList vals = sensor_->getControls(ids);
+			if (vals.contains(V4L2_CID_CAMERA_ORIENTATION)) {
+				switch (vals.get(V4L2_CID_CAMERA_ORIENTATION).get<int32_t>()) {
+				case V4L2_CAMERA_ORIENTATION_FRONT:
+					location = properties::CameraLocationFront;
+					break;
+				case V4L2_CAMERA_ORIENTATION_BACK:
+					location = properties::CameraLocationBack;
+					break;
+				default:
+					location = properties::CameraLocationExternal;
+					break;
+				}
+			}
+		}
+		if (sensorCtrls.count(V4L2_CID_CAMERA_SENSOR_ROTATION)) {
+			const std::array<uint32_t, 1> ids{ V4L2_CID_CAMERA_SENSOR_ROTATION };
+			ControlList vals = sensor_->getControls(ids);
+			if (vals.contains(V4L2_CID_CAMERA_SENSOR_ROTATION))
+				rotation = vals.get(V4L2_CID_CAMERA_SENSOR_ROTATION).get<int32_t>();
+		}
+
+		properties_.set(properties::Location, location);
+		properties_.set(properties::Rotation, rotation);
+		properties_.set(properties::Model, "irs2381c");
+		properties_.set(properties::PixelArraySize, kDepthSize);
+		properties_.set(properties::PixelArrayActiveAreas, { Rectangle(kDepthSize) });
+
+		/* Cache VFE Lite RDI raw format geometry for 9-phase and 5-phase modes. */
+		const V4L2PixelFormat rawFourcc =
+			video_->toV4L2PixelFormat(formats::SBGGR12_CSI2P);
+		for (const Size &sz : { kRaw9Size, kRaw5Size }) {
+			V4L2DeviceFormat fmt;
+			fmt.fourcc = rawFourcc;
+			fmt.size = sz;
+			fmt.colorSpace = ColorSpace::Raw;
+			if (video_->tryFormat(&fmt) == 0 &&
+			    fmt.fourcc == rawFourcc && fmt.size == sz) {
+				rawFormatCache_[sz] = {
+					fmt.planes[0].bpl,
+					fmt.planes[0].size,
+				};
+			}
+		}
+		if (rawFormatCache_.empty()) {
+			LOG(QcomPipeline, Error)
+				<< "VFE Lite RDI does not support IRS2381C RAW12 modes";
+			return -EINVAL;
+		}
+
+		if (sensorCtrls.count(V4L2_CID_EXPOSURE)) {
+			const ControlInfo &expInfo = sensorCtrls.at(V4L2_CID_EXPOSURE);
+			exposureMinUs_ = expInfo.min().get<int32_t>();
+			exposureMaxUs_ = expInfo.max().get<int32_t>();
+			currentExposureUs_ = expInfo.def().get<int32_t>();
+		}
+
+		/*
+		 * Expose full hardware-enforced eye-safety exposure envelope across
+		 * all use cases (100..4000 us) and supported frame intervals (5..30 fps).
+		 */
+		ControlInfoMap::Map ctrls;
+		ctrls[&controls::ExposureTime] =
+			ControlInfo(100, 4000, std::clamp(currentExposureUs_, 100, 4000));
+		ctrls[&controls::FrameDurationLimits] =
+			ControlInfo(static_cast<int64_t>(33333),
+				    static_cast<int64_t>(200000),
+				    static_cast<int64_t>(66667));
+		controlInfo_ = ControlInfoMap(std::move(ctrls), controls::controls);
+
+		return 0;
+	}
+
+	std::unique_ptr<CameraConfiguration>
+	generateConfiguration(Span<const StreamRole> roles)
+	{
+		auto config = std::make_unique<TofCameraConfiguration>(this);
+		if (roles.empty())
+			return config;
+		if (roles.size() > 2)
+			return nullptr;
+
+		bool hasProcessed = false;
+		bool hasRaw = false;
+		for (StreamRole role : roles) {
+			if (role == StreamRole::Raw) {
+				if (hasRaw)
+					return nullptr;
+				hasRaw = true;
+			} else {
+				if (hasProcessed)
+					return nullptr;
+				hasProcessed = true;
+			}
+		}
+
+		for (StreamRole role : roles) {
+			if (role == StreamRole::Raw) {
+				std::map<PixelFormat, std::vector<SizeRange>> fmts;
+				std::vector<SizeRange> sizes;
+				for (const auto &[sz, geom] : rawFormatCache_)
+					sizes.emplace_back(sz, sz);
+				fmts[formats::SBGGR12_CSI2P] = std::move(sizes);
+
+				StreamConfiguration cfg(fmts);
+				cfg.pixelFormat = formats::SBGGR12_CSI2P;
+				cfg.size = kRaw9Size;
+				cfg.colorSpace = ColorSpace::Raw;
+				cfg.bufferCount = kBufferCount;
+				config->addConfiguration(cfg);
+			} else {
+				std::map<PixelFormat, std::vector<SizeRange>> fmts;
+				fmts[formats::NV12] = { { kDepthSize, kDepthSize } };
+				fmts[formats::R16] = { { kDepthSize, kDepthSize } };
+
+				StreamConfiguration cfg(fmts);
+				cfg.pixelFormat = formats::NV12;
+				cfg.size = kDepthSize;
+				cfg.colorSpace = ColorSpace::Sycc;
+				cfg.bufferCount = kBufferCount;
+				config->addConfiguration(cfg);
+			}
+		}
+
+		if (config->validate() == CameraConfiguration::Invalid)
+			return nullptr;
+
+		return config;
+	}
+
+	int configure(CameraConfiguration *config)
+	{
+		auto *tofCfg = static_cast<TofCameraConfiguration *>(config);
+
+		processedConfigured_ = tofCfg->processedIndex_.has_value();
+		rawConfigured_ = tofCfg->rawIndex_.has_value();
+		processedFormat_ = tofCfg->processedFormat_;
+		rawSize_ = tofCfg->rawSize_;
+
+		if (tofCfg->processedIndex_) {
+			StreamConfiguration &cfg = config->at(*tofCfg->processedIndex_);
+			processedStride_ = cfg.stride;
+			cfg.setStream(&processedStream_);
+		}
+		if (tofCfg->rawIndex_) {
+			StreamConfiguration &cfg = config->at(*tofCfg->rawIndex_);
+			cfg.setStream(&rawStream_);
+		}
+
+		return 0;
+	}
+
+	int exportFrameBuffers(Stream *stream,
+			       std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+	{
+		const StreamConfiguration &cfg = stream->configuration();
+
+		if (stream == &rawStream_) {
+			int ret = video_->open();
+			if (ret < 0)
+				return ret;
+			auto closeVideo = utils::scope_exit{ [&]() { video_->close(); } };
+
+			V4L2DeviceFormat fmt;
+			fmt.fourcc = video_->toV4L2PixelFormat(formats::SBGGR12_CSI2P);
+			fmt.size = cfg.size;
+			fmt.colorSpace = ColorSpace::Raw;
+			ret = video_->setFormat(&fmt);
+			if (ret < 0)
+				return ret;
+
+			return video_->exportBuffers(cfg.bufferCount, buffers);
+		}
+
+		if (stream == &processedStream_) {
+			if (!dmaBufAllocator_.isValid()) {
+				LOG(QcomPipeline, Error)
+					<< "No DMA-BUF allocator available for ToF depth stream";
+				return -ENOBUFS;
+			}
+			const PixelFormatInfo &info = PixelFormatInfo::info(cfg.pixelFormat);
+			std::vector<unsigned int> planeSizes;
+			for (size_t i = 0; i < info.numPlanes(); ++i)
+				planeSizes.push_back(info.planeSize(cfg.size, i));
+			return dmaBufAllocator_.exportBuffers(cfg.bufferCount, planeSizes, buffers);
+		}
+
+		return -EINVAL;
+	}
+
+	int start(const ControlList *controls)
+	{
+		/*
+		 * Load Zwetschge/PMDJGF calibration while the sensor is idle:
+		 * the kernel nvmem driver rejects Flash reads during active streaming
+		 * and caches the 164 KB blob in RAM after the first read.
+		 */
+		if (!calibrationLoaded_) {
+			calibrationLoaded_ = true;
+			if (demodulator_.loadCalibrationFromSysfs()) {
+				LOG(QcomPipeline, Info)
+					<< "Loaded IRS2381C Zwetschge/PMDJGF calibration ("
+					<< demodulator_.serial() << ")";
+			} else {
+				LOG(QcomPipeline, Warning)
+					<< "IRS2381C calibration nvmem unavailable; "
+					<< "falling back to uncalibrated demodulation";
+			}
+		}
+
+		activeFps_ = selectFps(controls);
+
+		int ret = openCaptureDevices();
+		if (ret < 0)
+			return ret;
+
+		auto errorCleanup = utils::scope_exit{ [&]() {
+			video_->releaseBuffers();
+			internalRawBuffers_.clear();
+			freeRawBuffers_.clear();
+			pendingRequests_.clear();
+			teardownLinks();
+			closeCaptureDevices();
+		} };
+
+		ret = setupLinks();
+		if (ret < 0)
+			return ret;
+
+		ret = applyFormatsAndFps();
+		if (ret < 0)
+			return ret;
+
+		if (controls && controls->contains(controls::ExposureTime.id())) {
+			applyExposureUs(*controls->get(controls::ExposureTime));
+		} else {
+			applyExposureUs(defaultExposureUs_);
+		}
+
+		if (rawConfigured_) {
+			ret = video_->importBuffers(rawStream_.configuration().bufferCount);
+			if (ret < 0)
+				return ret;
+		} else {
+			ret = video_->allocateBuffers(kBufferCount, &internalRawBuffers_);
+			if (ret < 0)
+				return ret;
+			freeRawBuffers_.clear();
+			for (const auto &buf : internalRawBuffers_)
+				freeRawBuffers_.push_back(buf.get());
+		}
+
+		ret = video_->streamOn();
+		if (ret < 0)
+			return ret;
+
+		errorCleanup.release();
+		return 0;
+	}
+
+	void stopDevice()
+	{
+		video_->streamOff();
+
+		while (!pendingRequests_.empty()) {
+			Request *request = pendingRequests_.front();
+			pendingRequests_.pop_front();
+			if (FrameBuffer *procBuf = request->findBuffer(&processedStream_)) {
+				procBuf->_d()->metadata().status = FrameMetadata::FrameCancelled;
+				pipe()->completeBuffer(request, procBuf);
+			}
+			if (FrameBuffer *rawBuf = request->findBuffer(&rawStream_)) {
+				rawBuf->_d()->metadata().status = FrameMetadata::FrameCancelled;
+				pipe()->completeBuffer(request, rawBuf);
+			}
+			pipe()->completeRequest(request);
+		}
+
+		video_->releaseBuffers();
+		internalRawBuffers_.clear();
+		freeRawBuffers_.clear();
+		teardownLinks();
+		closeCaptureDevices();
+	}
+
+	int queueRequest(Request *request)
+	{
+		FrameBuffer *procBuf = request->findBuffer(&processedStream_);
+		FrameBuffer *userRawBuf = request->findBuffer(&rawStream_);
+		if (!procBuf && !userRawBuf)
+			return -ENOENT;
+
+		if (auto expUs = request->controls().get(controls::ExposureTime))
+			applyExposureUs(*expUs);
+
+		FrameBuffer *rawBuf = userRawBuf;
+		if (!rawBuf) {
+			if (freeRawBuffers_.empty())
+				return -ENOBUFS;
+			rawBuf = freeRawBuffers_.front();
+			freeRawBuffers_.pop_front();
+		}
+
+		pendingRequests_.push_back(request);
+		int ret = video_->queueBuffer(rawBuf);
+		if (ret < 0) {
+			pendingRequests_.pop_back();
+			if (!userRawBuf)
+				freeRawBuffers_.push_front(rawBuf);
+			return ret;
+		}
+
+		return 0;
+	}
+
+	Stream processedStream_;
+	Stream rawStream_;
+	std::map<Size, FormatGeometry> rawFormatCache_;
+
+private:
+	static int64_t boottimeOffsetNs()
+	{
+		struct timespec bootTime;
+		uint64_t before = std::chrono::duration_cast<std::chrono::nanoseconds>(
+					  utils::clock::now().time_since_epoch())
+					  .count();
+		if (clock_gettime(CLOCK_BOOTTIME, &bootTime))
+			return -errno;
+		uint64_t after = std::chrono::duration_cast<std::chrono::nanoseconds>(
+					 utils::clock::now().time_since_epoch())
+					 .count();
+		int64_t bootNs = static_cast<int64_t>(bootTime.tv_sec) * 1000000000LL +
+				 bootTime.tv_nsec;
+		int64_t mid = static_cast<int64_t>(before + (after - before) / 2);
+		return std::max<int64_t>(0, bootNs - mid);
+	}
+
+	unsigned int selectFps(const ControlList *controls) const
+	{
+		static constexpr std::array<unsigned int, 5> kFps9 = { 5, 10, 15, 24, 30 };
+		static constexpr std::array<unsigned int, 4> kFps5 = { 5, 10, 15, 30 };
+
+		unsigned int requested = 15;
+		if (controls) {
+			if (auto limits = controls->get(controls::FrameDurationLimits)) {
+				if (limits->size() >= 2 && (*limits)[0] > 0) {
+					double targetUs = (*limits)[0];
+					requested = static_cast<unsigned int>(
+						std::lround(1000000.0 / targetUs));
+				}
+			}
+		}
+
+		unsigned int best = 15;
+		unsigned int bestDiff = UINT32_MAX;
+		auto pick = [&](unsigned int candidate) {
+			unsigned int diff = candidate > requested ? candidate - requested
+								  : requested - candidate;
+			if (diff < bestDiff) {
+				bestDiff = diff;
+				best = candidate;
+			}
+		};
+
+		if (rawSize_ == kRaw5Size) {
+			for (unsigned int f : kFps5)
+				pick(f);
+		} else {
+			for (unsigned int f : kFps9)
+				pick(f);
+		}
+		return best;
+	}
+
+	int findPath(MediaEntity *sensor, MediaEntity *target)
+	{
+		path_.clear();
+		links_.clear();
+
+		std::map<MediaEntity *, std::pair<MediaEntity *, MediaLink *>> parents;
+		std::deque<MediaEntity *> queue;
+		parents[sensor] = { nullptr, nullptr };
+		queue.push_back(sensor);
+
+		while (!queue.empty()) {
+			MediaEntity *entity = queue.front();
+			queue.pop_front();
+			for (const MediaPad *pad : entity->pads()) {
+				if (!(pad->flags() & MEDIA_PAD_FL_SOURCE))
+					continue;
+				for (MediaLink *link : pad->links()) {
+					MediaEntity *next = link->sink()->entity();
+					if (parents.count(next))
+						continue;
+					parents[next] = { entity, link };
+					if (next == target)
+						break;
+					queue.push_back(next);
+				}
+			}
+		}
+
+		if (!parents.count(target))
+			return -ENODEV;
+
+		std::vector<MediaEntity *> entities;
+		std::vector<MediaLink *> links;
+		MediaEntity *cur = target;
+		while (cur != sensor) {
+			entities.push_back(cur);
+			links.push_back(parents[cur].second);
+			cur = parents[cur].first;
+		}
+		std::reverse(entities.begin(), entities.end());
+		std::reverse(links.begin(), links.end());
+
+		path_.push_back(sensor);
+		path_.insert(path_.end(), entities.begin(), entities.end());
+		links_ = std::move(links);
+		return 0;
+	}
+
+	int openCaptureDevices()
+	{
+		int ret = sensor_->open();
+		if (ret < 0)
+			return ret;
+
+		subdevs_.clear();
+		for (std::size_t i = 1; i < path_.size(); ++i) {
+			auto sd = std::make_unique<V4L2Subdevice>(path_[i]);
+			ret = sd->open();
+			if (ret < 0) {
+				closeCaptureDevices();
+				return ret;
+			}
+			subdevs_.push_back(std::move(sd));
+		}
+
+		ret = video_->open();
+		if (ret < 0) {
+			closeCaptureDevices();
+			return ret;
+		}
+		return 0;
+	}
+
+	void closeCaptureDevices()
+	{
+		if (video_ && video_->isOpen())
+			video_->close();
+		for (auto &sd : subdevs_) {
+			if (sd && sd->isOpen())
+				sd->close();
+		}
+		subdevs_.clear();
+		if (sensor_ && sensor_->isOpen())
+			sensor_->close();
+	}
+
+	int setupLinks()
+	{
+		auto disableOtherLinks = [](const MediaPad *pad, MediaLink *keep) -> int {
+			for (MediaLink *other : pad->links()) {
+				if (other == keep ||
+				    (other->flags() & MEDIA_LNK_FL_IMMUTABLE) ||
+				    !(other->flags() & MEDIA_LNK_FL_ENABLED))
+					continue;
+				int ret = other->setEnabled(false);
+				if (ret < 0)
+					return ret;
+			}
+			return 0;
+		};
+
+		for (MediaLink *link : links_) {
+			if (link->source()->entity() == csiphyEntity_) {
+				int ret = disableOtherLinks(link->source(), link);
+				if (ret < 0)
+					return ret;
+			}
+			int ret = disableOtherLinks(link->sink(), link);
+			if (ret < 0)
+				return ret;
+			if (!(link->flags() & MEDIA_LNK_FL_ENABLED)) {
+				ret = link->setEnabled(true);
+				if (ret < 0)
+					return ret;
+			}
+		}
+		return 0;
+	}
+
+	void teardownLinks()
+	{
+		for (auto it = links_.rbegin(); it != links_.rend(); ++it) {
+			MediaLink *link = *it;
+			if ((link->flags() & MEDIA_LNK_FL_IMMUTABLE) ||
+			    !(link->flags() & MEDIA_LNK_FL_ENABLED))
+				continue;
+			link->setEnabled(false);
+		}
+	}
+
+	int applyFormatsAndFps()
+	{
+		V4L2SubdeviceFormat fmt{};
+		fmt.code = MEDIA_BUS_FMT_SBGGR12_1X12;
+		fmt.size = rawSize_;
+
+		int ret = sensor_->setFormat(0, &fmt);
+		if (ret < 0)
+			return ret;
+
+		struct v4l2_subdev_frame_interval fi{};
+		fi.pad = 0;
+		fi.interval.numerator = 1;
+		fi.interval.denominator = activeFps_;
+		ret = sensor_->ioctl(VIDIOC_SUBDEV_S_FRAME_INTERVAL, &fi);
+		if (ret == 0 && fi.interval.numerator > 0 && fi.interval.denominator > 0)
+			activeFps_ = fi.interval.denominator / fi.interval.numerator;
+
+		/* Refresh eye-safety exposure bounds for the active use case. */
+		sensor_->updateControlInfo();
+		const ControlInfoMap &sensorCtrls = sensor_->controls();
+		if (sensorCtrls.count(V4L2_CID_EXPOSURE)) {
+			const ControlInfo &expInfo = sensorCtrls.at(V4L2_CID_EXPOSURE);
+			exposureMinUs_ = expInfo.min().get<int32_t>();
+			exposureMaxUs_ = expInfo.max().get<int32_t>();
+			defaultExposureUs_ = expInfo.def().get<int32_t>();
+			const std::array<uint32_t, 1> ids{ V4L2_CID_EXPOSURE };
+			ControlList vals = sensor_->getControls(ids);
+			if (vals.contains(V4L2_CID_EXPOSURE))
+				currentExposureUs_ = vals.get(V4L2_CID_EXPOSURE).get<int32_t>();
+			else
+				currentExposureUs_ = defaultExposureUs_;
+		}
+
+		for (std::size_t i = 0; i < subdevs_.size(); ++i) {
+			V4L2Subdevice *sd = subdevs_[i].get();
+			const MediaEntity *ent = path_[i + 1];
+
+			V4L2SubdeviceFormat padFmt = fmt;
+			ret = sd->setFormat(0, &padFmt);
+			if (ret < 0)
+				return ret;
+
+			/* Propagate format to source pad on intermediate entities (CSIPHY, CSID). */
+			if (ent != rdiEntity_) {
+				V4L2SubdeviceFormat srcFmt = padFmt;
+				ret = sd->setFormat(1, &srcFmt);
+				if (ret < 0)
+					return ret;
+			}
+		}
+
+		V4L2DeviceFormat devFmt{};
+		devFmt.fourcc = video_->toV4L2PixelFormat(formats::SBGGR12_CSI2P);
+		devFmt.size = rawSize_;
+		devFmt.colorSpace = ColorSpace::Raw;
+		return video_->setFormat(&devFmt);
+	}
+
+	void applyExposureUs(int32_t exposureUs)
+	{
+		int32_t clamped = std::clamp(exposureUs, exposureMinUs_, exposureMaxUs_);
+		if (clamped == currentExposureUs_)
+			return;
+
+		ControlList ctrls(sensor_->controls());
+		ctrls.set(V4L2_CID_EXPOSURE, clamped);
+		if (sensor_->setControls(&ctrls) == 0)
+			currentExposureUs_ = clamped;
+	}
+
+	void rawBufferReady(FrameBuffer *rawBuffer)
+	{
+		if (pendingRequests_.empty())
+			return;
+
+		Request *request = pendingRequests_.front();
+		pendingRequests_.pop_front();
+
+		FrameBuffer *procBuf = request->findBuffer(&processedStream_);
+		FrameBuffer *userRawBuf = request->findBuffer(&rawStream_);
+		const FrameMetadata::Status status = rawBuffer->metadata().status;
+
+		if (status != FrameMetadata::FrameSuccess) {
+			if (procBuf) {
+				procBuf->_d()->metadata().status = status;
+				pipe()->completeBuffer(request, procBuf);
+			}
+			if (userRawBuf)
+				pipe()->completeBuffer(request, userRawBuf);
+			else
+				freeRawBuffers_.push_back(rawBuffer);
+			pipe()->completeRequest(request);
+			return;
+		}
+
+		TofFrameResult res{};
+		bool haveTemp = false;
+		float tempC = 0.0f;
+
+		{
+			DmaSyncer rawSync(rawBuffer->planes()[0].fd, DmaSyncer::SyncType::Read);
+			MappedFrameBuffer rawMap(rawBuffer, MappedFrameBuffer::MapFlag::Read);
+			if (rawMap.isValid() && !rawMap.planes().empty()) {
+				const uint8_t *rawData = rawMap.planes()[0].data();
+				const size_t rawBytes = rawMap.planes()[0].size();
+
+				if (procBuf) {
+					DmaSyncer procSync(procBuf->planes()[0].fd,
+							   DmaSyncer::SyncType::Write);
+					MappedFrameBuffer procMap(
+						procBuf, MappedFrameBuffer::MapFlag::Write);
+					if (procMap.isValid() && !procMap.planes().empty()) {
+						if (processedFormat_ == formats::R16) {
+							auto *dst = reinterpret_cast<uint16_t *>(
+								procMap.planes()[0].data());
+							res = demodulator_.demodulate(
+								rawData, rawBytes, dst,
+								nullptr, 0, nullptr, 0);
+						} else if (procMap.planes().size() >= 2) {
+							res = demodulator_.demodulate(
+								rawData, rawBytes, nullptr,
+								procMap.planes()[0].data(),
+								processedStride_,
+								procMap.planes()[1].data(),
+								processedStride_);
+						}
+						haveTemp = res.temperatureMeasured;
+						tempC = res.temperatureC;
+					}
+				} else {
+					haveTemp = demodulator_.measureTemperature(
+						rawData, rawBytes, tempC);
+				}
+			}
+		}
+
+		if (procBuf) {
+			FrameMetadata &meta = procBuf->_d()->metadata();
+			meta.status = res.eyeSafetyError ? FrameMetadata::FrameError
+							 : FrameMetadata::FrameSuccess;
+			meta.sequence = rawBuffer->metadata().sequence;
+			meta.timestamp = rawBuffer->metadata().timestamp;
+			Span<const FrameBuffer::Plane> planes = procBuf->planes();
+			for (const auto [i, p] : utils::enumerate(planes))
+				meta.planes()[i].bytesused = p.length;
+		}
+
+		ControlList &metadata = request->_d()->metadata();
+		int64_t offset = boottimeOffsetNs();
+		if (offset >= 0)
+			metadata.set(controls::SensorTimestamp,
+				     rawBuffer->metadata().timestamp +
+					     static_cast<uint64_t>(offset));
+		metadata.set(controls::ExposureTime, currentExposureUs_);
+		const int64_t frameDurUs = 1000000LL / std::max<unsigned int>(activeFps_, 1);
+		metadata.set(controls::FrameDuration, frameDurUs);
+		metadata.set(controls::FrameDurationLimits, { frameDurUs, frameDurUs });
+		if (haveTemp)
+			metadata.set(controls::SensorTemperature, tempC);
+
+		if (procBuf)
+			pipe()->completeBuffer(request, procBuf);
+		if (userRawBuf)
+			pipe()->completeBuffer(request, userRawBuf);
+		else
+			freeRawBuffers_.push_back(rawBuffer);
+
+		pipe()->completeRequest(request);
+	}
+
+	std::shared_ptr<MediaDevice> media_;
+	DmaBufAllocator dmaBufAllocator_;
+	MediaEntity *sensorEntity_ = nullptr;
+	MediaEntity *csiphyEntity_ = nullptr;
+	MediaEntity *rdiEntity_ = nullptr;
+	std::vector<MediaEntity *> path_;
+	std::vector<MediaLink *> links_;
+
+	std::unique_ptr<V4L2Subdevice> sensor_;
+	std::vector<std::unique_ptr<V4L2Subdevice>> subdevs_;
+	std::unique_ptr<V4L2VideoDevice> video_;
+
+	TofDemodulator demodulator_;
+	bool calibrationLoaded_ = false;
+
+	bool processedConfigured_ = true;
+	bool rawConfigured_ = false;
+	PixelFormat processedFormat_ = formats::NV12;
+	unsigned int processedStride_ = 224;
+	Size rawSize_ = kRaw9Size;
+	unsigned int activeFps_ = 15;
+	int32_t exposureMinUs_ = 100;
+	int32_t exposureMaxUs_ = 2020;
+	int32_t defaultExposureUs_ = 710;
+	int32_t currentExposureUs_ = 710;
+
+	std::vector<std::unique_ptr<FrameBuffer>> internalRawBuffers_;
+	std::deque<FrameBuffer *> freeRawBuffers_;
+	std::deque<Request *> pendingRequests_;
+};
+
+inline CameraConfiguration::Status TofCameraConfiguration::validate()
+{
+	Status status = Valid;
+	processedIndex_.reset();
+	rawIndex_.reset();
+
+	if (config_.empty())
+		return Invalid;
+
+	if (orientation != Orientation::Rotate0) {
+		orientation = Orientation::Rotate0;
+		status = Adjusted;
+	}
+
+	std::vector<StreamConfiguration> kept;
+	for (const StreamConfiguration &cfg : config_) {
+		const PixelFormatInfo &info = PixelFormatInfo::info(cfg.pixelFormat);
+		const bool isRaw = info.isValid() &&
+				   info.colourEncoding == PixelFormatInfo::ColourEncodingRAW &&
+				   cfg.pixelFormat != formats::R16;
+		if (isRaw) {
+			if (rawIndex_) {
+				status = Adjusted;
+				continue;
+			}
+			rawIndex_ = kept.size();
+			kept.push_back(cfg);
+		} else {
+			if (processedIndex_) {
+				status = Adjusted;
+				continue;
+			}
+			processedIndex_ = kept.size();
+			kept.push_back(cfg);
+		}
+	}
+	if (kept.size() != config_.size()) {
+		config_ = std::move(kept);
+		status = Adjusted;
+	}
+	if (config_.empty())
+		return Invalid;
+
+	rawSize_ = TofCameraData::kRaw9Size;
+
+	if (processedIndex_) {
+		StreamConfiguration &cfg = config_[*processedIndex_];
+		if (cfg.pixelFormat != formats::NV12 && cfg.pixelFormat != formats::R16) {
+			cfg.pixelFormat = formats::NV12;
+			status = Adjusted;
+		}
+		processedFormat_ = cfg.pixelFormat;
+
+		if (cfg.size != TofCameraData::kDepthSize) {
+			cfg.size = TofCameraData::kDepthSize;
+			status = Adjusted;
+		}
+
+		const ColorSpace expectedCs =
+			cfg.pixelFormat == formats::R16 ? ColorSpace::Raw : ColorSpace::Sycc;
+		if (cfg.colorSpace != expectedCs) {
+			cfg.colorSpace = expectedCs;
+			status = Adjusted;
+		}
+
+		if (cfg.bufferCount != TofCameraData::kBufferCount) {
+			cfg.bufferCount = TofCameraData::kBufferCount;
+			status = Adjusted;
+		}
+
+		const PixelFormatInfo &info = PixelFormatInfo::info(cfg.pixelFormat);
+		cfg.stride = info.stride(cfg.size.width, 0, 1);
+		cfg.frameSize = info.frameSize(cfg.size, 1);
+	}
+
+	if (rawIndex_) {
+		StreamConfiguration &cfg = config_[*rawIndex_];
+		if (cfg.pixelFormat != formats::SBGGR12_CSI2P) {
+			cfg.pixelFormat = formats::SBGGR12_CSI2P;
+			status = Adjusted;
+		}
+
+		Size target = TofCameraData::kRaw9Size;
+		if (cfg.size.height > 0 && cfg.size.height <= 1557 &&
+		    data_->rawFormatCache_.count(TofCameraData::kRaw5Size))
+			target = TofCameraData::kRaw5Size;
+		if (!data_->rawFormatCache_.count(target))
+			target = data_->rawFormatCache_.begin()->first;
+
+		rawSize_ = target;
+		if (cfg.size != target) {
+			cfg.size = target;
+			status = Adjusted;
+		}
+
+		if (cfg.colorSpace != ColorSpace::Raw) {
+			cfg.colorSpace = ColorSpace::Raw;
+			status = Adjusted;
+		}
+
+		if (cfg.bufferCount != TofCameraData::kBufferCount) {
+			cfg.bufferCount = TofCameraData::kBufferCount;
+			status = Adjusted;
+		}
+
+		const auto &geom = data_->rawFormatCache_.at(target);
+		cfg.stride = geom.stride;
+		cfg.frameSize = geom.frameSize;
+	}
+
+	return status;
+}
+
