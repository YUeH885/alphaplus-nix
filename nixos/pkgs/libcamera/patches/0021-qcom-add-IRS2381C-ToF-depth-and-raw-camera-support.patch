 #include "imx363_tuning.h"
 #include "imx520_tuning.h"
+#include "tof_camera.h"
 
 namespace libcamera {
 
@@ -1394,6 +1395,16 @@ private:
 		return static_cast<QcomCameraData *>(camera->_d());
 	}
 
+	bool isTofCamera(const Camera *camera) const
+	{
+		return tofCameras_.count(camera) != 0;
+	}
+
+	TofCameraData *tofCameraData(Camera *camera)
+	{
