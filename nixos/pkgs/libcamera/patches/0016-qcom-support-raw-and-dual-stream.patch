+int64_t boottimeOffsetNs()
+{
+	uint64_t bestSpan = UINT64_MAX;
+	int64_t offset = 0;
+	for (unsigned int attempt = 0; attempt < 5; ++attempt) {
+		struct timespec bootTime;
+		uint64_t before = monotonicNs();
+		if (clock_gettime(CLOCK_BOOTTIME, &bootTime))
+			return -errno;
+		uint64_t after = monotonicNs();
+		uint64_t span = after >= before ? after - before : UINT64_MAX;
+		if (span < bestSpan) {
+			bestSpan = span;
+			int64_t bootNs = static_cast<int64_t>(bootTime.tv_sec) * 1000000000LL +
+					 bootTime.tv_nsec;
+			int64_t mid = static_cast<int64_t>(before + span / 2);
+			offset = std::max<int64_t>(0, bootNs - mid);
+			if (bestSpan < 20000)
+				break;
+		}
+	}
+	return offset;
+}
+
+Size selectPixInputSize(const SensorProfile &profile, const std::string &sensorModel,
+			const Size &pixSize)
+{
+	if (profile.fullResolutionOutput && pixSize == profile.outputSizes[0])
+		return profile.fullInputSize;
+	if (pixSize.width * 3 == pixSize.height * 4) {
+		if (sensorModel == "imx520")
+			return { 1640, 1232 };
+		if (profile.fullResolutionOutput)
+			return profile.fullInputSize;
+	}
+	return profile.nativeInputSize;
+}
+
+Size closestSize(Span<const Size> sizes, const Size &requested)
+{
+	auto distance = [&requested](const Size &candidate) {
+		double dx = static_cast<double>(candidate.width) / requested.width - 1.0;
+		double dy = static_cast<double>(candidate.height) / requested.height - 1.0;
+		return dx * dx + dy * dy;
+	};
+	return *std::min_element(sizes.begin(), sizes.end(),
+				 [&distance](const Size &a, const Size &b) {
+					 return distance(a) < distance(b);
+				 });
+}
+
+bool isRawPixelFormat(PixelFormat format)
+{
+	const PixelFormatInfo &info = PixelFormatInfo::info(format);
+	return info.isValid() && info.colourEncoding == PixelFormatInfo::ColourEncodingRAW;
+}
