+
+std::pair<double, double> QcomCameraData::quantizedExposureForFlicker(double exposure, double gain) const
+{
+	if (!aeEnabled_ || flickerMode_ != controls::FlickerManual || !flickerPeriod_)
+		return { exposure, gain };
+
+	double period = flickerPeriod_ * 1000.0 / lineDurationNs_;
+	if (exposure < period || exposureMax_ < period)
+		return { exposure, gain };
+
+	double maxPeriods = std::floor(exposureMax_ / period);
+	double periods = std::clamp(std::round(exposure / period), 1.0, maxPeriods);
+	double quantized = std::clamp(std::round(periods * period),
+				      static_cast<double>(exposureMin_),
+				      static_cast<double>(exposureMax_));
+	double adjustedGain = std::clamp(gain * exposure / quantized, gainMin_, gainMax_);
+	return { quantized, adjustedGain };
+}
+
+int64_t QcomCameraData::frameDurationUs(int32_t lines) const
+{
+	return std::llround(lines * lineDurationNs_ / 1000.0);
+}
+
+void QcomCameraData::setFrameDurationLimits(Span<const int64_t, 2> durations)
+{
+	auto toLines = [this](int64_t duration) {
+		duration = std::clamp(duration, frameDurationUs(minFrameLines_), frameDurationUs(maxFrameLines_));
+		return std::clamp(static_cast<int32_t>(std::llround(duration * 1000.0 / lineDurationNs_)),
+				  minFrameLines_, maxFrameLines_);
+	};
+	int32_t min = toLines(durations[0]);
+	int32_t max = std::max(min, toLines(durations[1]));
+	frameLengthLimits_ = { min, max };
+	exposureMax_ = max - exposureMargin_;
+}
