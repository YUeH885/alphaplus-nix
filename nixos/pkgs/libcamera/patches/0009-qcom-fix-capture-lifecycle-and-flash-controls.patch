+inline LgAwbRatios lgAwbRatiosForTemperature(const LgAwbColour &colour, int32_t cct)
+{
+	const auto &locus = colour.ideal();
+	const auto &nominal = colour.nominalRgb();
+	LgAwbRatios nearest = nominal.front();
+	int nearestDistance = std::numeric_limits<int>::max();
+	for (unsigned int i = 0; i < locus.size(); ++i) {
+		int temperature = lgAwbColourTemperature(locus[i]);
+		int distance = std::abs(temperature - cct);
+		if (distance < nearestDistance) {
+			nearestDistance = distance;
+			nearest = nominal[i];
+		}
+		if (i + 1 == locus.size())
+			break;
+
+		int nextTemperature = lgAwbColourTemperature(locus[i + 1]);
+		if (temperature == nextTemperature ||
+		    cct < std::min(temperature, nextTemperature) ||
+		    cct > std::max(temperature, nextTemperature))
+			continue;
+
+		float factor = static_cast<float>(cct - temperature) / (nextTemperature - temperature);
+		return { std::lerp(nominal[i].red, nominal[i + 1].red, factor),
+			 std::lerp(nominal[i].blue, nominal[i + 1].blue, factor) };
+	}
+	return nearest;
+}
