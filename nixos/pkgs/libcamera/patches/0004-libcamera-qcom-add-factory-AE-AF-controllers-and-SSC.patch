+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <future>
+#include <mutex>
+#include <thread>
+
+struct _GMainContext;
+struct _GMainLoop;
+
+namespace libcamera::qcom {
+
+class SscAccelerometer
+{
+public:
+	SscAccelerometer();
+	~SscAccelerometer();
+
+	int start();
+	void stop();
+	std::array<float, 3> sample() const;
+
+private:
+	struct State;
+	void run(std::promise<int> ready);
+	static void measured(void *sensor, float x, float y, float z, void *data);
+	static int timedOut(void *data);
+
+	_GMainContext *context_;
+	_GMainLoop *loop_;
+	std::thread thread_;
+	mutable std::mutex mutex_;
+	std::array<float, 3> sample_{};
+};
