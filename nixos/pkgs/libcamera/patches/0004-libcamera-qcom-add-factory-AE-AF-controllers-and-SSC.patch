diff --git a/src/libcamera/pipeline/qcom/s5k3m5.h b/src/libcamera/pipeline/qcom/s5k3m5.h
new file mode 100644
index 0000000..2d158fe
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/s5k3m5.h
@@ -0,0 +1,427 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace libcamera::qcom {
+
+/* PIX image and statistics DMA complete one CAMIF SOF after their input frame. */
+inline uint32_t inputSequence(uint32_t completedSequence)
+{
+	return completedSequence ? completedSequence - 1 : 0;
+}
+
+struct CcmEntry {
+	unsigned int cct;
+	int16_t q7[9];
+};
+
+struct CctReference {
+	double cct;
+	double rg;
+	double bg;
+};
+
+#include "s5k3m5_tuning.h"
+
+/* The factory luma target is an 8-bit code; statistics use 10 bits. */
+constexpr double kAeTargetScale = 4.0;
+constexpr double kLgAfLowLightLuma8 = 17.0;
+
+inline bool lgAfLowLight(double luma10)
+{
+	return luma10 < kLgAfLowLightLuma8 * kAeTargetScale;
+}
+
+class LgAfSearchStats
+{
+public:
+	void reset()
+	{
+		previousScore_ = 0.0;
+		previousFocus_ = 0;
+		riseStartFocus_ = 0;
+		minimumFocus_ = 0;
+		maximumScore_ = 0;
+		maximumRise_ = 0.0;
+		upCount_ = 0;
+		downCount_ = 0;
+		sampleCount_ = 0;
+		reversalCount_ = 0;
+	}
+
+	bool update(double score, bool lowLight)
+	{
+		/* LG compares raw scores, but computes ratios from float-to-int FV >> 4. */
+		uint64_t raw = static_cast<uint64_t>(static_cast<float>(score));
+		uint64_t focus = raw >> 4;
+		if (!sampleCount_) {
+			minimumFocus_ = focus;
+		} else {
+			minimumFocus_ = std::min(minimumFocus_, focus);
+			if (score > previousScore_) {
+				if (!upCount_)
+					riseStartFocus_ = previousFocus_;
+				if (downCount_)
+					reversalCount_++;
+				upCount_++;
+				downCount_ = 0;
+				double rise = static_cast<double>(focus - riseStartFocus_) /
+					std::max<uint64_t>(focus, 1);
+				maximumRise_ = std::max(maximumRise_, rise);
+			} else {
+				if (upCount_)
+					reversalCount_++;
+				downCount_++;
+				upCount_ = 0;
+			}
+		}
+		maximumScore_ = std::max(maximumScore_, raw);
+		sampleCount_++;
+		previousScore_ = score;
+		previousFocus_ = focus;
+
+		return downCount_ >= (lowLight ? 3U : 4U) ||
+		       (downCount_ > 2 && focusRange() > 0.1) ||
+		       (upCount_ > 2 && maximumRise_ < 0.01) ||
+		       (sampleCount_ >= 9 && reversalCount_ >= 6);
+	}
+
+	unsigned int upCount() const { return upCount_; }
+	unsigned int downCount() const { return downCount_; }
+	unsigned int sampleCount() const { return sampleCount_; }
+	unsigned int reversalCount() const { return reversalCount_; }
+	double maximumRise() const { return maximumRise_; }
+	uint64_t peakScore() const { return maximumScore_; }
+	double focusRange() const
+	{
+		uint64_t maximum = maximumScore_ >> 4;
+		return static_cast<double>(maximum - minimumFocus_) /
+		       std::max<uint64_t>(maximum, 1);
+	}
+
+private:
+	double previousScore_ = 0.0;
+	uint64_t previousFocus_ = 0;
+	uint64_t riseStartFocus_ = 0;
+	uint64_t minimumFocus_ = 0;
+	uint64_t maximumScore_ = 0;
+	double maximumRise_ = 0.0;
+	unsigned int upCount_ = 0;
+	unsigned int downCount_ = 0;
+	unsigned int sampleCount_ = 0;
+	unsigned int reversalCount_ = 0;
+};
+
+struct LgAfResult {
+	unsigned int fineSamples;
+	uint64_t peakScore;
+	double focusRange;
+	double maximumRise;
+};
+
+inline bool lgAfScanSucceeded(const LgAfResult &result, int position,
+			     int position200mm, int position700mm)
+{
+	if (!result.peakScore || result.fineSamples > 30)
+		return false;
+
+	bool outside = position < position200mm || position > position700mm;
+	return !(outside && result.peakScore > 2000 &&
+		 result.focusRange < 0.1f && result.maximumRise < 0.015f);
+}
+
+class LgAfSceneChange
+{
+public:
+	void reset()
+	{
+		previousScore_.reset();
+		unstable_ = false;
+		stableCount_ = 0;
+	}
+
+	bool update(double score)
+	{
+		uint64_t current = static_cast<uint64_t>(static_cast<float>(score)) >> 4;
+		if (!previousScore_) {
+			previousScore_ = current;
+			return false;
+		}
+
+		uint64_t previous = *previousScore_;
+		previousScore_ = current;
+		uint64_t maximum = std::max<uint64_t>({ current, previous, 1 });
+		double change = static_cast<double>(
+			current > previous ? current - previous : previous - current) / maximum;
+
+		if (change > 0.50) {
+			unstable_ = true;
+			stableCount_ = 0;
+			return false;
+		}
+
+		if (!unstable_)
+			return false;
+
+		if (change < 0.1f) {
+			if (++stableCount_ >= 4) {
+				unstable_ = false;
+				stableCount_ = 0;
+				return true;
+			}
+		} else {
+			stableCount_ = 0;
+		}
+
+		return false;
+	}
+
+	bool unstable() const { return unstable_; }
+	unsigned int stableCount() const { return stableCount_; }
+
+private:
+	std::optional<uint64_t> previousScore_;
+	bool unstable_ = false;
+	unsigned int stableCount_ = 0;
+};
+
+class LgAfModel
+{
+public:
+	static constexpr std::size_t kEepromBlockSize = 14;
+	static constexpr double kLensPositionMin = 0.0;
+	static constexpr std::size_t eepromOffset(unsigned int cameraId)
+	{
+		return cameraId == 1 ? 0x0400 : 0x0a80;
+	}
+
+	static std::optional<LgAfModel>
+	fromEeprom(unsigned int cameraId,
+		   const std::array<uint8_t, kEepromBlockSize> &block,
+		   std::string *error)
+	{
+		auto fail = [error](const std::string &message) {
+			if (error)
+				*error = message;
+			return std::optional<LgAfModel>{};
+		};
+
+		if (cameraId != 0 && cameraId != 1 && cameraId != 3)
+			return fail("unsupported LG camera ID " +
+				    std::to_string(cameraId));
+
+		std::size_t checksumOffset = cameraId == 0 ? 12 : 4;
+		uint16_t storedChecksum = block[checksumOffset] |
+					  block[checksumOffset + 1] << 8;
+		uint16_t calculatedChecksum = 0;
+		for (std::size_t i = 0; i < checksumOffset; i++)
+			calculatedChecksum += block[i];
+		if (storedChecksum != calculatedChecksum)
+			return fail("EEPROM AF checksum mismatch");
+
+		int16_t infinityDac = static_cast<int16_t>(block[0] | block[1] << 8);
+		int16_t macroDac = static_cast<int16_t>(block[2] | block[3] << 8);
+		int infinityQ = (infinityDac + 1023) / 2;
+		int macroQ = (macroDac + 1023) / 2;
+		if (infinityQ < 0 || infinityQ > 1023 ||
+		    macroQ < 0 || macroQ > 1023 || macroQ <= infinityQ)
+			return fail("invalid EEPROM AF endpoints");
+
+		LgAfModel model;
+		model.cameraId_ = cameraId;
+		model.checksum_ = storedChecksum;
+		model.rawInfinityDac_ = infinityDac;
+		model.rawMacroDac_ = macroDac;
+		if (cameraId == 0) {
+			model.focalLengthMm_ = 4.230000019073486;
+			model.calibrationDistanceMm_ = 100.0;
+			model.nearDistanceMm_ = 80.0;
+			model.stepFraction_ = 0.023399999365210533f;
+			infinityQ -= 30;
+			macroQ -= 30;
+		} else if (cameraId == 1) {
+			model.focalLengthMm_ = 2.9200000762939453;
+			model.calibrationDistanceMm_ = 150.0;
+			model.nearDistanceMm_ = 150.0;
+			model.stepFraction_ = 0.023399999365210533f;
+		} else {
+			model.focalLengthMm_ = 5.849999904632568;
+			model.calibrationDistanceMm_ = 400.0;
+			model.nearDistanceMm_ = 400.0;
+			model.stepFraction_ = 0.029999999329447746f;
+			/* Camera ID 3 uses the factory type-3 infinity extension. */
+			infinityQ = std::max(0, static_cast<int>(
+				static_cast<float>(infinityQ) -
+				static_cast<float>(macroQ - infinityQ) * 0.1644f));
+		}
+		model.infinityPosition_ = 1024 - infinityQ;
+		model.macroPosition_ = 1024 - macroQ;
+		model.updateBounds();
+
+		int span = macroQ - infinityQ;
+		model.coarseStepNormal_ = static_cast<unsigned int>(
+			static_cast<float>(3.0f * model.stepFraction_) * span);
+		model.fineStepNormal_ = static_cast<unsigned int>(model.stepFraction_ * span);
+		model.coarseStepLowLight_ = static_cast<unsigned int>(
+			static_cast<float>(6.0f * model.stepFraction_) * span);
+		model.fineStepLowLight_ = static_cast<unsigned int>(
+			static_cast<float>(2.0f * model.stepFraction_) * span);
+		if (model.infinityPosition_ > 1023 ||
+		    model.macroPosition_ < 0 ||
+		    model.nearPosition_ >= model.farPosition_ ||
+		    !model.coarseStepNormal_ || !model.fineStepNormal_ ||
+		    !model.coarseStepLowLight_ || !model.fineStepLowLight_)
+			return fail("invalid LG AF model");
+
+		return model;
+	}
+
+	unsigned int cameraId() const { return cameraId_; }
+	uint16_t checksum() const { return checksum_; }
+	int rawInfinityDac() const { return rawInfinityDac_; }
+	int rawMacroDac() const { return rawMacroDac_; }
+	int infinityPosition() const
+	{
+		return std::clamp(infinityPosition_ - gravityOffset_, 0, 1023);
+	}
+	int nearPosition() const { return nearPosition_; }
+	int farPosition() const { return farPosition_; }
+	int codeMin() const { return positionToCode(farPosition_); }
+	int codeMax() const { return positionToCode(nearPosition_); }
+	int infinityCode() const { return positionToCode(infinityPosition()); }
+	double lensPositionMax() const { return 1000.0 / nearDistanceMm_; }
+	int gravityOffset() const { return gravityOffset_; }
+	int gravityTrackingThreshold() const
+	{
+		return static_cast<int>(static_cast<double>(
+			static_cast<float>(infinityPosition_ - macroPosition_) * stepFraction_) + 0.5);
+	}
+
+	void setAcceleration(float x, float y, float z)
+	{
+		double norm = std::sqrt(static_cast<double>(
+			std::fma(z, z, std::fma(x, x, y * y))));
+		double reference = norm >= 9.0 && norm <= 11.0 ? norm : 9.80665;
+		/* LG maps the SSC vector to (-x, y, -z) before projecting gravity. */
+		gravityOffset_ = cameraId_ == 0
+			? static_cast<int>(-static_cast<double>(z) / reference * 30) : 0;
+		updateBounds();
+	}
+	unsigned int nearStep() const { return 0; }
+	unsigned int farStep() const { return farPosition_ - nearPosition_; }
+	unsigned int stepCount() const { return farStep() + 1; }
+	unsigned int coarseStep(bool lowLight = false) const
+	{
+		return lowLight ? coarseStepLowLight_ : coarseStepNormal_;
+	}
+	unsigned int fineStep(bool lowLight = false) const
+	{
+		return lowLight ? fineStepLowLight_ : fineStepNormal_;
+	}
+
+	double lensPositionFromCode(int code) const
+	{
+		int position = codeToPosition(std::clamp(code, codeMin(), codeMax()));
+		if (position <= nearPosition_)
+			return lensPositionMax();
+		if (position >= infinityPosition())
+			return kLensPositionMin;
+
+		double distance = focalLengthMm_ +
+			(calibrationDistanceMm_ - focalLengthMm_) *
+			(infinityPosition_ - macroPosition_) /
+			(infinityPosition_ - position - gravityOffset_);
+		return std::clamp(1000.0 / distance,
+				  kLensPositionMin, lensPositionMax());
+	}
+
+	int lensPositionToCode(double position) const
+	{
+		position = std::clamp(position, kLensPositionMin, lensPositionMax());
+		if (position <= kLensPositionMin)
+			return infinityCode();
+		if (position >= lensPositionMax())
+			return codeMax();
+
+		double distance = 1000.0 / position;
+		if (distance <= nearDistanceMm_)
+			return codeMax();
+
+		return positionToCode(positionForDistance(distance));
+	}
+
+	int afStepToCode(unsigned int step) const
+	{
+		step = std::min(step, farStep());
+		return positionToCode(nearPosition_ + step);
+	}
+
+	unsigned int afCodeToStep(int code) const
+	{
+		int position = codeToPosition(std::clamp(code, codeMin(), codeMax()));
+		return std::clamp(position - nearPosition_, 0,
+				  static_cast<int>(farStep()));
+	}
+
+	int positionForDistance(double distance) const
+	{
+		double displacement = focalLengthMm_ * focalLengthMm_ /
+				      (distance - focalLengthMm_);
+		double reference = focalLengthMm_ * focalLengthMm_ /
+				   (calibrationDistanceMm_ - focalLengthMm_);
+		return std::clamp(static_cast<int>(std::fma(
+			-static_cast<double>(infinityPosition_ - macroPosition_),
+			displacement / reference, static_cast<double>(infinityPosition_))) -
+			gravityOffset_, 0, 1023);
+	}
+
+private:
+	static constexpr double kFarDistanceMm = 10000.0;
+
+	void updateBounds()
+	{
+		nearPosition_ = std::max(1, positionForDistance(nearDistanceMm_));
+		int farTarget = positionForDistance(kFarDistanceMm);
+		int farMargin = static_cast<int>(static_cast<float>(farTarget - nearPosition_) * 0.08f);
+		int candidate = farTarget + farMargin;
+		/* The factory endpoint allows 1024 and maps overflow to 1023. */
+		farPosition_ = candidate > 1024 ? 1023 : candidate;
+	}
+
+	static int codeToPosition(int code)
+	{
+		return 1024 - (code + 1023) / 2;
+	}
+
+	static int positionToCode(int position)
+	{
+		return 2 * (1024 - position) - 1023;
+	}
+
+	unsigned int cameraId_ = 0;
+	uint16_t checksum_ = 0;
+	int rawInfinityDac_ = 0;
+	int rawMacroDac_ = 0;
+	double focalLengthMm_ = 0.0;
+	double calibrationDistanceMm_ = 0.0;
+	double nearDistanceMm_ = 0.0;
+	int gravityOffset_ = 0;
+	float stepFraction_ = 0.0f;
+	int infinityPosition_ = 0;
+	int macroPosition_ = 0;
+	int nearPosition_ = 0;
+	int farPosition_ = 0;
+	unsigned int coarseStepNormal_ = 0;
+	unsigned int fineStepNormal_ = 0;
+	unsigned int coarseStepLowLight_ = 0;
+	unsigned int fineStepLowLight_ = 0;
+};
+
+} /* namespace libcamera::qcom */
