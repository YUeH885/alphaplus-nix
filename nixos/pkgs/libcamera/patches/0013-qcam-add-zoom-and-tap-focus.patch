 int MainWindow::queueRequest(Request *request)
 {
+	ControlList &controls = request->controls();
+	if (zoom_->isEnabled()) {
+		const unsigned int width = maximumCrop_.width / zoom_->value();
+		const unsigned int height = maximumCrop_.height / zoom_->value();
+		const int x = maximumCrop_.x + static_cast<int>((maximumCrop_.width - width) / 2);
+		const int y = maximumCrop_.y + static_cast<int>((maximumCrop_.height - height) / 2);
+		controls.set(controls::ScalerCrop, Rectangle(x, y, width, height));
+	}
+
+	if (pendingFocus_) {
+		controls.set(controls::AfMode, controls::AfModeAuto);
+		controls.set(controls::AfMetering, controls::AfMeteringWindows);
+		controls.set(controls::AfWindows, Span<const Rectangle>(&*pendingFocus_, 1));
+		controls.set(controls::AfTrigger, controls::AfTriggerStart);
