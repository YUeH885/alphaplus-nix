+bool MainWindow::eventFilter(QObject *watched, QEvent *event)
+{
+	if (watched != centralWidget() || event->type() != QEvent::MouseButtonRelease ||
+	    !isCapturing_ || !tapFocusEnabled_ || !previewCrop_.width || !previewCrop_.height)
+		return QMainWindow::eventFilter(watched, event);
+
+	const auto *mouse = static_cast<QMouseEvent *>(event);
+	const Size &size = vfStream_->configuration().size;
+	const QSize frame = QSize(size.width, size.height)
+				    .scaled(centralWidget()->size(), Qt::KeepAspectRatio);
+	QRect visible(QPoint{}, frame);
+	visible.moveCenter(centralWidget()->rect().center());
+	if (mouse->button() != Qt::LeftButton || !visible.contains(mouse->position().toPoint()))
+		return QMainWindow::eventFilter(watched, event);
+
+	/* AF windows use sensor coordinates, including the visible zoom crop. */
+	const unsigned int width = std::max(1U, previewCrop_.width / 5);
+	const unsigned int height = std::max(1U, previewCrop_.height / 5);
+	const int x = previewCrop_.x + (mouse->position().x() - visible.x()) *
+		      previewCrop_.width / visible.width();
+	const int y = previewCrop_.y + (mouse->position().y() - visible.y()) *
+		      previewCrop_.height / visible.height();
+	pendingFocus_ = Rectangle(x - static_cast<int>(width / 2),
+				  y - static_cast<int>(height / 2), width, height)
+				.enclosedIn(previewCrop_);
+	return true;
+}
