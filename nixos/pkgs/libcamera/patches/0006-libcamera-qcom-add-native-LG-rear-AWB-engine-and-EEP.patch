--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_flat_input.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+#include "lg_ae_flat.h"
+#include "lg_ae_histogram.h"
+
+namespace libcamera::qcom {
+
+class LgAwbFlatInput
+{
+public:
+	explicit LgAwbFlatInput(const LgAeFlatConfiguration &config) : flat_(config) {}
+
+	void reset()
+	{
+		flat_.reset();
+		frames_ = {};
+		value_ = 0;
+	}
+
+	float update(uint64_t frame, const std::array<uint32_t, 1024> &histogram)
+	{
+		const auto &result = flat_.process(lgAeHistogram(histogram));
+		frames_[frame % frames_.size()] = Frame{ frame, result.metric };
+		/* The plugin starts querying frame N-2 at N=3 and retains missing tags. */
+		if (frame >= 3) {
+			uint64_t requested = frame - 2;
+			const auto &previous = frames_[requested % frames_.size()];
+			if (previous && previous->sequence == requested)
+				value_ = previous->metric;
+		}
+		return value_;
+	}
+
+	const LgAeFlatResult &current() const { return flat_.result(); }
+
+private:
+	struct Frame {
+		uint64_t sequence;
+		float metric;
+	};
+
+	LgAeFlat flat_;
+	std::array<std::optional<Frame>, 3> frames_;
+	float value_ = 0;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_gain.h b/src/libcamera/pipeline/qcom/lg_awb_gain.h
new file mode 100644
index 0000000..853eb68
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_gain.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_math.h"
+
+namespace libcamera::qcom {
+
+using LgAwbGainOffsets = std::array<LgAwbRatios, 6>;
+
+struct LgAwbGainConfiguration {
+	std::array<int16_t, 24> luxKnots;
+	std::array<std::array<LgAwbGainOffsets, 24>, 2> offsets;
+	std::array<float, 6> filterFactors;
+	std::array<std::array<float, 2>, 3> limits;
+	LgAwbRgb fallback;
+};
+
+class LgAwbGain
+{
+public:
+	explicit LgAwbGain(const LgAwbGainConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	LgAwbGainOffsets offsets(unsigned int selector, int lux) const
+	{
+		unsigned int region = std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+			config_.luxKnots.begin();
+		unsigned int first = region ? region - 1 : 0;
+		unsigned int last = std::min<unsigned int>(region, config_.luxKnots.size() - 1);
+		float t = first == last ? 0.0f : static_cast<float>(lux - config_.luxKnots[first]) /
+			(config_.luxKnots[last] - config_.luxKnots[first]);
+		LgAwbGainOffsets result;
+		for (unsigned int i = 0; i < result.size(); i++) {
+			auto a = config_.offsets[selector][first][i], b = config_.offsets[selector][last][i];
+			result[i] = { a.red + lgAwbProduct(t, b.red - a.red),
+				      a.blue + lgAwbProduct(t, b.blue - a.blue) };
+		}
+		return result;
+	}
+
+	static LgAwbRgb apply(LgAwbRgb rgb, int32_t cct, const LgAwbGainOffsets &offsets)
+	{
+		constexpr std::array<int32_t, 6> ccts{ 7500, 6500, 5000, 4000, 2856, 2300 };
+		LgAwbRatios factor = offsets.back();
+		if (cct >= ccts.front()) {
+			factor = offsets.front();
+		} else {
+			for (unsigned int i = 1; i < ccts.size(); i++) {
+				if (cct < ccts[i])
+					continue;
+				float t = static_cast<float>(cct - ccts[i]) / (ccts[i - 1] - ccts[i]);
+				factor = { offsets[i].red + lgAwbProduct(t, offsets[i - 1].red - offsets[i].red),
+					   offsets[i].blue + lgAwbProduct(t, offsets[i - 1].blue - offsets[i].blue) };
+				break;
+			}
+		}
+		rgb[0] = lgAwbProduct(rgb[0], factor.red);
+		rgb[2] = lgAwbProduct(rgb[2], factor.blue);
+		return rgb;
+	}
+
+	static bool invalid(const LgAwbRgb &rgb)
+	{
+		return !std::all_of(rgb.begin(), rgb.end(), [](float value) { return std::isfinite(value); }) ||
+			(std::abs(rgb[0]) <= 1e-6f && std::abs(rgb[2]) <= 1e-6f) ||
+			(rgb[0] >= 1.0f - 1e-6f && rgb[0] <= 1.0f + 1e-6f &&
+			 rgb[2] >= 1.0f - 1e-6f && rgb[2] <= 1.0f + 1e-6f);
+	}
+
+	LgAwbRgb limit(LgAwbRgb rgb) const
+	{
+		if (invalid(rgb))
+			rgb = config_.fallback;
+		for (unsigned int channel = 0; channel < rgb.size(); channel++) {
+			if (rgb[channel] < config_.limits[channel][0]) {
+				float factor = config_.limits[channel][0] / rgb[channel];
+				for (float &value : rgb)
+					value = lgAwbProduct(value, factor);
+			}
+		}
+		for (unsigned int channel = 0; channel < rgb.size(); channel++)
+			rgb[channel] = std::min(rgb[channel], config_.limits[channel][1]);
+		return rgb;
+	}
+
+private:
+	LgAwbGainConfiguration config_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_gray.h b/src/libcamera/pipeline/qcom/lg_awb_gray.h
new file mode 100644
index 0000000..db957fc
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_gray.h
@@ -0,0 +1,171 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_statistics.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbGrayReferences {
+	unsigned int count;
+	std::array<LgAwbPoint, 17> points;
+	std::array<float, 17> above, below;
+};
+
+struct LgAwbGrayDecision {
+	uint32_t nearest, additionalNearest, valid, weightGroup, category;
+};
+
+class LgAwbGrayClassifier
+{
+public:
+	explicit LgAwbGrayClassifier(const LgAwbGrayReferences &references)
+		: references_(references)
+	{
+		/* Reference geometry is fixed for this frame-scoped classifier. */
+		std::copy_n(references_.points.begin(), primary_.size(), primary_.begin());
+		for (unsigned int i = 0; i < lines_.size(); i++) {
+			auto a = references_.points[i], b = references_.points[i + 1];
+			float dx = b.x - a.x;
+			lines_[i] = { (b.y - a.y) / dx,
+				      (product(a.y, b.x) - product(a.x, b.y)) / dx };
+			float divisor = product(lines_[i].slope, lines_[i].slope) + 1.0f;
+			divisors_[i] = divisor;
+			sqrtDivisors_[i] = std::sqrt(divisor);
+		}
+	}
+
+	std::array<uint32_t, 2> nearestReferences(LgAwbPoint point) const
+	{
+		unsigned int nearest = lgAwbNearestReference(primary_, point);
+		unsigned int additional = 6;
+		float additionalDistance = distance(point, references_.points[additional]);
+		for (unsigned int i = 7; i < references_.count; i++) {
+			float current = distance(point, references_.points[i]);
+			if (current < additionalDistance) {
+				additional = i;
+				additionalDistance = current;
+			}
+		}
+		return { nearest, additional };
+	}
+
+	LgAwbGrayDecision classify(LgAwbPoint point) const
+	{
+		return classify(point, nearestReferences(point));
+	}
+
+	LgAwbGrayDecision classify(LgAwbPoint point,
+				   const std::array<uint32_t, 2> &indices) const
+	{
+		unsigned int nearest = indices[0], additional = indices[1];
+		float additionalDistance = distance(point, references_.points[additional]);
+		LgAwbGrayDecision result{ nearest, additional, 0, 0, 0 };
+		unsigned int segment;
+		int cap = -1;
+		Projection projection;
+		if (nearest == 0) {
+			segment = 0;
+			projection = project(point, segment);
+			if (projection.x < primary_.front().x) {
+				cap = 0;
+				projection.distance = distance(point, primary_.front());
+			}
+		} else if (nearest == 5) {
+			segment = 4;
+			projection = project(point, segment);
+			if (projection.x > primary_.back().x) {
+				cap = 5;
+				projection.distance = distance(point, primary_.back());
+			}
+		} else {
+			auto before = project(point, nearest - 1), after = project(point, nearest);
+			bool beforeValid = before.x >= primary_[nearest - 1].x && before.x <= primary_[nearest].x;
+			bool afterValid = after.x >= primary_[nearest].x && after.x <= primary_[nearest + 1].x;
+			bool chooseBefore = (beforeValid && (!afterValid || before.distance < after.distance)) ||
+				(!afterValid && before.distance >= after.distance);
+			segment = chooseBefore ? nearest - 1 : nearest;
+			projection = chooseBefore ? before : after;
+		}
+		if (projection.distance > additionalDistance) {
+			float width = references_.above[additional];
+			/* The middle segment's forward branch excludes the circle boundary. */
+			bool strict = nearest > 0 && nearest < 5 && segment == nearest;
+			if (strict ? additionalDistance < width : additionalDistance <= width) {
+				result.valid = 1;
+				result.category = 12 + additional;
+			}
+			return result;
+		}
+		const auto &widths = projection.above ? references_.above : references_.below;
+		float width;
+		unsigned int category;
+		if (cap >= 0) {
+			width = widths[cap];
+			category = cap == 0 ? 1 : 17;
+		} else {
+			float a = primary_[segment].x, b = primary_[segment + 1].x;
+			width = interpolate(projection.x, a, b, widths[segment], widths[segment + 1]);
+			float third = a + product(b - a, 1.0f / 3.0f);
+			float twoThirds = a + product(b - a, 2.0f / 3.0f);
+			category = 3 * segment + (projection.x <= third ? 2 : projection.x <= twoThirds ? 3 : 4);
+		}
+		if (projection.distance <= width) {
+			result.valid = 1;
+			result.category = category;
+			if (projection.distance < width / 3.0f)
+				result.weightGroup = projection.above ? 2 : 3;
+			else if (projection.distance < width)
+				result.weightGroup = projection.above ? 1 : 4;
+		}
+		return result;
+	}
+
+private:
+	struct Line {
+		float slope, intercept;
+	};
+
+	struct Projection {
+		float x, distance;
+		bool above;
+	};
+
+	static float product(float a, float b)
+	{
+		/* Match the factory's separate multiplication and addition rounding. */
+		volatile float result = a * b;
+		return result;
+	}
+
+	static float distance(LgAwbPoint a, LgAwbPoint b)
+	{
+		float dx = a.x - b.x, dy = a.y - b.y;
+		return std::sqrt(product(dx, dx) + product(dy, dy));
+	}
+
+	static float interpolate(float x, float a, float b, float first, float last)
+	{
+		if (a >= b - 1e-6f && a <= b + 1e-6f)
+			return product(first + last, 0.5f);
+		return first + product((x - a) / (b - a), last - first);
+	}
+
+	Projection project(LgAwbPoint point, unsigned int segment) const
+	{
+		auto line = lines_[segment];
+		return { (point.x + product(line.slope, point.y - line.intercept)) / divisors_[segment],
+			 std::abs((point.y - product(point.x, line.slope)) - line.intercept) / sqrtDivisors_[segment],
+			 point.y > product(point.x, line.slope) + line.intercept };
+	}
+
+	LgAwbGrayReferences references_;
+	std::array<LgAwbPoint, 6> primary_;
+	std::array<Line, 5> lines_;
+	std::array<float, 5> divisors_, sqrtDivisors_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_gray_core.h b/src/libcamera/pipeline/qcom/lg_awb_gray_core.h
new file mode 100644
index 0000000..c4c4368
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_gray_core.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "lg_awb_preprocess.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbGrayCoreConfiguration {
+	LgAwbPreprocessConfiguration preprocess;
+	LgAwbSceneWeightConfiguration sceneWeights;
+	LgAwbSceneReweightConfiguration reweight;
+};
+
+struct LgAwbGrayFrameControls {
+	int lux;
+	unsigned int flashState, led, minimumGrayCount;
+	bool outdoor, flashOn, widen4000KBelow;
+};
+
+class LgAwbGrayCore
+{
+public:
+	explicit LgAwbGrayCore(const LgAwbGrayCoreConfiguration &config,
+			       const LgAwbWhiteBalanceCalibration &calibration = {})
+		: preprocess_(config.preprocess, calibration), lookup_(config.preprocess.statistics),
+		  adjustment_(config.sceneWeights), aggregate_(config.reweight)
+	{
+	}
+
+	void reset()
+	{
+		frame_ = {};
+		result_ = {};
+		factors_ = { 10, 10, 10 };
+		boost_ = 0;
+		weights_ = {};
+	}
+
+	const LgAwbGrayResult &process(const std::array<LgAwbRgb, 3072> &rgb,
+				     const LgAwbGrayFrameControls &controls,
+				     const LgAwbFaceBox *faceBoxes = nullptr,
+				     uint32_t faceCount = 0,
+				     const LgAwbFwbConfiguration &fwbConfig = {},
+				     LgAwbFaceResult *faceResult = nullptr)
+	{
+		preprocess_.prepare(rgb, controls.lux, frame_, controls.widen4000KBelow,
+				    faceBoxes, faceCount, fwbConfig, faceResult);
+		weights_ = lookup_.weights(controls.lux);
+		adjustment_.reduce(weights_, controls.lux, controls.flashState, frame_.categoryCounts, factors_);
+		boost_ = adjustment_.boost(weights_, controls.lux, controls.outdoor, controls.flashOn, controls.led);
+		aggregate_.update(frame_.samples, weights_, frame_.categoryCounts, controls.lux, controls.flashState,
+			controls.minimumGrayCount, frame_.references.points, result_);
+		return result_;
+	}
+
+	const LgAwbPreparedFrame &frame() const { return frame_; }
+	const LgAwbRegionWeights &weights() const { return weights_; }
+	const std::array<float, 3> &factors() const { return factors_; }
+	float boost() const { return boost_; }
+
+	const LgAwbColour &colour() const { return preprocess_.colour(); }
+
+private:
+	LgAwbPreprocess preprocess_;
+	LgAwbStatistics lookup_;
+	LgAwbSceneWeights adjustment_;
+	LgAwbGrayAggregate aggregate_;
+	LgAwbPreparedFrame frame_;
+	LgAwbGrayResult result_;
+	LgAwbRegionWeights weights_{};
+	std::array<float, 3> factors_{ 10, 10, 10 };
+	float boost_ = 0;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_gray_geometry.h b/src/libcamera/pipeline/qcom/lg_awb_gray_geometry.h
new file mode 100644
index 0000000..f0da8d2
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_gray_geometry.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_gray.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbReferenceChange {
+	unsigned int index;
+	std::array<int16_t, 2> lux;
+	LgAwbPoint target;
+};
+
+struct LgAwbGrayConfiguration {
+	LgAwbColourConfiguration colour;
+	unsigned int additionalCount, changeCount;
+	std::array<LgAwbRatios, 11> additional;
+	std::array<LgAwbReferenceChange, 10> changes;
+	std::array<int16_t, 17> above, below;
+	std::array<int16_t, 24> luxKnots;
+	std::array<std::array<std::array<int16_t, 17>, 2>, 24> distanceOffsets;
+};
+
+class LgAwbGrayGeometry
+{
+public:
+	explicit LgAwbGrayGeometry(const LgAwbGrayConfiguration &config)
+		: config_(config)
+	{
+		std::copy(config.colour.ideal.begin(), config.colour.ideal.end(), points_.begin());
+		/* Reserved references use the fixed, uncalibrated nominal sensor-to-ideal shift. */
+		auto nominal = config.colour;
+		nominal.lowLightEnabled = false;
+		LgAwbColour colour(nominal);
+		for (unsigned int i = 0; i < config.additionalCount; i++) {
+			auto point = colour.fromRgb(config.additional[i]);
+			points_[6 + i] = { point.x, point.y };
+		}
+	}
+
+	LgAwbGrayReferences references(int lux, bool widen4000KBelow = false) const
+	{
+		LgAwbGrayReferences result{};
+		result.count = 6 + config_.additionalCount;
+		result.points = points_;
+		for (unsigned int i = 0; i < config_.changeCount; i++) {
+			const auto &change = config_.changes[i];
+			auto base = points_[change.index];
+			float t = std::clamp(static_cast<float>(lux - change.lux[0]) /
+					     (change.lux[1] - change.lux[0]), 0.0f, 1.0f);
+			result.points[change.index] = { base.x + product(t, change.target.x - base.x),
+						       base.y + product(t, change.target.y - base.y) };
+		}
+		unsigned int region = std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+			config_.luxKnots.begin();
+		unsigned int first = region ? region - 1 : 0;
+		unsigned int last = std::min<unsigned int>(region, config_.luxKnots.size() - 1);
+		float t = first == last ? 0.0f : static_cast<float>(lux - config_.luxKnots[first]) /
+			(config_.luxKnots[last] - config_.luxKnots[first]);
+		for (unsigned int i = 0; i < result.above.size(); i++) {
+			for (unsigned int side = 0; side < 2; side++) {
+				float a = product(config_.distanceOffsets[first][side][i], 0.001f);
+				float b = product(config_.distanceOffsets[last][side][i], 0.001f);
+				float base = product(side ? config_.below[i] : config_.above[i], 0.001f);
+				float value = base + (a + product(t, b - a));
+				(side ? result.below : result.above)[i] = value;
+			}
+		}
+		if (widen4000KBelow && region >= 7 && region <= 14)
+			result.below[3] = 0.03f;
+		return result;
+	}
+
+private:
+	static float product(float a, float b)
+	{
+		/* Match the factory's separate multiplication and addition rounding. */
+		volatile float result = a * b;
+		return result;
+	}
+
+	LgAwbGrayConfiguration config_;
+	std::array<LgAwbPoint, 17> points_{};
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_history.h b/src/libcamera/pipeline/qcom/lg_awb_history.h
new file mode 100644
index 0000000..b06dc14
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_history.h
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "lg_awb_math.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbGainSample {
+	LgAwbRgb rgb{};
+	int32_t cct = 0;
+	uint32_t illuminant = 0;
+};
+
+struct LgAwbHistoryConfiguration {
+	unsigned int capacity;
+	float maximumFlatMetric, initialMaximumFlatMetric;
+};
+
+enum class LgAwbHistoryKind { Initial, Rolling };
+
+struct LgAwbHistoryControls {
+	bool startup, grayValid, aeSettled;
+	unsigned int flashState;
+	float flatMetric;
+};
+
+class LgAwbHistory
+{
+public:
+	explicit LgAwbHistory(const LgAwbHistoryConfiguration &config)
+		: config_(config), rolling_(config.capacity), initial_(config.capacity)
+	{
+	}
+
+	void reset()
+	{
+		rollingCount_ = initialCount_ = next_ = 0;
+		rollingCounts_ = initialCounts_ = {};
+	}
+
+	void update(LgAwbRgb rgb, int32_t cct, const LgAwbHistoryControls &controls)
+	{
+		if (controls.startup || !controls.grayValid || !controls.aeSettled || controls.flashState ||
+		    !(controls.flatMetric < config_.maximumFlatMetric))
+			return;
+		LgAwbGainSample sample{ rgb, cct, lgAwbIlluminant(cct) };
+		if (rollingCount_ == config_.capacity)
+			rollingCounts_[rolling_[next_].illuminant]--;
+		else
+			rollingCount_++;
+		rolling_[next_] = sample;
+		rollingCounts_[sample.illuminant]++;
+		if (initialCount_ < config_.capacity && controls.flatMetric < config_.initialMaximumFlatMetric) {
+			initial_[initialCount_++] = sample;
+			initialCounts_[sample.illuminant]++;
+		}
+		next_ = (next_ + 1) % config_.capacity;
+	}
+
+	std::optional<LgAwbGainSample> lookup(LgAwbHistoryKind kind, bool skipped = false) const
+	{
+		bool initial = kind == LgAwbHistoryKind::Initial;
+		if (!initial && (skipped || rollingCount_ < 15))
+			return std::nullopt;
+		const auto &histogram = initial ? initialCounts_ : rollingCounts_;
+		const auto &samples = initial ? initial_ : rolling_;
+		unsigned int size = initial ? initialCount_ : rollingCount_;
+		unsigned int illuminant = std::max_element(histogram.begin(), histogram.end()) - histogram.begin();
+		LgAwbGainSample result{};
+		int cct = 0;
+		for (unsigned int i = 0; i < size; i++) {
+			if (samples[i].illuminant != illuminant)
+				continue;
+			for (unsigned int channel = 0; channel < result.rgb.size(); channel++)
+				result.rgb[channel] += samples[i].rgb[channel];
+			cct += samples[i].cct;
+		}
+		unsigned int count = histogram[illuminant];
+		for (float &value : result.rgb)
+			value /= count;
+		/* FCVTZS produces zero for the empty initial table's NaN CCT mean. */
+		result.cct = count ? static_cast<int32_t>(static_cast<float>(cct) / count) : 0;
+		result.illuminant = illuminant;
+		return result;
+	}
+
+	unsigned int size(LgAwbHistoryKind kind) const
+	{
+		return kind == LgAwbHistoryKind::Initial ? initialCount_ : rollingCount_;
+	}
+	const std::array<uint32_t, 6> &counts(LgAwbHistoryKind kind) const
+	{
+		return kind == LgAwbHistoryKind::Initial ? initialCounts_ : rollingCounts_;
+	}
+	unsigned int nextIndex() const { return next_; }
+
+private:
+	LgAwbHistoryConfiguration config_;
+	std::vector<LgAwbGainSample> rolling_, initial_;
+	std::array<uint32_t, 6> rollingCounts_{}, initialCounts_{};
+	unsigned int rollingCount_ = 0, initialCount_ = 0, next_ = 0;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_manual.h b/src/libcamera/pipeline/qcom/lg_awb_manual.h
new file mode 100644
index 0000000..0d15707
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_manual.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_math.h"
+
+namespace libcamera::qcom {
+
+inline LgAwbPoint lgAwbProjectWhitePoint(const LgAwbColour &colour, LgAwbPoint point)
+{
+	const auto &references = colour.ideal();
+	LgAwbPoint selected = references.front();
+	double nearest = std::numeric_limits<double>::max();
+	for (unsigned int i = 0; i + 1 < references.size(); i++) {
+		auto a = references[i], b = references[i + 1];
+		double dx = static_cast<double>(b.x) - a.x;
+		double dy = static_cast<double>(b.y) - a.y;
+		double length = std::fma(dx, dx, dy * dy);
+		double numerator = std::fma(static_cast<double>(point.x) - a.x, dx,
+					    (static_cast<double>(point.y) - a.y) * dy);
+		double t = std::clamp(numerator / length, 0.0, 1.0);
+		double x = std::fma(t, dx, a.x), y = std::fma(t, dy, a.y);
+		double ex = point.x - x, ey = point.y - y;
+		double distance = std::fma(ex, ex, ey * ey);
+		if (distance < nearest) {
+			nearest = distance;
+			selected = { static_cast<float>(x), static_cast<float>(y) };
+		}
+	}
+	return selected;
+}
+
+inline int32_t lgAwbManualColourTemperature(const LgAwbColour &colour, LgAwbRatios ratios)
+{
+	auto point = colour.fromRgb(ratios);
+	/* Arbitrary manual gains can lie outside the temperature formula's white-point domain. */
+	return lgAwbColourTemperature(lgAwbProjectWhitePoint(colour, { point.x, point.y }));
+}
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_math.h b/src/libcamera/pipeline/qcom/lg_awb_math.h
new file mode 100644
index 0000000..eb1e8d3
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_math.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include "lg_awb_types.h"
+
+namespace libcamera::qcom {
+
+inline float lgAwbProduct(float a, float b)
+{
+	/* Match the factory's separate multiplication and addition rounding. */
+	volatile float result = a * b;
+	return result;
+}
+
+inline float lgAwbTriangle(int value, const std::array<int16_t, 4> &knots)
+{
+	if (value <= knots[0] || value >= knots[3])
+		return 0;
+	if (value < knots[1])
+		return static_cast<float>(value - knots[0]) / (knots[1] - knots[0]);
+	if (value <= knots[2])
+		return 1;
+	return 1.0f - static_cast<float>(value - knots[2]) / (knots[3] - knots[2]);
+}
+
+inline int32_t lgAwbColourTemperature(LgAwbPoint point)
+{
+	float n = point.y == 0.1858f ? 0 : (point.x - 0.332f) / (point.y - 0.1858f);
+	float cubic = lgAwbProduct(lgAwbProduct(lgAwbProduct(n, -449.0f), n), n);
+	float square = lgAwbProduct(lgAwbProduct(n, 3525.0f), n);
+	float linear = lgAwbProduct(n, -6823.3f);
+	return static_cast<int32_t>(((square + cubic) + linear) + 5520.83f);
+}
+
+inline uint32_t lgAwbIlluminant(int32_t cct)
+{
+	return cct >= 7000 ? 0 : cct >= 5750 ? 1 : cct > 4500 ? 2 :
+		cct > 3428 ? 3 : cct > 2578 ? 4 : 5;
+}
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_pipeline.h b/src/libcamera/pipeline/qcom/lg_awb_pipeline.h
new file mode 100644
index 0000000..e535e6c
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_pipeline.h
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+#include "lg_awb_cadence.h"
+#include "lg_awb_exceptions.h"
+#include "lg_awb_face.h"
+#include "lg_awb_gray_core.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbPipelineConfiguration {
+	LgAwbGrayCoreConfiguration gray;
+	LgAwbHistoryConfiguration history;
+	LgAwbGainConfiguration gain;
+	LgAwbOheConfiguration ohe;
+	LgAwbDtbConfiguration dtb;
+	LgAwbScdConfiguration scd;
+	LgAwbFoeConfiguration foe;
+	LgAwbFwbConfiguration fwb;
+	std::array<int16_t, 4> periods;
+	unsigned int minimumGrayCount;
+};
+
+struct LgAwbPipelineControls {
+	int lux;
+	unsigned int minimumGrayCount, flashState, led, cameraId, fps, mode, usecase;
+	bool aeSettled, fastRequest, afRequest, dtbBlocked, outdoor, flashOn, forceSkip;
+	float flatMetric;
+	uint32_t frameCount = 0;
+	uint32_t imageWidth = 0, imageHeight = 0;
+	const LgAwbFaceInput *faces = nullptr;
+	size_t faceCount = 0;
+};
+
+struct LgAwbPipelineResult {
+	LgAwbCadenceResult cadence;
+	LgAwbRgb rgb{};
+	LgAwbGainTarget target;
+	LgAwbConvergenceResult filtered{};
+	uint32_t grayValid = 0, dtbGrayValid = 0;
+	unsigned int dtbSelection = 20;
+	float latestGrayX = 0, oheWeight = 0, foeWeight = 0, fwbWeight = 0;
+	LgAwbScdStatus scdStatus = LgAwbScdStatus::InvalidHistoryGain;
+	LgAwbFaceResult faceResult{};
+	uint32_t activeFaces = 0;
+};
+
+class LgAwbPipeline
+{
+public:
+	LgAwbPipeline(const LgAwbPipelineConfiguration &config,
+		      const LgAwbWhiteBalanceCalibration &calibration = {})
+		: cadence_(config.periods), gray_(config.gray, calibration), history_(config.history), gain_(config.gain),
+		  convergence_(config.gain.filterFactors), ohe_(config.ohe), dtb_(config.dtb),
+		  scd_(config.scd), foe_(config.foe), fwb_(config.fwb), fwbConfig_(config.fwb)
+	{
+	}
+
+	void reset()
+	{
+		cadence_.reset();
+		gray_.reset();
+		history_.reset();
+		target_.reset();
+		convergence_.reset();
+		ohe_.reset();
+		dtb_.reset();
+		foe_.reset();
+		fwb_.reset();
+		faceTracker_.reset();
+		offsets_ = {};
+		grayResult_ = {};
+		faceResult_ = {};
+		result_ = {};
+	}
+
+	const LgAwbPipelineResult &process(const std::array<LgAwbRgb, 3072> &rgb,
+					 const LgAwbPipelineControls &controls)
+	{
+		result_.cadence = cadence_.update({ controls.fps, controls.cameraId, controls.mode,
+			controls.flashState, controls.lux, controls.forceSkip });
+		LgAwbGrayFrameControls frameControls{ controls.lux, controls.flashState, controls.led,
+			controls.minimumGrayCount, controls.outdoor, controls.flashOn, result_.cadence.startup };
+		faceTracker_.update(controls.faces, controls.faceCount, controls.imageWidth, controls.imageHeight);
+		if (!result_.cadence.skipped) {
+			dtb_.reset();
+			offsets_ = gain_.offsets(frameControls.led == 3, frameControls.lux);
+			faceResult_ = {};
+			grayResult_ = gray_.process(rgb, frameControls,
+						    faceTracker_.data(), faceTracker_.activeCount(),
+						    fwbConfig_, &faceResult_);
+			result_.dtbGrayValid = grayResult_.grayValid;
+			if (grayResult_.grayValid)
+				result_.latestGrayX = result_.cadence.startup ? 0 : grayResult_.gray.colour.x;
+		}
+		result_.grayValid = result_.cadence.skipped ? 0 : grayResult_.grayValid;
+		uint32_t beforeTarget = result_.grayValid;
+		result_.target = target_.select(gray_.colour(), history_, grayResult_.gray.colour,
+			grayResult_.gray.cct, result_.grayValid, result_.cadence.skipped, frameControls.flashState);
+		if (beforeTarget && !result_.grayValid)
+			result_.dtbGrayValid = 0;
+		result_.target.rgb = gain_.apply(result_.target.rgb, result_.target.cct,
+			offsets_);
+		ohe_.apply(result_.target, gray_.colour(), frameControls.lux, grayResult_.grayCount);
+		dtb_.apply(result_.target, gray_.colour(), gray_.frame().references,
+			gray_.frame().regionCounters.dtb, frameControls.lux, gray_.frame().validFraction,
+			result_.latestGrayX, result_.dtbGrayValid, controls.dtbBlocked);
+		result_.scdStatus = scd_.apply(result_.target, history_, gray_.frame().references,
+			{ grayResult_.gray.colour.x, grayResult_.gray.colour.y },
+			{ frameControls.lux, frameControls.flashState, faceTracker_.activeCount(), controls.usecase,
+			  grayResult_.gray.cct, grayResult_.gray.illuminant, controls.aeSettled,
+			  controls.flatMetric }).status;
+		foe_.apply(result_.target, gray_.colour(), { frameControls.lux, frameControls.led,
+			frameControls.outdoor, frameControls.flashOn });
+		fwb_.apply(result_.target, faceResult_, controls.frameCount);
+		result_.filtered = convergence_.update(result_.target.rgb, result_.target.cct,
+			{ static_cast<unsigned int>(result_.target.source), 1, frameControls.flashState,
+			  controls.fastRequest, result_.cadence.startup, controls.afRequest }, gray_.colour());
+		result_.rgb = gain_.limit(result_.filtered.rgb);
+		unsigned int source = static_cast<unsigned int>(result_.target.source);
+		if (source <= 9 && source != 2 && source != 3 &&
+		    (frameControls.flashState == 0 || frameControls.flashState == 5))
+			history_.update(result_.rgb, result_.filtered.cct,
+				{ result_.cadence.startup, static_cast<bool>(result_.grayValid), controls.aeSettled,
+				  frameControls.flashState, controls.flatMetric });
+		result_.dtbSelection = dtb_.selection();
+		result_.oheWeight = ohe_.weight();
+		result_.foeWeight = foe_.weight();
+		result_.fwbWeight = fwb_.weight();
+		result_.faceResult = faceResult_;
+		result_.activeFaces = faceTracker_.activeCount();
+		return result_;
+	}
+
+	const LgAwbHistory &history() const { return history_; }
+	const LgAwbGrayCore &grayCore() const { return gray_; }
+	const LgAwbGainFilterState &filterHistory() const { return convergence_.history(); }
+	const LgAwbFaceTracker &faceTracker() const { return faceTracker_; }
+	const LgAwbFaceResult &faceResult() const { return faceResult_; }
+	const LgAwbFwb &fwb() const { return fwb_; }
+
+private:
+	LgAwbCadence cadence_;
+	LgAwbGrayCore gray_;
+	LgAwbHistory history_;
+	LgAwbGain gain_;
+	LgAwbTarget target_;
+	LgAwbConvergence convergence_;
+	LgAwbOhe ohe_;
+	LgAwbDtb dtb_;
+	LgAwbScd scd_;
+	LgAwbFoe foe_;
+	LgAwbFwb fwb_;
+	LgAwbFwbConfiguration fwbConfig_;
+	LgAwbFaceTracker faceTracker_;
+	LgAwbGainOffsets offsets_{};
+	LgAwbGrayResult grayResult_;
+	LgAwbFaceResult faceResult_{};
+	LgAwbPipelineResult result_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_preprocess.h b/src/libcamera/pipeline/qcom/lg_awb_preprocess.h
new file mode 100644
index 0000000..fab19d1
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_preprocess.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_face.h"
+#include "lg_awb_gray_geometry.h"
+#include "lg_awb_regions.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbPreprocessConfiguration {
+	LgAwbColourConfiguration colour;
+	LgAwbStatisticsConfiguration statistics;
+	LgAwbGrayConfiguration geometry;
+	LgAwbRegionConfiguration regions;
+};
+
+struct LgAwbPreparedFrame {
+	std::array<LgAwbGraySample, 3072> samples{};
+	std::array<uint16_t, 3072> rncLabels{};
+	LgAwbScreenCounters screenCounters{};
+	LgAwbCategoryCounts categoryCounts{};
+	LgAwbRegionCounters regionCounters{};
+	float validFraction = 0;
+	LgAwbGrayReferences references{};
+};
+
+class LgAwbPreprocess
+{
+public:
+	explicit LgAwbPreprocess(const LgAwbPreprocessConfiguration &config,
+				 const LgAwbWhiteBalanceCalibration &calibration = {})
+		: colour_(config.colour, calibration), statistics_(config.statistics),
+		  geometry_(config.geometry), regions_(config.regions)
+	{
+	}
+
+	void prepare(const std::array<LgAwbRgb, 3072> &rgb, int lux, LgAwbPreparedFrame &frame,
+		     bool widen4000KBelow = false,
+		     const LgAwbFaceBox *faceBoxes = nullptr, uint32_t faceCount = 0,
+		     const LgAwbFwbConfiguration &fwbConfig = {},
+		     LgAwbFaceResult *faceResult = nullptr)
+	{
+		colour_.setLux(lux);
+		regions_.setLux(lux);
+		frame.references = geometry_.references(lux, widen4000KBelow);
+		LgAwbGrayClassifier classifier(frame.references);
+		frame.screenCounters = {};
+		frame.categoryCounts = {};
+		for (unsigned int i = 0; i < rgb.size(); i++) {
+			auto &sample = frame.samples[i];
+			frame.rncLabels[i] = 20;
+			sample.decision.valid = sample.decision.weightGroup = sample.decision.category = 0;
+			if (rgb[i][0] <= 0 || rgb[i][1] <= 0 || rgb[i][2] <= 0) {
+				sample.colour = {};
+			} else {
+				sample.colour = colour_.fromRgb({ rgb[i][0] / rgb[i][1], rgb[i][2] / rgb[i][1] });
+				sample.luma = (lgAwbProduct(rgb[i][0], 0.299f) + lgAwbProduct(rgb[i][1], 0.587f)) +
+					lgAwbProduct(rgb[i][2], 0.114f);
+			}
+			sample.valid = statistics_.screen(sample.colour, rgb[i], frame.screenCounters);
+			if (sample.valid) {
+				auto indices = classifier.nearestReferences({ sample.colour.x, sample.colour.y });
+				sample.decision.nearest = indices[0];
+				sample.decision.additionalNearest = indices[1];
+				frame.rncLabels[i] = regions_.classify(sample);
+			}
+		}
+		if (faceCount > 0 && faceBoxes && faceResult)
+			*faceResult = lgAwbCheckFaceStat(rgb, frame.samples, faceBoxes, faceCount, fwbConfig, colour_.nominalRgb()[2]);
+		frame.screenCounters[0] += regions_.counters().rejected;
+		frame.validFraction = static_cast<float>(3072 - frame.screenCounters[0] -
+			frame.screenCounters[1] - frame.screenCounters[2]) / 3072.0f;
+		for (unsigned int i = 0; i < frame.samples.size(); i++) {
+			auto &sample = frame.samples[i];
+			if (!sample.valid)
+				continue;
+			bool shifted = regions_.shift(sample, frame.rncLabels[i]);
+			LgAwbPoint point{ sample.colour.x, sample.colour.y };
+			if (shifted)
+				sample.decision = classifier.classify(point);
+			else
+				sample.decision = classifier.classify(point,
+					{ sample.decision.nearest, sample.decision.additionalNearest });
+			frame.categoryCounts[sample.decision.category]++;
+		}
+		frame.regionCounters = regions_.counters();
+	}
+
+	const LgAwbColour &colour() const { return colour_; }
+
+private:
+	LgAwbColour colour_;
+	LgAwbStatistics statistics_;
+	LgAwbGrayGeometry geometry_;
+	LgAwbExceptionRegions regions_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_regions.h b/src/libcamera/pipeline/qcom/lg_awb_regions.h
new file mode 100644
index 0000000..8736bc9
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_regions.h
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_aggregate.h"
+
+namespace libcamera::qcom {
+
+using LgAwbPolygon = std::array<LgAwbPoint, 8>;
+
+class LgAwbPolygonGeometry
+{
+public:
+	LgAwbPolygonGeometry() = default;
+
+	explicit LgAwbPolygonGeometry(const LgAwbPolygon &points)
+	{
+		for (unsigned int i = 0; i < 6; i++) {
+			auto a = points[i], b = points[i + 1], c = points[i + 2];
+			if (a.x < 0.01f || a.y < 0.01f || b.x < 0.01f || b.y < 0.01f || c.x < 0.01f || c.y < 0.01f)
+				break;
+			float ux = b.x - a.x, uy = b.y - a.y, vx = c.x - a.x, vy = c.y - a.y;
+			float first = lgAwbProduct(ux, vy), second = lgAwbProduct(uy, vx);
+			if (second >= first - 1e-6f && second <= first + 1e-6f)
+				continue;
+			triangles_[count_++] = { a,
+				{ std::min({ a.x, b.x, c.x }), std::min({ a.y, b.y, c.y }) },
+				{ std::max({ a.x, b.x, c.x }), std::max({ a.y, b.y, c.y }) },
+				ux, uy, vx, vy, second - first };
+		}
+	}
+
+	bool contains(LgAwbPoint point) const
+	{
+		for (unsigned int i = 0; i < count_; i++) {
+			const auto &t = triangles_[i];
+			if (point.x < t.minimum.x || point.x > t.maximum.x ||
+			    point.y < t.minimum.y || point.y > t.maximum.y)
+				continue;
+			float dx = point.x - t.origin.x, dy = point.y - t.origin.y;
+			float v = (lgAwbProduct(dx, t.uy) - lgAwbProduct(dy, t.ux)) / t.denominator;
+			float u = std::abs(t.ux) <= 1e-6f ? (dy - lgAwbProduct(t.vy, v)) / t.uy :
+				(dx - lgAwbProduct(t.vx, v)) / t.ux;
+			if (u > 0 && u < 1 && v > 0 && v < 1 && u + v < 1)
+				return true;
+		}
+		return false;
+	}
+
+private:
+	struct Triangle {
+		LgAwbPoint origin, minimum, maximum;
+		float ux, uy, vx, vy, denominator;
+	};
+
+	std::array<Triangle, 6> triangles_{};
+	unsigned int count_ = 0;
+};
+
+struct LgAwbRncRegion {
+	LgAwbPolygon points;
+	LgAwbPoint offset;
+	std::array<int16_t, 4> luxKnots;
+	bool lumaGate;
+	uint16_t lumaMode;
+	float lumaThreshold;
+};
+
+struct LgAwbDtbRegion {
+	LgAwbPolygon points;
+	int16_t luxBoundary;
+};
+
+struct LgAwbRegionConfiguration {
+	unsigned int rncCount;
+	std::array<LgAwbRncRegion, 20> rnc;
+	std::array<unsigned int, 2> dtbCount;
+	std::array<std::array<LgAwbDtbRegion, 10>, 2> dtb;
+};
+
+struct LgAwbRegionCounters {
+	std::array<uint16_t, 20> processed{}, shifted{}, dtb{};
+	uint16_t rejected = 0;
+};
+
+class LgAwbExceptionRegions
+{
+public:
+	explicit LgAwbExceptionRegions(const LgAwbRegionConfiguration &config)
+		: config_(config)
+	{
+		/* Region vertices are immutable; lux changes only activation and shift rates. */
+		for (unsigned int i = 0; i < config_.rncCount; i++)
+			rncGeometry_[i] = LgAwbPolygonGeometry(config_.rnc[i].points);
+		for (unsigned int group = 0; group < config_.dtbCount.size(); group++)
+			for (unsigned int i = 0; i < config_.dtbCount[group]; i++)
+				dtbGeometry_[group][i] = LgAwbPolygonGeometry(config_.dtb[group][i].points);
+	}
+
+	void setLux(int lux)
+	{
+		lux_ = lux;
+		counters_ = {};
+		for (unsigned int i = 0; i < config_.rncCount; i++) {
+			const auto &knots = config_.rnc[i].luxKnots;
+			if (lux <= knots[0] || (lux > knots[2] && lux >= knots[3]))
+				scales_[i] = 10000;
+			else if (lux < knots[1])
+				scales_[i] = 1.0f / (static_cast<float>(lux - knots[0]) / (knots[1] - knots[0]));
+			else if (lux <= knots[2])
+				scales_[i] = 1;
+			else
+				scales_[i] = 1.0f / (1.0f - static_cast<float>(lux - knots[2]) / (knots[3] - knots[2]));
+		}
+	}
+
+	uint16_t classify(LgAwbGraySample &sample)
+	{
+		LgAwbPoint original{ sample.colour.x, sample.colour.y };
+		uint16_t label = 20;
+		for (unsigned int i = 0; i < config_.rncCount; i++) {
+			const auto &region = config_.rnc[i];
+			if (scales_[i] > 3000 || (region.lumaGate &&
+			    ((region.lumaMode == 0 && sample.luma > region.lumaThreshold) ||
+			     (region.lumaMode == 1 && sample.luma < region.lumaThreshold))))
+				continue;
+			if (!rncGeometry_[i].contains(original))
+				continue;
+			label = i;
+			if (sample.colour.x + region.offset.x < 0 || sample.colour.y + region.offset.y < 0) {
+				sample.colour = {};
+				sample.valid = 0;
+				label = 20;
+				counters_.rejected++;
+			}
+		}
+		for (unsigned int group = 0; group < config_.dtbCount.size(); group++)
+			for (unsigned int i = 0; i < config_.dtbCount[group]; i++) {
+				const auto &region = config_.dtb[group][i];
+				if ((group == 0 && lux_ < region.luxBoundary) || (group == 1 && lux_ > region.luxBoundary))
+					continue;
+				if (dtbGeometry_[group][i].contains(original)) {
+					counters_.dtb[10 * group + i]++;
+					return label;
+				}
+			}
+		return label;
+	}
+
+	bool shift(LgAwbGraySample &sample, unsigned int label)
+	{
+		if (label == 20 || scales_[label] >= 10000)
+			return false;
+		bool apply = static_cast<float>(counters_.processed[label]) / scales_[label] >
+			static_cast<float>(counters_.shifted[label]) - 1e-6f;
+		if (apply) {
+			sample.colour.x += config_.rnc[label].offset.x;
+			sample.colour.y += config_.rnc[label].offset.y;
+			counters_.shifted[label]++;
+		}
+		counters_.processed[label]++;
+		return apply;
+	}
+
+	const LgAwbRegionCounters &counters() const { return counters_; }
+	const std::array<float, 20> &scales() const { return scales_; }
+
+private:
+	LgAwbRegionConfiguration config_;
+	std::array<LgAwbPolygonGeometry, 20> rncGeometry_;
+	std::array<std::array<LgAwbPolygonGeometry, 10>, 2> dtbGeometry_;
+	LgAwbRegionCounters counters_;
+	std::array<float, 20> scales_{};
+	int lux_ = 0;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_scene_weights.h b/src/libcamera/pipeline/qcom/lg_awb_scene_weights.h
new file mode 100644
index 0000000..e239d71
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_scene_weights.h
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include "lg_awb_math.h"
+#include "lg_awb_statistics.h"
+
+namespace libcamera::qcom {
+
+using LgAwbCategoryCounts = std::array<int16_t, 29>;
+
+struct LgAwbAleConfiguration {
+	bool enabled;
+	std::array<int16_t, 2> countThresholds;
+	std::array<int16_t, 4> luxKnots;
+	int16_t reductionPercent;
+	std::array<uint32_t, 2> countRange;
+	std::array<std::array<uint32_t, 2>, 2> targetRanges;
+};
+
+struct LgAwbAleBoostConfiguration {
+	bool enabled;
+	std::array<int16_t, 4> luxKnots;
+	int16_t increment;
+	std::array<uint32_t, 2> targetRange;
+};
+
+struct LgAwbSceneWeightConfiguration {
+	unsigned int additionalCount;
+	std::array<uint32_t, 10> additionalLights;
+	std::array<LgAwbAleConfiguration, 3> ale;
+	LgAwbAleBoostConfiguration boost;
+};
+
+class LgAwbSceneWeights
+{
+public:
+	explicit LgAwbSceneWeights(const LgAwbSceneWeightConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reduce(LgAwbRegionWeights &weights, int lux, unsigned int flash,
+		    const LgAwbCategoryCounts &counts, std::array<float, 3> &factors,
+		    unsigned int mode = 0) const
+	{
+		for (unsigned int i = 0; i < config_.ale.size(); i++) {
+			const auto &config = config_.ale[i];
+			unsigned int current = i + 2;
+			if ((mode && mode != current) || !config.enabled || (current == 4 && flash == 5))
+				continue;
+			int count = 0;
+			for (unsigned int index = config.countRange[0]; index <= config.countRange[1]; index++)
+				count += counts[index];
+			if (current == 3)
+				count += counts[18];
+			for (unsigned int index = 0; index + 1 < config_.additionalCount; index++) {
+				unsigned int light = config_.additionalLights[index];
+				if ((current == 2 && (light == 1 || light == 2)) ||
+				    (current == 3 && (light == 3 || light == 6)) || (current == 4 && light == 5))
+					count += counts[19 + index];
+			}
+			float ramp = count < config.countThresholds[0] ? 0.0f :
+				count > config.countThresholds[1] ? 1.0f :
+				static_cast<float>(count - config.countThresholds[0]) /
+				(config.countThresholds[1] - config.countThresholds[0]);
+			float factor = 1.0f - lgAwbProduct(lgAwbProduct(config.reductionPercent, 0.01f),
+				lgAwbProduct(ramp, lgAwbTriangle(lux, config.luxKnots)));
+			factors[i] = factor;
+			auto apply = [&weights, factor](unsigned int index) {
+				for (auto &group : weights)
+					group[index] = lgAwbProduct(group[index], factor);
+			};
+			for (auto range : config.targetRanges)
+				if (range[0] != 29 && range[1] != 29)
+					for (unsigned int index = range[0]; index <= range[1]; index++)
+						apply(index);
+			for (unsigned int index = 0; index < config_.additionalLights.size(); index++) {
+				unsigned int light = config_.additionalLights[index];
+				if ((current == 2 && light >= 3 && light <= 6) ||
+				    (current == 3 && light == 5) || (current == 4 && light < 3))
+					apply(19 + index);
+			}
+		}
+	}
+
+	float boost(LgAwbRegionWeights &weights, int lux, bool outdoor, bool flashOn, unsigned int led) const
+	{
+		const auto &config = config_.boost;
+		float factor = config.enabled ? lgAwbTriangle(lux, config.luxKnots) : 0;
+		if (outdoor && !flashOn && !led && factor > 1e-6f) {
+			float increment = lgAwbProduct(factor, config.increment);
+			for (unsigned int group = 1; group < weights.size(); group++)
+				for (unsigned int index = config.targetRange[0]; index <= config.targetRange[1]; index++)
+					weights[group][index] += increment;
+		}
+		return factor;
+	}
+
+private:
+	LgAwbSceneWeightConfiguration config_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_statistics.h b/src/libcamera/pipeline/qcom/lg_awb_statistics.h
new file mode 100644
index 0000000..5112bb3
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_statistics.h
@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+#include "lg_awb_types.h"
+
+namespace libcamera::qcom {
+
+using LgAwbRegionWeights = std::array<std::array<float, 29>, 5>;
+using LgAwbScreenCounters = std::array<uint16_t, 7>;
+
+struct LgAwbStatisticsConfiguration {
+	float minimumRgb, maximumRgb, boundaryMargin;
+	std::array<int16_t, 24> luxKnots;
+	std::array<std::array<std::array<int16_t, 29>, 5>, 24> regionWeights;
+};
+
+struct LgAwbBgStatistics {
+	static constexpr unsigned int Regions = 64 * 48;
+	unsigned int bitDepth = 14;
+	std::array<LgAwbRgb, Regions> rgb{};
+
+	void update(const uint32_t *regions, unsigned int depth,
+		    unsigned int startupMode, unsigned int regionCount)
+	{
+		if (startupMode == 1 || !regionCount)
+			return;
+		bitDepth = depth ? depth : 14;
+		unsigned int scale = 1U << (bitDepth > 8 ? bitDepth - 8 : 0);
+		for (unsigned int i = 0; i < rgb.size(); i++) {
+			/* CAMSS supplies six normal words followed by six saturated-statistics words. */
+			const uint32_t *region = regions + i * 12;
+			uint32_t red = region[4] & 0xffff;
+			uint32_t blue = region[4] >> 16;
+			uint32_t green = (region[5] & 0xffff) + (region[5] >> 16);
+			if (!red || !blue || !green) {
+				rgb[i] = {};
+				continue;
+			}
+			rgb[i] = { static_cast<float>(region[0]) / (red * scale),
+				   static_cast<float>(region[2] + region[3]) / (green * scale),
+				   static_cast<float>(region[1]) / (blue * scale) };
+		}
+	}
+};
+
+class LgAwbStatistics
+{
+public:
+	explicit LgAwbStatistics(const LgAwbStatisticsConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	unsigned int luxRegion(int lux) const
+	{
+		return std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+		       config_.luxKnots.begin();
+	}
+
+	LgAwbRegionWeights weights(int lux) const
+	{
+		unsigned int region = luxRegion(lux);
+		unsigned int first = region ? region - 1 : 0;
+		unsigned int last = std::min<unsigned int>(region, config_.luxKnots.size() - 1);
+		float coefficient = first == last ? 0 :
+			static_cast<float>(lux - config_.luxKnots[first]) /
+			(config_.luxKnots[last] - config_.luxKnots[first]);
+		LgAwbRegionWeights result;
+		for (unsigned int group = 0; group < result.size(); group++)
+			for (unsigned int category = 0; category < result[group].size(); category++) {
+				float a = config_.regionWeights[first][group][category];
+				float b = config_.regionWeights[last][group][category];
+				/* The factory rounds multiplication before addition. */
+				volatile float product = coefficient * (b - a);
+				result[group][category] = a + product;
+			}
+		return result;
+	}
+
+	bool screen(const LgAwbXyY &xyY, const LgAwbRgb &rgb,
+		    LgAwbScreenCounters &counters) const
+	{
+		if (std::abs(xyY.x) <= 1e-6f && std::abs(xyY.y) <= 1e-6f && std::abs(xyY.luma) <= 1e-6f) {
+			counters[0]++;
+			return false;
+		}
+		if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value > config_.maximumRgb; })) {
+			counters[1]++;
+			counters[6]++;
+			return false;
+		}
+		if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value < config_.minimumRgb; })) {
+			counters[2]++;
+			counters[5]++;
+			return false;
+		}
+		if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value > config_.maximumRgb - config_.boundaryMargin; }))
+			counters[6]++;
+		else if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value < config_.minimumRgb + config_.boundaryMargin; }))
+			counters[5]++;
+		return true;
+	}
+
+private:
+	LgAwbStatisticsConfiguration config_;
+};
+
+inline unsigned int lgAwbNearestReference(const std::array<LgAwbPoint, 6> &reference, LgAwbPoint point)
+{
+	unsigned int nearest = 0;
+	float shortest = 0;
+#if defined(__aarch64__)
+	std::array<float, 6> distances{};
+	std::array<float, 6> x{}, y{};
+	for (unsigned int i = 0; i < x.size(); ++i) {
+		x[i] = reference[i].x;
+		y[i] = reference[i].y;
+	}
+	float32x4_t dx4 = vsubq_f32(vld1q_f32(x.data()), vdupq_n_f32(point.x));
+	float32x4_t dy4 = vsubq_f32(vld1q_f32(y.data()), vdupq_n_f32(point.y));
+	float32x4_t xx4 = vmulq_f32(dx4, dx4);
+	float32x4_t yy4 = vmulq_f32(dy4, dy4);
+	/* Keep each product rounded before the separate addition, as in the factory path. */
+	asm volatile("" : "+w"(xx4), "+w"(yy4) : : "memory");
+	float32x4_t distance4 = vsqrtq_f32(vaddq_f32(xx4, yy4));
+	vst1q_f32(distances.data(), distance4);
+	float32x2_t dx2 = vsub_f32(vld1_f32(x.data() + 4), vdup_n_f32(point.x));
+	float32x2_t dy2 = vsub_f32(vld1_f32(y.data() + 4), vdup_n_f32(point.y));
+	float32x2_t xx2 = vmul_f32(dx2, dx2);
+	float32x2_t yy2 = vmul_f32(dy2, dy2);
+	asm volatile("" : "+w"(xx2), "+w"(yy2) : : "memory");
+	float32x2_t distance2 = vsqrt_f32(vadd_f32(xx2, yy2));
+	vst1_f32(distances.data() + 4, distance2);
+	for (unsigned int i = 0; i < reference.size(); i++) {
+		if (!i || distances[i] < shortest) {
+			shortest = distances[i];
+			nearest = i;
+		}
+	}
+	return nearest;
+#else
+	for (unsigned int i = 0; i < reference.size(); i++) {
+		float dx = reference[i].x - point.x;
+		float dy = reference[i].y - point.y;
+		/* The SIMD factory path rounds both squares before the sum and square root. */
+		volatile float xx = dx * dx;
+		volatile float yy = dy * dy;
+		float distance = std::sqrt(xx + yy);
+		if (!i || distance < shortest) {
+			shortest = distance;
+			nearest = i;
+		}
+	}
+	return nearest;
+#endif
+}
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_target.h b/src/libcamera/pipeline/qcom/lg_awb_target.h
new file mode 100644
index 0000000..ecd5db6
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_target.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <cmath>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_history.h"
+
+namespace libcamera::qcom {
+
+enum class LgAwbGainSource : uint32_t {
+	None = 0, Gray = 1, History = 2, Previous = 3, Scd = 4, Dtb = 5, Ohe = 6, Foe = 9,
+};
+
+struct LgAwbGainTarget {
+	LgAwbRgb rgb{};
+	int32_t cct = 0;
+	LgAwbGainSource source = LgAwbGainSource::None;
+};
+
+inline void lgAwbBlendGain(LgAwbGainTarget &target, const LgAwbRgb &reference, int32_t cct, float weight)
+{
+	float retained = 1.0f - weight;
+	for (unsigned int channel = 0; channel < target.rgb.size(); channel++)
+		target.rgb[channel] = lgAwbProduct(weight, reference[channel]) +
+			lgAwbProduct(retained, target.rgb[channel]);
+	target.cct = static_cast<int32_t>(lgAwbProduct(weight, cct) + lgAwbProduct(retained, target.cct));
+}
+
+class LgAwbTarget
+{
+public:
+	void reset()
+	{
+		target_ = {};
+		previous_ = {};
+		previousCct_ = 0;
+	}
+
+	const LgAwbGainTarget &select(const LgAwbColour &colour, const LgAwbHistory &history,
+				     LgAwbXyY gray, int32_t cct, uint32_t &grayValid,
+				     bool skipped, unsigned int flashState = 0)
+	{
+		if (grayValid == 1) {
+			auto ratios = colour.toRgb(gray);
+			if (std::abs(ratios.red) <= 1e-6f || std::abs(ratios.blue) <= 1e-6f) {
+				grayValid = 0;
+			} else {
+				target_ = { { 1.0f / ratios.red, 1, 1.0f / ratios.blue }, cct, LgAwbGainSource::Gray };
+				previousCct_ = cct;
+			}
+		}
+		if (!grayValid) {
+			auto sample = history.lookup(LgAwbHistoryKind::Rolling, skipped);
+			if (sample) {
+				target_ = { sample->rgb, sample->cct, LgAwbGainSource::History };
+				previousCct_ = sample->cct;
+			} else {
+				target_ = { previous_, previousCct_, LgAwbGainSource::Previous };
+			}
+		}
+		if (flashState == 0 || flashState == 5)
+			previous_ = target_.rgb;
+		return target_;
+	}
+
+private:
+	LgAwbGainTarget target_;
+	LgAwbRgb previous_{};
+	int32_t previousCct_ = 0;
+};
+
+} /* namespace libcamera::qcom */
