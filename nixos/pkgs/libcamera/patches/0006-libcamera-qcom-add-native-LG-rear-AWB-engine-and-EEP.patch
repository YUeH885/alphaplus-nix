@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_math.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbConvergenceControls {
+	unsigned int path, mode, flashState;
+	bool fastRequest, startup, afRequest;
+};
+
+struct LgAwbGainFilterState {
+	LgAwbRgb rgb{};
+	int32_t cct = 0;
+	unsigned int previousPath = 0, stickyPath = 0;
+};
+
+struct LgAwbConvergenceResult {
+	LgAwbRgb rgb;
+	int32_t cct;
+	unsigned int state;
+	float factor;
+	LgAwbXyY colour;
+};
+
+class LgAwbConvergence
+{
+public:
+	explicit LgAwbConvergence(const std::array<float, 6> &factors, LgAwbGainFilterState history = {})
+		: factors_(factors), history_(history)
+	{
+	}
+
+	void reset() { history_ = {}; }
+
+	LgAwbConvergenceResult update(LgAwbRgb target, int32_t cct,
+				      const LgAwbConvergenceControls &controls, const LgAwbColour &colour)
+	{
+		if (controls.startup || history_.rgb[0] < 1e-6f || history_.rgb[1] < 1e-6f || history_.rgb[2] < 1e-6f) {
+			history_.rgb = target;
+			history_.cct = cct;
+			return { target, cct, 1, 1.0f, colour.fromRgb({ target[1] / target[0], target[1] / target[2] }) };
+		}
+		float alpha = factors_[0];
+		if (controls.path == history_.previousPath) {
+			if (history_.stickyPath == 4)
+				alpha = factors_[2];
+			else if (history_.stickyPath == 5)
+				alpha = factors_[3];
+		} else if (controls.path == 4 || history_.previousPath == 4) {
+			history_.stickyPath = 4;
+		} else if (controls.path == 5 || history_.previousPath == 5) {
+			history_.stickyPath = 5;
+		}
+		history_.previousPath = controls.path;
+		float red = std::abs(1.0f - (target[1] / target[0]) / (history_.rgb[1] / history_.rgb[0]));
+		float blue = std::abs(1.0f - (target[1] / target[2]) / (history_.rgb[1] / history_.rgb[2]));
+		unsigned int state = !controls.startup && red < 0.01f && blue < 0.01f ? 2 : 1;
+		if (state == 2)
+			history_.stickyPath = 0;
+		if (controls.mode != 1)
+			alpha = factors_[4];
+		else if (controls.fastRequest)
+			alpha = 0.99f;
+		else if (controls.startup)
+			alpha = factors_[1];
+		else if (controls.flashState >= 1 && controls.flashState <= 3)
+			alpha = factors_[5];
+		else if (controls.flashState == 4 || controls.afRequest)
+			alpha = factors_[1];
+		else if (!(alpha > 0))
+			alpha = 0.02f;
+		LgAwbConvergenceResult result;
+		result.state = state;
+		result.factor = alpha;
+		float inverse = 1.0f - alpha;
+		for (unsigned int channel = 0; channel < target.size(); channel++)
+			result.rgb[channel] = lgAwbProduct(target[channel], alpha) + lgAwbProduct(history_.rgb[channel], inverse);
+		result.cct = static_cast<int32_t>(lgAwbProduct(static_cast<float>(cct), alpha) +
+			lgAwbProduct(static_cast<float>(history_.cct), inverse));
+		history_.rgb = result.rgb;
+		history_.cct = result.cct;
+		result.colour = colour.fromRgb({ result.rgb[1] / result.rgb[0], result.rgb[1] / result.rgb[2] });
+		return result;
+	}
+
+	const LgAwbGainFilterState &history() const { return history_; }
+
+private:
+	std::array<float, 6> factors_;
+	LgAwbGainFilterState history_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_exceptions.h b/src/libcamera/pipeline/qcom/lg_awb_exceptions.h
new file mode 100644
index 0000000..95d3639
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_exceptions.h
@@ -0,0 +1,288 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+#include "lg_awb_gain.h"
+#include "lg_awb_gray.h"
+#include "lg_awb_math.h"
+#include "lg_awb_target.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbOheConfiguration {
+	bool enabled;
+	std::array<int16_t, 2> lux, grayCount;
+	LgAwbRatios reference;
+	int16_t maximumPercent;
+};
+
+struct LgAwbDtbGainRegion {
+	unsigned int reference;
+	int16_t minimumCount;
+	bool blockWhenGrayValid;
+	std::array<LgAwbRatios, 24> coefficients;
+};
+
+struct LgAwbDtbConfiguration {
+	std::array<unsigned int, 2> count;
+	std::array<std::array<LgAwbDtbGainRegion, 10>, 2> regions;
+	std::array<int16_t, 24> luxKnots;
+	unsigned int additionalCount;
+	std::array<LgAwbRatios, 11> additional;
+	std::array<uint32_t, 10> additionalLights;
+};
+
+class LgAwbOhe
+{
+public:
+	explicit LgAwbOhe(const LgAwbOheConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reset() { weight_ = 0; }
+	float weight() const { return weight_; }
+
+	void apply(LgAwbGainTarget &target, const LgAwbColour &colour, int lux, int grayCount)
+	{
+		if (!config_.enabled)
+			return;
+		weight_ = lgAwbProduct(lgAwbProduct(config_.maximumPercent, 0.01f),
+			lgAwbProduct(decreasing(lux, config_.lux), decreasing(grayCount, config_.grayCount)));
+		if (weight_ <= 0)
+			return;
+		auto ratios = colour.nominalRgb()[2];
+		LgAwbRgb reference{ config_.reference.red / ratios.red, 1, config_.reference.blue / ratios.blue };
+		lgAwbBlendGain(target, reference, 5000, weight_);
+		target.source = LgAwbGainSource::Ohe;
+	}
+
+private:
+	static float decreasing(int value, const std::array<int16_t, 2> &range)
+	{
+		if (value < range[0])
+			return 1;
+		if (value > range[1])
+			return 0;
+		return 1.0f - static_cast<float>(value - range[0]) / (range[1] - range[0]);
+	}
+
+	LgAwbOheConfiguration config_;
+	float weight_ = 0;
+};
+
+class LgAwbDtb
+{
+public:
+	explicit LgAwbDtb(const LgAwbDtbConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reset()
+	{
+		selection_ = 20;
+	}
+
+	unsigned int selection() const { return selection_; }
+
+	std::optional<LgAwbRatios> apply(LgAwbGainTarget &target, const LgAwbColour &colour,
+		   const LgAwbGrayReferences &references, const std::array<uint16_t, 20> &counts,
+		   int lux, float validFraction, float latestGrayX, bool grayValid, bool blocked)
+	{
+		select(0, counts, validFraction);
+		if (selection_ == 20)
+			select(1, counts, validFraction);
+		if (selection_ == 20)
+			return std::nullopt;
+		const auto &region = config_.regions[selection_ / 10][selection_ % 10];
+		float boundary = lgAwbProduct(references.points[3].x + references.points[4].x, 0.5f);
+		if ((region.blockWhenGrayValid && grayValid) || blocked ||
+		    (region.reference == 5 && lux <= 349 && std::abs(latestGrayX) > 1e-6f && latestGrayX <= boundary) ||
+		    region.reference >= 6 + config_.additionalCount) {
+			selection_ = 20;
+			return std::nullopt;
+		}
+		LgAwbRatios coefficients;
+		unsigned int index = std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+			config_.luxKnots.begin();
+		if (index == 0 || index == config_.luxKnots.size()) {
+			coefficients = region.coefficients[index ? index - 1 : 0];
+		} else {
+			float t = static_cast<float>(lux - config_.luxKnots[index - 1]) /
+				(config_.luxKnots[index] - config_.luxKnots[index - 1]);
+			auto first = region.coefficients[index - 1], last = region.coefficients[index];
+			coefficients = { first.red + lgAwbProduct(t, last.red - first.red),
+					  first.blue + lgAwbProduct(t, last.blue - first.blue) };
+		}
+		auto ratios = region.reference < 6 ? colour.nominalRgb()[region.reference] :
+			config_.additional[region.reference - 6];
+		target.rgb = { lgAwbProduct(1.0f / ratios.red, coefficients.red), 1,
+			       lgAwbProduct(1.0f / ratios.blue, coefficients.blue) };
+		unsigned int light = region.reference < 7 ? region.reference : config_.additionalLights[region.reference - 7];
+		constexpr std::array<int32_t, 6> temperatures{ 7500, 6500, 5000, 4000, 2856, 2300 };
+		target.cct = light < temperatures.size() ? temperatures[light] : 5000;
+		target.source = LgAwbGainSource::Dtb;
+		return coefficients;
+	}
+
+private:
+	void select(unsigned int group, const std::array<uint16_t, 20> &counts, float fraction)
+	{
+		for (unsigned int i = 0; i < config_.count[group]; i++) {
+			int threshold = static_cast<int>(lgAwbProduct(config_.regions[group][i].minimumCount, fraction) + 0.5f);
+			if (static_cast<int16_t>(counts[group * 10 + i]) > threshold) {
+				selection_ = group * 10 + i;
+				break;
+			}
+		}
+	}
+
+	LgAwbDtbConfiguration config_;
+	unsigned int selection_ = 20;
+};
+
+struct LgAwbFoeConfiguration {
+	bool enabled;
+	std::array<int16_t, 4> luxKnots, cctKnots;
+	LgAwbRatios coefficients;
+	int16_t maximumPercent;
+};
+
+struct LgAwbFoeControls {
+	int lux;
+	unsigned int led;
+	bool outdoor, flashOn;
+};
+
+class LgAwbFoe
+{
+public:
+	explicit LgAwbFoe(const LgAwbFoeConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reset() { weight_ = 0; }
+	float weight() const { return weight_; }
+
+	void apply(LgAwbGainTarget &target, const LgAwbColour &colour, const LgAwbFoeControls &controls)
+	{
+		weight_ = config_.enabled ? lgAwbProduct(lgAwbProduct(config_.maximumPercent, 0.01f),
+			lgAwbProduct(factor(controls.lux, config_.luxKnots), factor(target.cct, config_.cctKnots))) : 0;
+		if (!config_.enabled || !controls.outdoor || controls.flashOn || controls.led || !(weight_ > 1e-6f))
+			return;
+		auto ratios = colour.nominalRgb()[2];
+		LgAwbRgb reference{ 1.0f / ratios.red, 1, 1.0f / ratios.blue };
+		lgAwbBlendGain(target, reference, 5000, weight_);
+		target.rgb[0] = lgAwbProduct(target.rgb[0], config_.coefficients.red);
+		target.rgb[2] = lgAwbProduct(target.rgb[2], config_.coefficients.blue);
+		target.source = LgAwbGainSource::Foe;
+	}
+
+private:
+	static float factor(int value, const std::array<int16_t, 4> &knots)
+	{
+		if (value <= knots[0])
+			return 0;
+		if (value < knots[1])
+			return static_cast<float>(value - knots[0]) / (knots[1] - knots[0]);
+		/* FOE keeps the plateau endpoint when its last two knots coincide. */
+		if (value <= knots[2])
+			return 1;
+		if (value >= knots[3])
+			return 0;
+		return 1.0f - static_cast<float>(value - knots[2]) / (knots[3] - knots[2]);
+	}
+
+	LgAwbFoeConfiguration config_;
+	float weight_ = 0;
+};
+
+struct LgAwbScdConfiguration {
+	float minimumFlatMetric;
+	std::array<int16_t, 2> lux;
+	float historyWeight;
+	LgAwbRatios coefficients;
+};
+
+struct LgAwbScdControls {
+	int lux;
+	unsigned int flashState, faceCount, usecase;
+	int32_t grayCct;
+	uint32_t grayIlluminant;
+	bool aeSettled;
+	float flatMetric;
+};
+
+enum class LgAwbScdStatus : uint32_t {
+	InvalidHistoryGain = 0, LuxOrFlash = 1, FlatMetric = 2, Faces = 3,
+	HistoryCount = 4, HistoryIlluminant = 5, AeUnsettled = 6, Usecase = 7,
+	LowGrayCct = 8, GrayGeometry = 9, GrayCctRange = 11, Applied = 12,
+};
+
+struct LgAwbScdResult {
+	LgAwbScdStatus status;
+	std::optional<uint32_t> historyIlluminant;
+};
+
+class LgAwbScd
+{
+public:
+	explicit LgAwbScd(const LgAwbScdConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	LgAwbScdResult apply(LgAwbGainTarget &target, const LgAwbHistory &history,
+			     const LgAwbGrayReferences &references, LgAwbPoint gray,
+			     const LgAwbScdControls &controls) const
+	{
+		if (controls.grayCct >= 4301 && controls.grayCct <= 5499)
+			return { LgAwbScdStatus::GrayCctRange, std::nullopt };
+		if (controls.lux < config_.lux[0] || controls.lux > config_.lux[1] || controls.flashState)
+			return { LgAwbScdStatus::LuxOrFlash, std::nullopt };
+		if (controls.flatMetric < config_.minimumFlatMetric)
+			return { LgAwbScdStatus::FlatMetric, std::nullopt };
+		if (controls.faceCount)
+			return { LgAwbScdStatus::Faces, std::nullopt };
+		if (history.size(LgAwbHistoryKind::Initial) <= 2)
+			return { LgAwbScdStatus::HistoryCount, std::nullopt };
+		if (controls.flatMetric >= 1 && !controls.aeSettled)
+			return { LgAwbScdStatus::AeUnsettled, std::nullopt };
+		if (controls.usecase != 0 && controls.usecase != 2 && controls.usecase != 4)
+			return { LgAwbScdStatus::Usecase, std::nullopt };
+		if (controls.grayCct < 3000)
+			return { LgAwbScdStatus::LowGrayCct, std::nullopt };
+		auto sample = *history.lookup(LgAwbHistoryKind::Initial);
+		if (sample.illuminant != 2)
+			return { LgAwbScdStatus::HistoryIlluminant, sample.illuminant };
+		if (controls.grayIlluminant == 2) {
+			auto first = references.points[2], last = references.points[3], extra = references.points[6];
+			float dx = last.x - first.x;
+			float slope = (last.y - first.y) / dx;
+			float intercept = (lgAwbProduct(first.y, last.x) - lgAwbProduct(first.x, last.y)) / dx;
+			float floor = lgAwbProduct(extra.y - (lgAwbProduct(extra.x, slope) + intercept), 0.5f);
+			float distance = gray.y - (lgAwbProduct(gray.x, slope) + intercept);
+			if (!(gray.x > first.x) || !(gray.y > first.y) || distance <= floor || distance <= 0 || floor <= 0)
+				return { LgAwbScdStatus::GrayGeometry, sample.illuminant };
+		}
+		if (LgAwbGain::invalid(sample.rgb))
+			return { LgAwbScdStatus::InvalidHistoryGain, sample.illuminant };
+		lgAwbBlendGain(target, sample.rgb, sample.cct, config_.historyWeight);
+		target.rgb[0] = lgAwbProduct(target.rgb[0], config_.coefficients.red);
+		target.rgb[2] = lgAwbProduct(target.rgb[2], config_.coefficients.blue);
+		target.source = LgAwbGainSource::Scd;
+		return { LgAwbScdStatus::Applied, sample.illuminant };
+	}
+
+private:
+	LgAwbScdConfiguration config_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_face.h b/src/libcamera/pipeline/qcom/lg_awb_face.h
new file mode 100644
index 0000000..9bdf12c
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_face.h
@@ -0,0 +1,238 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_math.h"
+#include "lg_awb_target.h"
+#include "lg_awb_types.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbFaceInput {
+	uint32_t x;
+	uint32_t y;
+	uint32_t width;
+	uint32_t height;
+};
+
+struct LgAwbFaceBox {
+	uint32_t left = 1;
+	uint32_t top = 1;
+	uint32_t right = 0;
+	uint32_t bottom = 0;
+
+	bool valid() const { return left <= right && top <= bottom && right < 64 && bottom < 48; }
+};
+
+struct LgAwbFwbConfiguration {
+	int16_t mode;
+	int16_t minimumValidRegionCount;
+	LgAwbRatios skinReference;
+	LgAwbRatios gainCoefficients;
+	int16_t maximumWeightPercent;
+};
+
+struct LgAwbFaceResult {
+	bool valid = false;
+	uint32_t sampleCount = 0;
+	LgAwbRgb rgb{ 1.0f, 1.0f, 1.0f };
+};
+
+class LgAwbFaceTracker
+{
+public:
+	LgAwbFaceTracker() = default;
+
+	void reset()
+	{
+		previousFaceCount_ = 0;
+		faceStabilityCount_ = 0;
+		activeCount_ = 0;
+		boxes_.fill({});
+	}
+
+	uint32_t activeCount() const { return activeCount_; }
+	const std::array<LgAwbFaceBox, 3> &boxes() const { return boxes_; }
+	const LgAwbFaceBox *data() const { return boxes_.data(); }
+
+	void update(const LgAwbFaceInput *faces, size_t count, uint32_t imageWidth, uint32_t imageHeight)
+	{
+		uint32_t inputCount = static_cast<uint32_t>(count);
+		if (inputCount == previousFaceCount_) {
+			if (faceStabilityCount_ < 100)
+				faceStabilityCount_++;
+		} else {
+			faceStabilityCount_ = 0;
+		}
+
+		previousFaceCount_ = inputCount;
+
+		if (faceStabilityCount_ <= 5)
+			return;
+
+		activeCount_ = std::min(inputCount, 3u);
+		if (imageWidth == 0 || imageHeight == 0 || activeCount_ == 0 || !faces) {
+			if (activeCount_ == 0)
+				boxes_.fill({});
+			return;
+		}
+
+		float scaleX = 64.0f / static_cast<float>(imageWidth);
+		float scaleY = 48.0f / static_cast<float>(imageHeight);
+
+		for (uint32_t i = 0; i < activeCount_; i++) {
+			float fx0 = static_cast<float>(faces[i].x) * scaleX + 0.5f;
+			float fy0 = static_cast<float>(faces[i].y) * scaleY + 0.5f;
+			float fx1 = static_cast<float>(faces[i].x + faces[i].width) * scaleX - 0.5f;
+			float fy1 = static_cast<float>(faces[i].y + faces[i].height) * scaleY - 0.5f;
+
+			if (fx1 < fx0 || fy1 < fy0 || fx1 < 0.0f || fy1 < 0.0f) {
+				boxes_[i] = {};
+				continue;
+			}
+
+			uint32_t x0 = static_cast<uint32_t>(std::max(0.0f, fx0));
+			uint32_t y0 = static_cast<uint32_t>(std::max(0.0f, fy0));
+			uint32_t x1 = static_cast<uint32_t>(std::max(0.0f, fx1));
+			uint32_t y1 = static_cast<uint32_t>(std::max(0.0f, fy1));
+
+			if (x1 < x0 || y1 < y0) {
+				boxes_[i] = {};
+				continue;
+			}
+
+			uint32_t dx = (x1 - x0) + 1;
+			uint32_t dy = (y1 - y0) + 1;
+			uint32_t shrinkX = dx >> 2;
+			uint32_t shrinkY = dy >> 2;
+
+			uint32_t left = std::min(x0 + shrinkX, 63u);
+			uint32_t top = std::min(y0 + shrinkY, 47u);
+			uint32_t right = std::min(x1 >= shrinkX ? x1 - shrinkX : 0u, 63u);
+			uint32_t bottom = std::min(y1 >= shrinkY ? y1 - shrinkY : 0u, 47u);
+
+			if (left > right || top > bottom) {
+				boxes_[i] = {};
+				continue;
+			}
+
+			boxes_[i] = { left, top, right, bottom };
+		}
+	}
+
+private:
+	uint32_t previousFaceCount_ = 0;
+	uint32_t faceStabilityCount_ = 0;
+	uint32_t activeCount_ = 0;
+	std::array<LgAwbFaceBox, 3> boxes_{};
+};
+
+template<typename SampleArray>
+inline LgAwbFaceResult lgAwbCheckFaceStat(const std::array<LgAwbRgb, 3072> &rgb,
+					 SampleArray &samples,
+					 const LgAwbFaceBox *boxes,
+					 uint32_t faceCount,
+					 const LgAwbFwbConfiguration &config,
+					 LgAwbRatios d50Reference)
+{
+	LgAwbFaceResult result{};
+	if (faceCount == 0 || !boxes)
+		return result;
+
+	uint32_t validFaceSamples = 0;
+	float sumR = 0.0f;
+	float sumG = 0.0f;
+	float sumB = 0.0f;
+
+	for (uint32_t i = 0; i < faceCount; i++) {
+		const auto &box = boxes[i];
+		if (!box.valid())
+			continue;
+		for (uint32_t y = box.top; y <= box.bottom; y++) {
+			for (uint32_t x = box.left; x <= box.right; x++) {
+				uint32_t idx = y * 64 + x;
+				if (samples[idx].valid == 1) {
+					samples[idx].valid = 0;
+					validFaceSamples++;
+					sumR += rgb[idx][0];
+					sumG += rgb[idx][1];
+					sumB += rgb[idx][2];
+				}
+			}
+		}
+	}
+
+	result.sampleCount = validFaceSamples;
+
+	float observedRg = 0.0f;
+	float observedBg = 0.0f;
+
+	if (validFaceSamples > static_cast<uint32_t>(config.minimumValidRegionCount)) {
+		float countF = static_cast<float>(validFaceSamples);
+		float avgR = sumR / countF;
+		float avgG = sumG / countF;
+		float avgB = sumB / countF;
+		observedRg = avgR / avgG;
+		observedBg = avgB / avgG;
+		result.valid = true;
+	} else {
+		observedRg = config.skinReference.red;
+		observedBg = config.skinReference.blue;
+		result.valid = false;
+	}
+
+	float s1 = (config.skinReference.red / d50Reference.red) / observedRg;
+	float s2 = (config.skinReference.blue / d50Reference.blue) / observedBg;
+
+	result.rgb[0] = lgAwbProduct(config.gainCoefficients.red, s1);
+	result.rgb[1] = 1.0f;
+	result.rgb[2] = lgAwbProduct(config.gainCoefficients.blue, s2);
+
+	return result;
+}
+
+class LgAwbFwb
+{
+public:
+	explicit LgAwbFwb(const LgAwbFwbConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reset() { weight_ = 0.0f; }
+	float weight() const { return weight_; }
+
+	void apply(LgAwbGainTarget &target, const LgAwbFaceResult &faceResult, uint32_t frameCount)
+	{
+		weight_ = 0.0f;
+		if (config_.mode == 0)
+			return;
+
+		bool enabled = false;
+		if (config_.mode == 1) {
+			enabled = faceResult.valid;
+		} else if (config_.mode == 2) {
+			enabled = faceResult.valid && ((frameCount / 90) % 2 == 1);
+		}
+
+		if (!enabled)
+			return;
+
+		weight_ = lgAwbProduct(static_cast<float>(config_.maximumWeightPercent), 0.01f);
+		float oneMinusWeight = 1.0f - weight_;
+
+		target.rgb[0] = lgAwbProduct(target.rgb[0], oneMinusWeight) + lgAwbProduct(faceResult.rgb[0], weight_);
+		target.rgb[1] = lgAwbProduct(target.rgb[1], oneMinusWeight) + lgAwbProduct(faceResult.rgb[1], weight_);
+		target.rgb[2] = lgAwbProduct(target.rgb[2], oneMinusWeight) + lgAwbProduct(faceResult.rgb[2], weight_);
+	}
+
+private:
+	LgAwbFwbConfiguration config_;
+	float weight_ = 0.0f;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_flat_input.h b/src/libcamera/pipeline/qcom/lg_awb_flat_input.h
