diff --git a/tests/Engine/main.cpp b/tests/Engine/main.cpp
index 4d1ab5f..8a49b28 100644
--- a/tests/Engine/main.cpp
+++ b/tests/Engine/main.cpp
@@ -2245,6 +2245,105 @@ int main() {
         }
     }
 
+    // ---- incoming call: delayed-offer re-INVITE (empty INVITE -> 200 w/ offer -> ACK w/ answer)
+    //      and offer-carrying re-INVITE / UPDATE renegotiation
+    {
+        imsd::util::Rng rng(91);
+        CallMachine m(c, rng, "ims-call-reinvite", IncomingInvite{MtInvite()}, 50004);
+        m.OnInvite();
+        auto aa = m.OnAccept();
+        const Action* ok1 = Responded(aa, "SIP/2.0 200 OK");
+        auto oLine = [](std::string_view text) {
+            auto at = text.find("\r\no=");
+            if (at == std::string_view::npos) return std::string_view{};
+            at += 2;
+            return text.substr(at, text.find("\r\n", at) - at);
+        };
+        const std::string initialO(ok1 ? oLine(ok1->text) : "");
+        Check(!initialO.empty(), "accept 200 carries o= line");
+
+        std::string reinviteEmpty = std::format(
+            "INVITE sip:001010123456789@[2001:db8::db43]:45062 SIP/2.0\r\n"
+            "Via: SIP/2.0/UDP [2001:db8::105]:5100;branch=z9hG4bKre1\r\n"
+            "From: <sip:+31612345678@ims;user=phone>;tag=caller1\r\n"
+            "To: <sip:+31611111111@ims;user=phone>;tag=x\r\n"
+            "Contact: <sip:newgw@[2001:db8::99]:5060>\r\n"
+            "Supported: timer\r\nSession-Expires: 1800;refresher=uac\r\nMin-SE: 90\r\n"
+            "Call-ID: {}\r\nCSeq: 2 INVITE\r\nContent-Length: 0\r\n\r\n", m.CallId());
+        auto ar = m.OnRequest(reinviteEmpty);
+        const Action* ok2 = Responded(ar, "SIP/2.0 200 OK");
+        Check(ok2 != nullptr, "offerless re-INVITE gets 200 OK");
+        Check(ok2 && ok2->text.contains("m=audio 50004 RTP/AVP 97 99 98 100\r\n"), "offerless re-INVITE 200 includes SDP offer");
+        Check(ok2 && ok2->text.contains("Contact: <sip:001010123456789@"), "offerless re-INVITE 200 carries Contact");
+        Check(ok2 && ok2->text.contains("Session-Expires: 1800;refresher=uac\r\n") && ok2->text.contains("Require: timer\r\n"), "offerless re-INVITE 200 echoes timer headers");
+        Check(!Has(ar, Action::Type::StopMedia) && !Has(ar, Action::Type::StartMedia), "offerless re-INVITE waits for ACK answer before restarting media");
+
+        // Verify o= keeps session id and increments session version
+        const std::string offerO(ok2 ? oLine(ok2->text) : "");
+        Check(!offerO.empty() && offerO != initialO, "re-INVITE SDP increments o= version");
+
+        // ACK carries SDP answer retargeting media and renumbering DTMF
+        std::string ackSdp =
+            "v=0\r\no=- 88 88 IN IP6 2001:db8::444\r\ns=-\r\n"
+            "c=IN IP6 2001:db8::444\r\nt=0 0\r\n"
+            "m=audio 40002 RTP/AVP 99 101\r\n"
+            "a=rtpmap:99 AMR/8000/1\r\na=fmtp:99 octet-align=1\r\n"
+            "a=rtpmap:101 telephone-event/8000\r\n";
+        std::string ack2 = std::format(
+            "ACK sip:001010123456789@[2001:db8::db43]:45062 SIP/2.0\r\n"
+            "Via: SIP/2.0/UDP [2001:db8::105]:5100;branch=z9hG4bKa2\r\n"
+            "From: <sip:+31612345678@ims;user=phone>;tag=caller1\r\n"
+            "To: <sip:+31611111111@ims;user=phone>;tag=x\r\n"
+            "Call-ID: {}\r\nCSeq: 2 ACK\r\nContent-Type: application/sdp\r\nContent-Length: {}\r\n\r\n{}",
+            m.CallId(), ackSdp.size(), ackSdp);
+        auto aack = m.OnRequest(ack2);
+        Check(Responded(aack, "SIP/") == nullptr, "ACK with SDP answer produces no SIP response");
+        Check(Has(aack, Action::Type::StopMedia), "ACK with changed media stops old media leg");
+        const Action* newMed = Find(aack, Action::Type::StartMedia);
+        Check(newMed && newMed->media.remoteIp == "2001:db8::444" && newMed->media.remotePort == 40002 && newMed->media.codec == "AMR" && newMed->media.payloadType == 99 && newMed->media.octetAlign && newMed->media.dtmfPt == 101 && newMed->media.dtmfRxPt == 100, "ACK retargets media leg and keeps offered DTMF rx pt");
+
+        // Duplicate delayed-offer ACK (UDP retransmission) must not restart media or clobber dtmfRxPt
+        auto aackDup = m.OnRequest(ack2);
+        Check(aackDup.empty(), "duplicate delayed-offer ACK is a no-op");
+
+        // Subsequent offer-carrying re-INVITE with an unplayable offer is 488'd while keeping the call active and preserving remoteTarget
+        std::string badOffer =
+            "v=0\r\no=- 89 89 IN IP6 2001:db8::444\r\ns=-\r\nc=IN IP6 2001:db8::444\r\nt=0 0\r\n"
+            "m=audio 40004 RTP/AVP 18\r\na=rtpmap:18 G729/8000\r\n";
+        std::string reinviteBad = std::format(
+            "INVITE sip:001010123456789@[2001:db8::db43]:45062 SIP/2.0\r\n"
+            "Via: SIP/2.0/UDP [2001:db8::105]:5100;branch=z9hG4bKre3\r\n"
+            "From: <sip:+31612345678@ims;user=phone>;tag=caller1\r\n"
+            "To: <sip:+31611111111@ims;user=phone>;tag=x\r\n"
+            "Contact: <sip:badgw@[2001:db8::666]:5060>\r\n"
+            "Call-ID: {}\r\nCSeq: 3 INVITE\r\nContent-Type: application/sdp\r\nContent-Length: {}\r\n\r\n{}",
+            m.CallId(), badOffer.size(), badOffer);
+        auto abad = m.OnRequest(reinviteBad);
+        Check(Responded(abad, "SIP/2.0 488 Not Acceptable Here") != nullptr && !m.Terminated() && !Has(abad, Action::Type::StopMedia), "unacceptable re-INVITE offer returns 488 without dropping the call");
+        auto ah = m.OnHangup();
+        const Action* bye = Sent(ah, "BYE ");
+        Check(bye && bye->text.starts_with("BYE sip:newgw@[2001:db8::99]:5060 SIP/2.0\r\n"), "rejected 488 re-INVITE preserves previous remoteTarget");
+    }
+
+    // ---- outgoing call: bodyless session-refresh UPDATE receives a bodyless 200 OK (RFC 3311 §5.2)
+    {
+        imsd::util::Rng rng(92);
+        CallMachine m(c, rng, "ims-call-out-upd", "1233", 50004, false);
+        m.Start();
+        m.OnInviteResponse(R200(m.CallId()));
+        std::string upd = std::format(
+            "UPDATE sip:001010123456789@[2001:db8::db43]:45061 SIP/2.0\r\n"
+            "Via: SIP/2.0/TCP [2001:db8::105]:5100;branch=z9hG4bKuout\r\n"
+            "From: <sip:1233@ims>;tag=remote7\r\n"
+            "To: <sip:+31612345678@ims>;tag=it\r\n"
+            "Session-Expires: 1800;refresher=uac\r\n"
+            "Call-ID: {}\r\nCSeq: 2 UPDATE\r\nContent-Length: 0\r\n\r\n", m.CallId());
+        auto au = m.OnRequest(upd);
+        const Action* u200 = Responded(au, "SIP/2.0 200 OK");
+        Check(u200 != nullptr && u200->text.contains("Content-Length: 0\r\n") && !u200->text.contains("m=audio"),
+              "outgoing call answers bodyless UPDATE with a bodyless 200 OK");
+    }
+
     if (Failures == 0) std::println("Engine: all tests passed");
     return Failures != 0;   // not the count: an exit status keeps 8 bits, and this suite has more checks than that
 }
