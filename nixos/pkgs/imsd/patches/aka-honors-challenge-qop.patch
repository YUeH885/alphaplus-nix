diff --git a/interfaces/Imsd-Sip.cppm b/interfaces/Imsd-Sip.cppm
index 0f5a07a..04cb2d9 100644
--- a/interfaces/Imsd-Sip.cppm
+++ b/interfaces/Imsd-Sip.cppm
@@ -170,6 +170,34 @@ namespace imsd::sip {
 
 export namespace imsd::sip {
 
+    bool DigestChallengeHasQop(std::string_view challenge) {
+        challenge = Trim(challenge);
+        constexpr std::string_view Digest = "Digest";
+        auto schemeEnd = challenge.find_first_of(" \t");
+        if (schemeEnd != Digest.size() || !IEqualsPrefix(challenge, Digest)) return false;
+        for (std::size_t pos = schemeEnd; pos < challenge.size();) {
+            auto end = PieceEnd(challenge, pos, ',');
+            auto parameter = challenge.substr(pos, end - pos);
+            auto equals = parameter.find('=');
+            auto name = Trim(parameter.substr(0, equals));
+            if (equals != std::string_view::npos && name.size() == 3 && IEqualsPrefix(name, "qop")) {
+                auto val = Trim(parameter.substr(equals + 1));
+                if (val.size() >= 2 && val.front() == '"' && val.back() == '"')
+                    val = val.substr(1, val.size() - 2);
+                for (std::size_t qpos = 0; qpos < val.size();) {
+                    auto qend = val.find(',', qpos);
+                    if (qend == std::string_view::npos) qend = val.size();
+                    auto tok = Trim(val.substr(qpos, qend - qpos));
+                    if (tok.size() == 4 && IEqualsPrefix(tok, "auth"))
+                        return true;
+                    qpos = qend + 1;
+                }
+            }
+            pos = end + 1;
+        }
+        return false;
+    }
+
