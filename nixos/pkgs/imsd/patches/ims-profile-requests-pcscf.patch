+    inline std::vector<std::uint8_t> CreateImsProfile(std::uint16_t txn, std::string_view apn) {
+        constexpr std::uint8_t PdpTypeV6 = 2;
+        auto tlvs = Tlv8(0x01, ProfileType3gpp);
+        auto add = [&](const std::vector<std::uint8_t>& tlv) {
+            tlvs.insert(tlvs.end(), tlv.begin(), tlv.end());
+        };
+        const std::vector<std::uint8_t> apnBytes(apn.begin(), apn.end());
+        add(TlvBytes(0x10, apnBytes));
+        add(Tlv8(0x11, PdpTypeV6));
+        add(TlvBytes(0x14, apnBytes));
+        // The modem requests P-CSCF in PCO only when the IMS profile enables it.
+        add(Tlv8(0x1f, 1)); // P-CSCF address using PCO
+        add(Tlv8(0x22, 1)); // IM CN subsystem signalling
+        return Request(txn, MsgCreateProfile, tlvs);
+    }
