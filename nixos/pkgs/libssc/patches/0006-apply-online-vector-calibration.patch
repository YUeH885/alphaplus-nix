new file mode 100644
index 0000000..6b218cf
--- /dev/null
+++ b/data/ssc-calibration.proto
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+syntax = "proto2";
+
+/* Wire format of Qualcomm sns_cal_event (message 1022). */
+message SscCalibrationEvent {
+    repeated float bias = 1;
+    repeated float scale_factor = 2;
+    repeated float comp_matrix = 3;
+    required int32 status = 4;
+    optional fixed32 cal_id = 5;
+}
