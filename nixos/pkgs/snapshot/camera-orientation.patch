+#[derive(Debug)]
+struct CameraOutput {
+    decoded: gst::Pad,
+    output: gst::GhostPad,
+    tof_flip: gst::Element,
+}
+
+impl CameraOutput {
+    fn set_tof_flip(&self, enabled: bool) -> Result<(), glib::BoolError> {
+        let sink = self.tof_flip.static_pad("sink").unwrap();
+        if sink.is_linked() == enabled {
+            return Ok(());
+        }
+
+        if enabled {
+            self.output.set_target(None::<&gst::Pad>)?;
+            self.decoded
+                .link(&sink)
+                .map_err(|err| glib::bool_error!("Could not link ToF flip: {err}"))?;
+            self.output
+                .set_target(self.tof_flip.static_pad("src").as_ref())?;
+        } else {
+            self.decoded.unlink(&sink)?;
+            self.output.set_target(Some(&self.decoded))?;
+        }
+        Ok(())
+    }
+}
