diff --git a/src/vulkan/storage.glsl b/src/vulkan/storage.glsl
new file mode 100644
index 0000000..e8db198
--- /dev/null
+++ b/src/vulkan/storage.glsl
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: MIT
+layout(set=0, binding=1, std430) coherent buffer Output { uint output_data[]; };
+
+uint extract_halfword(uint word, int byte_offset) {
+    return (word >> ((byte_offset & 2) * 8)) & 0xffffu;
+}
+
+void store_halfword(int byte_offset, uint value) {
+    uint index = uint(byte_offset) >> 2u;
+    int shift = (byte_offset & 2) * 8;
+    // Adjacent invocations can own different halves of an unaligned word.
+    atomicAnd(output_data[index], ~(0xffffu << shift));
+    atomicOr(output_data[index], (value & 0xffffu) << shift);
+}
+
+void store_word(int byte_offset, uint value) {
+    if ((byte_offset & 3) == 0) {
+        output_data[uint(byte_offset) >> 2u] = value;
+    } else {
+        store_halfword(byte_offset, value);
+        store_halfword(byte_offset + 2, value >> 16u);
+    }
+}
+
+uint pack_pixel_pair(ivec2 value, bool wide) {
+    return wide ? (uint(value.x) << 6u) | (uint(value.y) << 22u)
+                : uint(value.x) | (uint(value.y) << 8u);
+}
+
+void store_pixel_pairs(int byte_offset, uint first, uint second, bool has_second, bool wide) {
+    if (wide) {
+        store_word(byte_offset, first);
+        if (has_second)
+            store_word(byte_offset + 4, second);
+    } else if (has_second) {
+        store_word(byte_offset, first | (second << 16u));
+    } else {
+        store_halfword(byte_offset, first);
+    }
+}
