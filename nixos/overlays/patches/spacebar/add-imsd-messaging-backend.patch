+    QCoro::Task<void> deleteMessage(QString id);
+
+Q_SIGNALS:
+    void messageReceived(const QString &id, const QVariantMap &properties);
+    void messageStateChanged(const QString &id, const QString &state, const QString &reason);
+    void ownNumberChanged(const QString &ownNumber);
+    void availabilityChanged();
+
+private Q_SLOTS:
+    void slotReceived(const QString &id, const QVariantMap &properties);
+    void slotStateChanged(const QString &id, const QString &state, const QString &reason);
+    void slotRegistrationChanged(bool registered);
+
+private:
+    explicit ImsdMessagingClient(QObject *parent = nullptr);
+
+    QCoro::Task<void> syncFromDaemon();
+    void updateOwnNumberFromPpi(const QString &ppi);
+    void emitUniqueIncoming(const QString &id, const QVariantMap &properties);
+
