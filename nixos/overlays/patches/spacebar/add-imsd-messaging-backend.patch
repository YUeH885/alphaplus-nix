+
+#include <global.h>
+
+namespace
+{
+const QString IMSD_SERVICE = SL("net.catcrafts.IMS1");
+const QString IMSD_PATH = SL("/net/catcrafts/IMS1");
+const QString IMSD_IFACE = SL("net.catcrafts.IMS1");
+const QString IMSD_MESSAGING_IFACE = SL("net.catcrafts.IMS1.Messaging");
+constexpr qsizetype MAX_SEEN_IDS = 512;
+
+QString extractNumberFromPpi(const QString &ppi)
+{
+    QString value = ppi.trimmed();
+    if (value.startsWith(u'<') && value.endsWith(u'>')) {
+        value = value.mid(1, value.size() - 2).trimmed();
+    }
+    if (value.startsWith(SL("tel:"), Qt::CaseInsensitive)) {
+        value = value.mid(4);
+    } else if (value.startsWith(SL("sip:"), Qt::CaseInsensitive)) {
+        value = value.mid(4).section(u'@', 0, 0);
+    } else if (value.startsWith(SL("sips:"), Qt::CaseInsensitive)) {
+        value = value.mid(5).section(u'@', 0, 0);
+    } else {
+        return QString();
+    }
+    return value.section(u';', 0, 0);
+}
+}
+
+QDBusArgument &operator<<(QDBusArgument &argument, const ImsdStoredMessage &message)
+{
+    argument.beginStructure();
+    argument << message.id << message.properties;
+    argument.endStructure();
+    return argument;
+}
+
+const QDBusArgument &operator>>(const QDBusArgument &argument, ImsdStoredMessage &message)
+{
+    argument.beginStructure();
+    argument >> message.id >> message.properties;
+    argument.endStructure();
+    return argument;
+}
+
+ImsdMessagingClient &ImsdMessagingClient::instance()
+{
+    static ImsdMessagingClient instance;
+    return instance;
+}
+
+ImsdMessagingClient::ImsdMessagingClient(QObject *parent)
+    : QObject(parent)
+{
+}
+
+void ImsdMessagingClient::init()
+{
+    if (m_initialized) {
+        return;
+    }
+    m_initialized = true;
+
+    qRegisterMetaType<ImsdStoredMessage>();
+    qRegisterMetaType<QList<ImsdStoredMessage>>();
+    qDBusRegisterMetaType<ImsdStoredMessage>();
+    qDBusRegisterMetaType<QList<ImsdStoredMessage>>();
+
+    auto bus = QDBusConnection::systemBus();
+    bus.connect(IMSD_SERVICE, IMSD_PATH, IMSD_MESSAGING_IFACE, SL("Received"), this, SLOT(slotReceived(QString, QVariantMap)));
+    bus.connect(IMSD_SERVICE, IMSD_PATH, IMSD_MESSAGING_IFACE, SL("StateChanged"), this, SLOT(slotStateChanged(QString, QString, QString)));
+    bus.connect(IMSD_SERVICE, IMSD_PATH, IMSD_IFACE, SL("RegistrationChanged"), this, SLOT(slotRegistrationChanged(bool)));
+
+    m_watcher = new QDBusServiceWatcher(IMSD_SERVICE, bus, QDBusServiceWatcher::WatchForOwnerChange, this);
+    connect(m_watcher, &QDBusServiceWatcher::serviceOwnerChanged, this, [this](const QString &, const QString &, const QString &newOwner) {
+        if (newOwner.isEmpty()) {
+            ++m_syncGeneration;
+            if (m_enabled) {
+                m_enabled = false;
+                Q_EMIT availabilityChanged();
+            }
+            return;
+        }
+        syncFromDaemon();
+    });
+
+    syncFromDaemon();
+}
+
+bool ImsdMessagingClient::isEnabled() const
+{
+    return m_enabled;
+}
+
+QString ImsdMessagingClient::ownNumber() const
+{
+    return m_ownNumber;
+}
+
+QCoro::Task<void> ImsdMessagingClient::syncFromDaemon()
+{
+    const quint64 generation = ++m_syncGeneration;
+    auto bus = QDBusConnection::systemBus();
+
+    QDBusMessage statusCall = QDBusMessage::createMethodCall(IMSD_SERVICE, IMSD_PATH, IMSD_MESSAGING_IFACE, SL("GetStatus"));
+    const QDBusReply<QVariantMap> statusReply = co_await QDBusPendingReply<QVariantMap>(bus.asyncCall(statusCall));
+    if (generation != m_syncGeneration) {
+        co_return;
+    }
+
+    auto setEnabled = [this](bool enabled) {
+        if (m_enabled != enabled) {
+            m_enabled = enabled;
+            Q_EMIT availabilityChanged();
+        }
+    };
+
+    if (!statusReply.isValid()) {
+        setEnabled(false);
+        co_return;
+    }
+
+    const QVariantMap status = statusReply.value();
+    const bool daemonEnabled = status.value(SL("enabled")).toBool();
+    updateOwnNumberFromPpi(status.value(SL("ppi")).toString());
+    if (!daemonEnabled) {
+        setEnabled(false);
+        co_return;
+    }
+
+    QDBusMessage subscribeCall = QDBusMessage::createMethodCall(IMSD_SERVICE, IMSD_PATH, IMSD_MESSAGING_IFACE, SL("Subscribe"));
+    const QDBusReply<void> subscribeReply = co_await QDBusPendingReply<>(bus.asyncCall(subscribeCall));
+    if (generation != m_syncGeneration) {
+        co_return;
+    }
+    if (!subscribeReply.isValid()) {
+        qWarning() << "imsd Messaging.Subscribe failed:" << subscribeReply.error().message();
+        setEnabled(false);
+        co_return;
+    }
+
+    setEnabled(true);
+
+    QDBusMessage listCall = QDBusMessage::createMethodCall(IMSD_SERVICE, IMSD_PATH, IMSD_MESSAGING_IFACE, SL("List"));
+    const QDBusReply<QList<ImsdStoredMessage>> listReply = co_await QDBusPendingReply<QList<ImsdStoredMessage>>(bus.asyncCall(listCall));
+    if (generation != m_syncGeneration) {
+        co_return;
+    }
+    if (!listReply.isValid()) {
+        qWarning() << "imsd Messaging.List failed:" << listReply.error().message();
+        co_return;
+    }
+
+    const QList<ImsdStoredMessage> stored = listReply.value();
+    for (const auto &item : stored) {
+        emitUniqueIncoming(item.id, item.properties);
+    }
+}
+
+void ImsdMessagingClient::updateOwnNumberFromPpi(const QString &ppi)
+{
+    const QString extracted = extractNumberFromPpi(ppi);
+    if (!extracted.isEmpty() && extracted != m_ownNumber) {
+        m_ownNumber = extracted;
+        Q_EMIT ownNumberChanged(m_ownNumber);
+    }
+}
+
+void ImsdMessagingClient::emitUniqueIncoming(const QString &id, const QVariantMap &properties)
+{
+    if (id.isEmpty() || m_seenIncomingIds.contains(id)) {
+        return;
+    }
+    m_seenIncomingIds.insert(id);
+    m_seenIncomingOrder.enqueue(id);
+    while (m_seenIncomingOrder.size() > MAX_SEEN_IDS) {
+        m_seenIncomingIds.remove(m_seenIncomingOrder.dequeue());
+    }
+    Q_EMIT messageReceived(id, properties);
+}
+
+void ImsdMessagingClient::slotReceived(const QString &id, const QVariantMap &properties)
+{
+    emitUniqueIncoming(id, properties);
+}
+
+void ImsdMessagingClient::slotStateChanged(const QString &id, const QString &state, const QString &reason)
+{
+    Q_EMIT messageStateChanged(id, state, reason);
+}
+
+void ImsdMessagingClient::slotRegistrationChanged(bool registered)
+{
+    (void)registered;
+    syncFromDaemon();
+}
+
+QCoro::Task<QDBusReply<QString>> ImsdMessagingClient::send(QString number, QString text, bool statusReport)
+{
+    QDBusMessage call = QDBusMessage::createMethodCall(IMSD_SERVICE, IMSD_PATH, IMSD_MESSAGING_IFACE, SL("Send"));
+    const QVariantMap options{{SL("status-report"), statusReport}};
+    call << number << text << options;
+    const QDBusReply<QString> reply = co_await QDBusPendingReply<QString>(QDBusConnection::systemBus().asyncCall(call));
+    co_return reply;
+}
+
+QCoro::Task<void> ImsdMessagingClient::deleteMessage(QString id)
+{
+    QDBusMessage call = QDBusMessage::createMethodCall(IMSD_SERVICE, IMSD_PATH, IMSD_MESSAGING_IFACE, SL("Delete"));
+    call << id;
+    const QDBusReply<void> reply = co_await QDBusPendingReply<>(QDBusConnection::systemBus().asyncCall(call));
+    if (!reply.isValid()) {
+        qWarning() << "imsd Messaging.Delete failed for" << id << ":" << reply.error().message();
+    }
+}
