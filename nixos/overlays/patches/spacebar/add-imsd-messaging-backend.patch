+QCoro::Task<void> ChannelLogger::handleImsUnavailable()
+{
+    m_earlyImsStates.clear();
+    m_earlyImsStateOrder.clear();
+    const QList<Message> pending = m_pendingImsMessages.values();
+    m_pendingImsMessages.clear();
+    for (const auto &message : pending) {
+        co_await m_database.updateMessageDeliveryState(message.id, MessageState::Failed);
+        updateMessage(message);
+    }
+}
+
+QCoro::Task<void> ChannelLogger::handleImsMessageStateChanged(QString id, QString state, QString reason)
+{
+    const auto it = m_pendingImsMessages.find(id);
+    if (it == m_pendingImsMessages.end()) {
+        if (state == SL("sent") || state == SL("failed")) {
+            if (!m_earlyImsStates.contains(id)) {
+                m_earlyImsStateOrder.enqueue(id);
+                while (m_earlyImsStateOrder.size() > 128) {
+                    m_earlyImsStates.remove(m_earlyImsStateOrder.dequeue());
+                }
+            }
+            m_earlyImsStates.insert(id, {state, reason});
+        }
+        co_return;
+    }
+
+    Message message = it.value();
+    if (state == SL("sent")) {
+        m_pendingImsMessages.erase(it);
+        co_await m_database.updateMessageDeliveryState(message.id, MessageState::Sent);
+        updateMessage(message);
+    } else if (state == SL("failed")) {
+        qWarning() << "imsd SMS" << id << "failed:" << reason;
+        m_pendingImsMessages.erase(it);
+        co_await m_database.updateMessageDeliveryState(message.id, MessageState::Failed);
+        updateMessage(message);
+    }
+}
