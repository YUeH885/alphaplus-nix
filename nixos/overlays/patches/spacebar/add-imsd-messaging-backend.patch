+/**
+ * D-Bus client for net.catcrafts.IMS1.Messaging (SMS over IP in imsd).
+ */
+class ImsdMessagingClient : public QObject
+{
+    Q_OBJECT
+
+public:
+    static ImsdMessagingClient &instance();
+
+    void init();
+
