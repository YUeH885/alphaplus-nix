+QString Configuration::hotspotBand() const
+{
+    KSharedConfigPtr config = KSharedConfig::openConfig(QStringLiteral("plasma-nm"));
+    KConfigGroup grp(config, QStringLiteral("General"));
+
+    if (grp.isValid()) {
+        const QString band = grp.readEntry(QStringLiteral("HotspotBand"), QStringLiteral("a"));
+        if (band == QLatin1String("bg")) {
+            return band;
+        }
+    }
+
+    return QStringLiteral("a");
+}
+
+void Configuration::setHotspotBand(const QString &band)
+{
+    KSharedConfigPtr config = KSharedConfig::openConfig(QStringLiteral("plasma-nm"));
+    KConfigGroup grp(config, QStringLiteral("General"));
+
+    if (grp.isValid()) {
+        const QString normalized = band == QLatin1String("bg") ? QStringLiteral("bg") : QStringLiteral("a");
+        grp.writeEntry(QStringLiteral("HotspotBand"), normalized, KConfigBase::Notify);
+        grp.sync();
+    }
+}
+
 QString Configuration::hotspotConnectionPath() const
 {
     KSharedConfigPtr config = KSharedConfig::openConfig(QStringLiteral("plasma-nm"));
